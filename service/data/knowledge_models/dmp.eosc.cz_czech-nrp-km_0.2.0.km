":false},"metricUuids":{"changed":false},"phaseUuids":{"changed":false},"resourceCollectionUuids":{"changed":false},"tagUuids":{"changed":false}},"createdAt":"2025-04-09T12:57:23Z","entityUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"a0391fc8-eacb-4761-a70d-c723801338be"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:57:24Z","entityUuid":"cca825e4-5c84-4290-865a-88eeba3867ba","parentUuid":"7fccc342-deaa-4105-bfdf-43b872291c86","uuid":"6dd83aa7-2f55-4807-9774-d300ca06c5f5"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"listQuestionUuid":{"changed":false},"questionType":"ItemSelectQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":null},"title":{"changed":true,"value":"Please select the dataset that this distribution represents"}},"createdAt":"2025-04-09T12:57:25Z","entityUuid":"cca825e4-5c84-4290-865a-88eeba3867ba","parentUuid":"7fccc342-deaa-4105-bfdf-43b872291c86","uuid":"398388b3-c654-4126-b7ca-3c45659e6d9c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:57:26Z","entityUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b","parentUuid":"7fccc342-deaa-4105-bfdf-43b872291c86","uuid":"42a138d8-4884-472c-abad-7a24d95ebffa"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"A distribution is a specific representation or version of a dataset that is made available for access or download. A single dataset may have multiple distributions that vary in format, structure, language, media type, level of detail, or other characteristics. This concept follows the widely used W3C DCAT metadata standard, which distinguishes between the abstract idea of a dataset and its concrete forms of availability. Distributions enable the attachment of specific metadata—such as file size or license—to each version. Importantly, a distribution may be defined even if it is not ultimately published. *(Definition provided based on [dcat:Distribution](https://www.w3.org/TR/vocab-dcat-3/#Class:Distribution))*"},"title":{"changed":true,"value":"Distribution"}},"createdAt":"2025-04-09T12:57:27Z","entityUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b","parentUuid":"7fccc342-deaa-4105-bfdf-43b872291c86","uuid":"9e2d590f-670b-4454-a6a5-ce60ddb39b48"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T12:57:28Z","entityUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b","parentUuid":"7fccc342-deaa-4105-bfdf-43b872291c86","uuid":"9f50f2eb-6b01-42b6-bbbb-b8e31ba301c4"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b"},"createdAt":"2025-04-09T12:57:29Z","entityUuid":"cca825e4-5c84-4290-865a-88eeba3867ba","parentUuid":"7fccc342-deaa-4105-bfdf-43b872291c86","uuid":"6f3620b0-f316-4797-97c2-a2972d7655bd"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"listQuestionUuid":{"changed":true,"value":"a7a67bd9-7912-4321-880e-7cf0355ce301"},"questionType":"ItemSelectQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T12:57:30Z","entityUuid":"cca825e4-5c84-4290-865a-88eeba3867ba","parentUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b","uuid":"ee6a2e05-3813-44c2-bd0a-a0f75956f06a"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b"},"createdAt":"2025-04-09T12:57:31Z","entityUuid":"3bb3bf13-3adc-4fe2-93d5-94de606543d3","parentUuid":"fbb17122-3bc9-4780-9f8a-bbb0986e4b17","uuid":"171f84d7-c38e-46fe-be27-b1c4989a17f2"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b"},"createdAt":"2025-04-09T12:57:32Z","entityUuid":"62378027-96f4-411b-a1d9-efd51b68c3e9","parentUuid":"fbb17122-3bc9-4780-9f8a-bbb0986e4b17","uuid":"0d77d271-ce0e-45b1-9df1-e4a8323a6f7f"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b"},"createdAt":"2025-04-09T12:57:33Z","entityUuid":"67656fcf-48db-4d7f-8a83-5874f058e5bf","parentUuid":"fbb17122-3bc9-4780-9f8a-bbb0986e4b17","uuid":"3befdf07-77e2-45f3-8e3f-b4ea346c6a43"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b"},"createdAt":"2025-04-09T12:57:34Z","entityUuid":"b560dc2c-817a-4343-aea3-4a13f0b5b1d3","parentUuid":"fbb17122-3bc9-4780-9f8a-bbb0986e4b17","uuid":"bbb48041-a867-4719-9435-c85ae3a3e775"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"It is not always clear to everyone in the project (and outside) what can and can not be done with a data. It is helpful to associate each data with a license as early as possible in the project. A data license should ideally be as free as possible: any restriction like 'only for non-commercial use' or 'attribution required' may reduce the reusability and thereby the number of citations. If possible, use a computer-readable and computer actionable license."},"title":{"changed":true,"value":"Will a license be assigned to the distribution?"}},"createdAt":"2025-04-09T12:57:35Z","entityUuid":"c31b4e0f-a555-4012-bc8d-666fd147de57","parentUuid":"d079929c-4f64-4cb6-818b-39ccdefcbc07","uuid":"e37887ce-89d5-4374-91aa-54d504faed83"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Have you already chosen a license?"}},"createdAt":"2025-04-09T12:57:36Z","entityUuid":"fe262688-133b-44d3-99a4-3007d25de4bd","parentUuid":"8ba89e3a-a4d5-470a-bd64-107c5c4b0b13","uuid":"018949ff-6dc2-4d01-a01d-d4f35f6bbdc6"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you use an open license?"}},"createdAt":"2025-04-09T12:57:37Z","entityUuid":"b265ee46-097f-4a0c-b9bc-228d44286e1e","parentUuid":"7b673a0a-a4af-4171-9512-11c992de33a5","uuid":"1187b3ac-69e1-4722-858e-62963f161605"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Under what license will the data be made available?"},"variables":{"changed":false}},"createdAt":"2025-04-09T12:57:38Z","en