7b8-bc58-4897-b93b-4a4744f9c249","parentUuid":"b5ef3e16-9b92-40ce-810e-3fe8185184f0","uuid":"6cbf2f04-7abe-4609-ac76-c3b8c849f0f3"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-01T13:36:17Z","entityUuid":"6e2ed7b8-bc58-4897-b93b-4a4744f9c249","parentUuid":"b5ef3e16-9b92-40ce-810e-3fe8185184f0","uuid":"c0649c78-7860-4347-9d0c-8c6322316d16"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:36:18Z","entityUuid":"a00cc2bb-0e12-4afa-bc70-5779539c6f12","parentUuid":"6e2ed7b8-bc58-4897-b93b-4a4744f9c249","uuid":"0945f26d-9840-49e5-a45d-dad14449fe18"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Processor"}},"createdAt":"2023-08-01T13:36:19Z","entityUuid":"a00cc2bb-0e12-4afa-bc70-5779539c6f12","parentUuid":"6e2ed7b8-bc58-4897-b93b-4a4744f9c249","uuid":"5d25c125-30a3-48a7-9c8f-c21ece489de9"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2023-08-01T13:36:20Z","entityUuid":"a00cc2bb-0e12-4afa-bc70-5779539c6f12","parentUuid":"6e2ed7b8-bc58-4897-b93b-4a4744f9c249","uuid":"0569d3a8-95e3-4961-84fb-32635ae44d98"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:36:21Z","entityUuid":"a112cc94-3396-47e5-b0d3-6af3d09f4770","parentUuid":"6e2ed7b8-bc58-4897-b93b-4a4744f9c249","uuid":"10423af2-6657-45e2-95cc-3180d9b3fb44"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Agreement"}},"createdAt":"2023-08-01T13:36:22Z","entityUuid":"a112cc94-3396-47e5-b0d3-6af3d09f4770","parentUuid":"6e2ed7b8-bc58-4897-b93b-4a4744f9c249","uuid":"5e2eeaba-5541-4476-a9db-b828b3b2495a"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Add reference to established agreement."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2023-08-01T13:36:23Z","entityUuid":"a112cc94-3396-47e5-b0d3-6af3d09f4770","parentUuid":"6e2ed7b8-bc58-4897-b93b-4a4744f9c249","uuid":"43194b96-edcc-4397-b134-29ffa720c127"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:36:24Z","entityUuid":"8b169987-5891-4eb7-b45e-f365825b783b","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"516f2730-bebc-4760-a741-a2eb621da253"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Where a type of processing is likely to result in a high risk to the rights and freedoms of natural persons, the controller shall, prior to the processing, carry out an assessment of the impact of the envisaged processing operations on the protection of personal data, a so called Data Protection Impact Assessment (DPIA) - [Article 35](https://gdpr-info.eu/art-35-gdpr/). Note: Most types of research projects on health or genetic data require a DPIA, especially large-scale processing of sensitive data. "},"title":{"changed":true,"value":"Do you need a Data Protection Impact Assessment?"}},"createdAt":"2023-08-01T13:36:25Z","entityUuid":"8b169987-5891-4eb7-b45e-f365825b783b","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"794c80bd-c1a8-44ef-b43b-08760eaefe09"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2023-08-01T13:36:26Z","entityUuid":"8b169987-5891-4eb7-b45e-f365825b783b","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"880c9cf3-7163-413e-9e50-032c93fa7575"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-01T13:36:27Z","entityUuid":"8b169987-5891-4eb7-b45e-f365825b783b","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"01b0b17e-a0c1-498f-8212-f3fde7fdb896"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2023-08-01T13:36:28Z","entityUuid":"8b169987-5891-4eb7-b45e-f365825b783b","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"b1e63446-4b39-4701-80da-6de39c9c8226"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-01T13:36:29Z","entityUuid":"8b169987-5891-4eb7-b45e-f365825b783b","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"40e1d793-305f-427f-8df4-334e398a2448"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:36:30Z","entityUuid":"d363075f-92b5-4161-bdbc-6f6086ceb321","parentUuid":"8b169987-5891-4eb7-b45e-f365825b783b","uuid":"475c9dbc-02f9-41d5-b15b-b0faedacfd4e"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:36:31Z","entityUuid":"d363075f-92b5-4161-bdbc-6f6086ceb321","parentUuid":"8b169987-5891-4eb7-b45e-f365825b783b","uuid":"c7b09db3-44a6-411f-8037-68a3a533ec71"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:36:32Z","entityUuid":"5723d272-e1e4-4af4-b094-ed001ce00f62","parentUuid":"8b169987-5891-4eb7-b45e-f365825b783b","uuid":"eb69f6a5-9065-4b55-bd62-ddefcc768170"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:36:33Z","entityUuid":"5723d272-e1e4-4af4-b094-ed001ce00f62","parentUuid":"8b169987-5891-4eb7-b45e-f365825b783b","uuid":"ef30b4df-be59-4c4a-90bb-e655f384fcf2"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:36:34Z","entityUuid":"80db4828-2de1-484d-a6d0-cbbae964b48f","parentUuid":"5723d272-e1e4-4af4-b094-ed001ce00f62","uuid":"3b0468c2-ab18-4a61-9c40-67bf5394d08b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The French Data Protection Authority (DPA) has made a [PIA tool](https://www.cnil.fr/en/open-source-pia-software-helps-carry-out-data-protection-impact-assesment) (endorsed by several other DPAs) available that can help in performing these impact assessments. Please also consult your Data Protection Officer of your organization."},"title":{"changed":true,"value":"Have Data Protection Impact Assessments (DPIA) been performed for the personal data?"}},"createdAt":"2023-08-01T13:36:35Z","entityUuid":"80db4828-2de1-484d-a6d0-cbbae964b48f","parentUuid":"5723d272-e1e4-4af4-b094-ed001ce00f62","uuid":"77e54b1e-81a1-4ba5-919c-c70977f8828e"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T13:36:36Z","entityUuid":"8bb9089c-1b51-47f9-a016-572ae5fabaa2","parentUuid":"80db4828-2de1-484d-a6d0-cbbae964b48f","uuid":"9e5052c6-5965-4160-984c-53a6b0a93d3f"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"EC Guidelines on DPIAs"},"referenceType":"URLReference","url":{"changed":true,"value":"https://ec.europa.eu/newsroom/article29/items/611236/en"}},"createdAt":"2023-08-01T13:36:37Z","entityUuid":"8bb9089c-1b51-47f9-a016-572ae5fabaa2","parentUuid":"80db4828-2de1-484d-a6d0-cbbae964b48f","uuid":"c587588e-bf8f-4ae8-a1ca-3559603b30e4"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T13:36:38Z","entityUuid":"ff26ec19-a151-42e1-bee6-cfc621cf16c0","parentUuid":"80db4828-2de1-484d-a6d0-cbbae964b48f","uuid":"a5b5649d-3a34-43f3-9dcc-58e1aefc225e"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"FAIRCookbook on Data Protection Impact Assessment"},"referenceType":"URLReference","url":{"changed":true,"value":"https://w3id.org/faircookbook/FCB074"}},"createdAt":"2023-08-01T13:36:39Z","entityUuid":"ff26ec19-a151-42e1-bee6-cfc621cf16c0","parentUuid":"80db4828-2de1-484d-a6d0-cbbae964b48f","uuid":"05be2505-344e-450c-a5dd-5c66bc7392e2"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:36:40Z","entityUuid":"9a5fe8bd-acc3-496f-9c42-b6d43871a516","parentUuid":"80db4828-2de1-484d-a6d0-cbbae964b48f","uuid":"2cb1788d-8b87-4671-a7a3-cc6cf6d17ca4"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:36:41Z","entityUuid":"9a5fe8bd-acc3-496f-9c42-b6d43871a516","parentUuid":"80db4828-2de1-484d-a6d0-cbbae964b48f","uuid":"