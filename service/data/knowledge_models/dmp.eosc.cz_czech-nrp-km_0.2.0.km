lse},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"There is a closely related more generic and open format that I can modify"},"metricMeasures":{"changed":false}},"createdAt":"2025-12-03T09:43:11Z","entityUuid":"92431745-7141-45ec-9570-cb48b93f79e1","parentUuid":"822cd13e-43ab-4209-afa4-1935bcca3888","uuid":"8f2c2e15-1ba9-4163-b200-9f1abd3bd20a"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"There are already existing datasets that can be linked to this strategy"},"metricMeasures":{"changed":false}},"createdAt":"2025-12-03T09:43:12Z","entityUuid":"31181769-7c13-439d-af2d-c9655aca6b73","parentUuid":"7d6da307-8785-4ac3-8469-892db5d12b23","uuid":"fdbb7f49-aca9-47a6-b9b2-aae112ea893d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"ca36a6ee-245b-441f-91bf-3aa8b15126f7"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-12-03T09:43:13Z","entityUuid":"03d5eea8-c0f5-45b6-87b1-8db1c62ff100","parentUuid":"7a12e6c6-09f8-4ee2-a6fc-99c4946c3de9","uuid":"b0e4e731-faa4-49ce-8af1-1b534d1fcf4e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you keep the track of the \"provenance\" of the produced data?"}},"createdAt":"2025-12-03T09:43:14Z","entityUuid":"36b561b7-7864-4bc9-87cb-f1e06e7e26b7","parentUuid":"7a12e6c6-09f8-4ee2-a6fc-99c4946c3de9","uuid":"671bcebe-492c-4dc9-8c21-546da5b1865a"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Describe how others can access this output. If possible, provide a URL or PID."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-12-03T09:43:15Z","entityUuid":"ab3fd730-d91c-4964-b58c-f120f3ef5f3b","parentUuid":"4c23a425-1df6-4f42-804c-deb36f53fd1c","uuid":"b28c4dc4-db38-4769-bbf8-f42a07e599c6"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":null},"title":{"changed":false}},"createdAt":"2025-12-03T09:43:16Z","entityUuid":"8f170550-29a7-46c5-9c05-619611450f64","parentUuid":"1c2b424b-0ffe-49eb-820f-d10e9d9c9821","uuid":"a2c6d4dd-37bd-4b74-b669-97f41d151288"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"There should be a direct relationship between data and its metadata. Ideally, these are two separate resources linked by persistent identifiers. Alternatively, metadata can be embedded directly in the data files; however, note that this approach is not fully FAIR, as metadata should remain accessible even if the data becomes deprecated.\n\nFor example, when you create a record in the Zenodo repository, you are required to provide certain metadata. This metadata receives the same persistent identifier as the data and does not become obsolete even if the data itself is later deprecated. However, associated files—such as README files—that are part of the record may become obsolete or unavailable if the record is deleted."},"title":{"changed":false}},"createdAt":"2025-12-03T09:43:17Z","entityUuid":"7098b716-370c-4a46-a281-2b5f6eea8249","parentUuid":"7a12e6c6-09f8-4ee2-a6fc-99c4946c3de9","uuid":"89ec6861-6091-47a3-bb8b-74006906bf13"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please describe here the documentation associated with the data. This may include, for example, README files, methodological descriptions, protocols, or any other documentation that helps users understand the data and its context.\n\nPlease note that while repository metadata is typically assigned a persistent identifier and remains available even if the data later become obsolete, other documentation files (e.g. README files) may become unavailable if the record is deleted."},"title":{"changed":false}},"createdAt":"2025-12-03T09:43:18Z","entityUuid":"8ed92246-9844-4594-8f35-9ee03e87b839","parentUuid":"c746ea6f-8a50-4455-a27c-4f6b77aacd99","uuid":"f47388f2-ef73-4e4a-9b75-922faeffbaec"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-12-03T09:43:19Z","entityUuid":"bc1ee91d-068e-4a28-a8b1-5ff5ae9fb412","parentUuid":"04863756-0dc4-4e5e-916c-3941f86921e2","uuid":"22890990-6942-47a8-8081-a0a46451e7e3"},{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[{"key":"json.value","value":"data_steward"}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Insitutional Data Steward"},"metricMeasures":{"changed":false}},"createdAt":"2025-12-03T09:43:20Z","entityUuid":"bc1ee91d-068e-4a28-a8b1-5ff5ae9fb412","parentUuid":"04863756-0dc4-4e5e-916c-3941f86921e2","uuid":"c9745e61-b2a2-4e1f-a6b4-f324a8058ed4"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-12-03T09:43:21Z","entityUuid":"c41b5ea4-f78a-4e0a-89d3-70650c742a6a","parentUuid":"04863756-0dc4-4e5e-916c-3941f86921e2","uuid":"e2e028d3-b51d-433d-a629-c96597245094"},{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[{"key":"json.value","value":"other"}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Other"},"metricMeasures":{"changed":false}},"createdAt":"2025-12-03T09:43:22Z","entityUuid":"c41b5ea4-f78a-4e0a-89d3-70650c742a6a","parentUuid":"04863756-0dc4-4e5e-916c-3941f86921e2","uuid":"d4b17aa2-f7e4-4421-be95-574b2198e607"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-12-03T09:43:23Z","entityUuid":"dd845aa4-463a-46e8-9888-63b5449bfa0a","parentUuid":"c41b5ea4-f78a-4e0a-89d3-70650c742a6a","uuid":"0cc06d64-4106-4676-b0ea-fa5e939f5547"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Please specify who"}},"createdAt":"2025-12-03T09:43:24Z","entityUuid":"dd845aa4-463a-46e8-9888-63b5449bfa0a","parentUuid":"c41b5ea4-f78a-4e0a-89d3-70650c742a6a","uuid":"412bccfa-446d-49a6-9e9a-9c7bdc86504f"},{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"other"}]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questio