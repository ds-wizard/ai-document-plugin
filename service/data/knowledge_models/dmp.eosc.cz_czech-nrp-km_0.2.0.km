ons":{"changed":true,"value":[{"key":"json.key","value":"isLargeVolume"}]},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T12:51:35Z","entityUuid":"6eecbc04-ad0c-4e4f-9dbd-a56326520508","parentUuid":"afbfa2aa-314f-4277-94b0-68cb1b94a476","uuid":"093ffea0-3679-4a6a-bb1b-90376933994a"},{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[{"key":"json.key","value":"no"}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:51:36Z","entityUuid":"ad4e28f7-c8c4-4c6e-85ac-0ed6b836492f","parentUuid":"6eecbc04-ad0c-4e4f-9dbd-a56326520508","uuid":"d8e29682-c951-4dd9-ae2a-8de20c8eadc5"},{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[{"key":"json.key","value":"yes"}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:51:37Z","entityUuid":"50484834-cfc8-4b60-bdb8-18ff60f61acc","parentUuid":"6eecbc04-ad0c-4e4f-9dbd-a56326520508","uuid":"466e23e5-248c-4147-9be3-71d72d69527e"},{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"estimatedVolume"}]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T12:51:38Z","entityUuid":"10e8fce3-1b05-402e-a8bc-77b64a7014d6","parentUuid":"50484834-cfc8-4b60-bdb8-18ff60f61acc","uuid":"c668dcd8-6e69-4058-95f6-2a5300462776"},{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"dataHavingLargeVolume"}]},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T12:51:39Z","entityUuid":"9ea776e9-717d-4fe1-934f-48b2325d3523","parentUuid":"50484834-cfc8-4b60-bdb8-18ff60f61acc","uuid":"a79bf4fe-45e9-4a4f-ab16-c03c910ea337"},{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[{"key":"json.value","value":"raw or input"}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:51:40Z","entityUuid":"116820ae-4ba7-443f-9287-f5149194cda1","parentUuid":"9ea776e9-717d-4fe1-934f-48b2325d3523","uuid":"d6de734e-1492-4798-9d70-75fe22de0fed"},{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[{"key":"json.value","value":"intermediate"}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:51:41Z","entityUuid":"136831a3-21cf-4bc2-b700-5e9dd93b979f","parentUuid":"9ea776e9-717d-4fe1-934f-48b2325d3523","uuid":"813bf7e5-2d02-4b8a-83e7-bac7ef9d6932"},{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[{"key":"json.key","value":"output"}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:51:42Z","entityUuid":"1db97e3e-4eab-4dda-a378-a336815bc4c7","parentUuid":"9ea776e9-717d-4fe1-934f-48b2325d3523","uuid":"fbd49a42-4914-46d7-a989-bc4c124b5d33"},{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[{"key":"json.key","value":"no"}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:51:43Z","entityUuid":"62379758-c615-4dcd-ba12-0bb00095488b","parentUuid":"9ea776e9-717d-4fe1-934f-48b2325d3523","uuid":"a24817af-6239-4bc4-9a16-77b1bc907e33"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"As a project nears completion, all data should be finalized and appropriately organized. At this stage, questions aimed at documenting the final state of the project are considered both relevant and valuable."},"eventType":"EditPhaseEvent","title":{"changed":false}},"createdAt":"2025-04-09T12:51:44Z","entityUuid":"65ba276b-3e3b-4c45-9b69-2dab2bd66452","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"549fd1a4-2ef1-49e7-9124-635df33bd983"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Policies regarding open science and data management are, and should be, provided to grant holders by funding agencies. For example, if you are working on a project funded by the Czech Science Foundation (Grantová agentura České republiky, GAČR), you should have received—or be able to access—a publicly available policy outlining requirements for data management and open science. In addition, your institution may have its own established policy on data sharing. You are expected to be familiar with and follow this policy when working on any project affiliated with the institution, unless explicitly stated otherwise."},"title":{"changed":false}},"createdAt":"2025-04-09T12:51:45Z","entityUuid":"711300c0-39fb-4eb0-9baa-dd6d5aa77174","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"13b9cd11-3d80-4c92-b7f2-ce68f77a9f0e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Consider potential risks that could involve loss of data due to hardware failure or accidental deletion, unauthorized access to sensitive or confidential information, accidental sharing of personal or sensitive data, obsolescence of file formats or storage media, loss of access to cloud storage or repositories, staff turnover causing loss of data knowledge, or technical issues with collaborative tools."},"title":{"changed":false}},"createdAt":"2025-04-09T12:51:46Z","entityUuid":"85cd1720-48bc-4cd4-ba23-1a5713efd4df","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"481fc086-d204-4f7e-ba9f-9c479c14e0ea"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Describe the measures and strategies in place to prevent, minimize, or respond to identified risks. The solutions will vary depending on the nature of each risk and may include backup procedures, data encryption, access controls, staff training, disaster recovery plans, or alternative storage options. A clear plan helps ensure data protection and integrity throughout the project."},"title":{"changed":false}},"createdAt":"2025-04-09T12:51:47Z","entityUuid":"73810c2e-d154-4054-96bb-b35517c99747","parentUuid":"85cd1720-48bc-4cd4-ba23-1a5713efd4df","uuid":"df6ef49e-2aad-4836-a635-a89062a3f154"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-04-09T12:51:48Z","entityUuid":"da962567-0179-4e45-b746-9581db205150","parentUuid":"3cb234c5-1795-40f2-b3e0-6e2d27d8fd48","uuid":"3a6d8499-57db-4b88-ae6e-163046103f9f"},{"content":{"advice":{"changed":true,"value":"In some cases, data can be used without obtaining permission from the copyright holder if the use falls under a legal exception to copyright law (also known as a statutory exception or statutory license). These exceptions vary by country but often include provisions for research and innovation.\n\nFor example, within the European Union, the **text and data mining (TDM) exception** allows researchers to use copyrighted material for scientific research without needing a license, as long as the source is lawfully accessed. In Czech law, this is implemented under **§39d of Act No. 121/2000 Coll., Copyright Act**.\n\nAlways make sure that the intended use clearly falls within the scope of a relevant exception, and that any conditions (such as non-commercial use or secure storage) are respected."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"They can be used based on legal copyright exceptions, without needing explicit permission"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:51:49Z","entityUuid":"da962567-0179-4e45-b746-9581db205150","parentUuid":"3cb234c5-1795-40f2-b3e0-6e2d27d8fd48","uuid":"6a614621-6664-4124-a7f6-3b89a02aaf07"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["4cfe11a3-485c-4bb9-a0f6-f262a5705984","cc635ce2-417c-4b6f-813c-a71475356120","da962567-0179-4e45-b746-9581db205150","1a805c94-8d95-4a8e-821f-7d6869aabe69"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Although there is no universal rule for how copyright applies to datasets (as copyright only covers works involving a \"creative step\"), it is important not to assume that data can be used freely just because it is accessible. Always check for explicit permission to use the data.\n\nAs a general rule, the use of copyrighted works is prohibited unless:\n\n- **the law provides a specific exception** (also known as a statutory license), such as the **text and data mining exception** for research purposes (e.g., §39d of the Czech Copyright Act), or\n- **permission has been granted by the copyright holder**, typically in the form of a license.\n\nTherefore, if you cannot find a license and no legal exception applies, you must assume that the data **cannot** be used. Always assess both licensing terms and any applicable legal exceptions before reusing data."},"title":{"changed":false}},"createdAt":"2025-04-09T12:51:50Z","entityUuid":"3cb234c5-1795-40f2-b3e0-6e2d27d8fd48","parentUuid":"dd84fcb8-a5fb-449c-b6cb-071260a439b9","uuid":"d93cb5bf-e12f-4ae7-b40f-59dbe9ed4249"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If there are different versions available, you have to decide with all project partners together which version you will be using. You will probably go for the latest release as of the start date of your research project. However, if you have other data from older projects that need to be merged, consider using the same release you used for a previous project."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T12:51:51Z","entityUuid":"43a7ce55-9e99-4d44-94ba-e7d8991102e5","parentUuid":"e5a5738b-6134-4e48-9011-1f5d297982b1","uuid":"e49459c4-461c-40ed-8df3-0abbd24d2344"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-04-09T12:51:52Z","entityUuid":"9364c136-810d-416b-96fc-82b3dd04991f","parentUuid":"77c6e91d-2f4c-4a00-a827-c325b26f9830","uuid":"c02480a0-1dd2-4a80-b15e-545eae138e60"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"9bf46cb4-ac38-435d-afbc-c54a2dcd0acd"}},"createdAt":"2025-04-09T12:51:53Z","entityUuid":"9364c136-810d-416b-96fc-82b3dd04991f","parentUuid":"77c6e91d-2f4c-4a00-a827-c325b26f9830","uuid":"2515eebc-e980-467d-a337-8763b599d1da"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Can you use the dataset without any modifications?"}},"createdAt":"2025-04-09T12:51:54Z","entityUuid":"8798dd37-a636-4d53-87ae-5b4dece8954b","parentUuid":"103e31eb-f8f7-443d-b1d8-0d72ca30a572","uuid":"889b68b1-9a05-4649-ae35-db550efb28b9"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["4970dda2-e412-4778-81af-b49e7d95010b","040509af-4616-4683-9228-5b4c907ce4b2"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please add all \"formal\" identifiers you have for this data set: these can be handles or DOIs or any other type. One important purpose of these identifiers is to be able to refer back to the dataset.\n\nA good identifier is _persistent_ (i.e. it does not change, and also the same identifier will never be used for another data set), _globally unique_ (nobody else uses the same identifier for a different data set) and _resolvable_ (you can actually locate the data set if you only know the identifier).\n\nPlease note that if you are publishing the dataset in a repository, the repository may create a new persistent identifier, or you may provide an existing one that has already been created. You will be able to specify such additional identifiers under the \"publication\" questions. Specify one main identifier here."},"title":{"changed":false}},"createdAt":"2025-04-09T12:51:55Z","entityUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb","parentUuid":"4f76d114-2a43-4d6b-91ab-d96c4cfa5614","uuid":"92cfebc4-9b3f-4c4d-9d1c-682c7f91698b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"What this dataset is going to be used for. Please state its purpose in relation to the project objectives."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T12:51:56Z","entityUuid":"7598e37b-def5-483e-be0f-c4b3d48f9103","parentUuid":"4f76d114-2a43-4d6b-91ab-d96c4cfa5614","uuid":"bd5c89dc-6e9b-4345-8a57-220e57b4f1b3"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If the technology is still under development, it might be difficult to fully describe the measurement procedures at this stage. Consider whether the instrument and protocols are sufficiently standard or established, so that you can clearly explain how the data is collected or refer to an accepted description later."},"title":{"changed":true,"value":"Is the instrument and its use well described and based on standard practices?"}},"createdAt":"2025-04-09T12:51:57Z","entityUuid":"a40a7441-ccb5-4a84-bca8-933de13b68da","parentUuid":"b445defa-9a25-44af-bf10-44a65623ee9b","uuid":"d13bb4da-3765-4674-a247-54501729b673"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, the instrument and its use are well described and based on standard procedures"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:51:58Z","entityUuid":"22ddbead-70ed-45a0-983d-67c3f350a5d5","parentUuid":"a40a7441-ccb5-4a84-bca8-933de13b68da","uuid":"7760e1d4-e190-446d-a1fd-6f4c5931302a"},{"content":{"advice":{"changed":true,"value":null},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No, the instrument or procedures are still evolving or not fully described"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:51:59Z","entityUuid":"fa1a8ec5-5eaa-4842-b958-d9e64a9eebc3","parentUuid":"a40a7441-ccb5-4a84-bca8-933de13b68da","uuid":"aa12492c-ed10-421d-8ba4-52761a28a2d7"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Consider where the data originates and who will process it. In some cases, raw data is collected in a different location from where it is processed, which may require careful planning for data transfer and ingestion. Ensure that data security, integrity, and access are adequately addressed during this stage."},"title":{"changed":true,"value":"Is special preparation required to make the raw data ready for processing?"}},"createdAt":"2025-04-09T12:52:00Z","entityUuid":"30f6d09e-22cb-42a2-9e9e-ff5134c1db0e","parentUuid":"0fed0061-5fbe-4776-98d6-a73a98310997","uuid":"8c305f53-006f-4fd6-8122-40373e589ab1"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No, standard procedures are sufficient, therefore no special preparation is needed"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:01Z","entityUuid":"7fc745d7-e759-4064-9e5f-0fdbc3918432","parentUuid":"30f6d09e-22cb-42a2-9e9e-ff5134c1db0e","uuid":"f73849f4-ff8b-4fee-a182-6d11b3feccf1"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, special planning or measures will be required to prepare data"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:02Z","entityUuid":"b8f3740d-c514-4087-808c-c7155fda14d6","parentUuid":"30f6d09e-22cb-42a2-9e9e-ff5134c1db0e","uuid":"8bcf4e44-4608-481a-9f0b-1f312c2aae30"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Controlled vocabularies are standardized sets of terms used to ensure consistency in how data is described and categorized. Using them improves data quality, interoperability, and discoverability—especially when sharing or reusing data.\n\nFor example, instead of writing a free-text subject like *“heart disease”* or *\"cardiac illness\"*, you could use a standardized term from the [Medical Subject Headings: *\"Cardiovascular Diseases\"*](https://www.ncbi.nlm.nih.gov/mesh/68002318).\n\nUse controlled vocabularies where applicable—e.g., for keywords, geographic locations, species names, file formats, or measurement units."},"title":{"changed":false}},"createdAt":"2025-04-09T12:52:03Z","entityUuid":"4c5dd940-af4d-4996-babb-8edff99dfb49","parentUuid":"a776f152-25b6-44c8-a6cc-06046054f2a4","uuid":"69d26423-3583-40ac-bc4a-ec096f63fe59"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:52:04Z","entityUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","parentUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","uuid":"da318330-4701-4e8f-bcc4-2880242a4999"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you be using any other form of non-equipment data capture?"}},"createdAt":"2025-04-09T12:52:05Z","entityUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","parentUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","uuid":"55417324-9de7-45db-932e-00474b5e498f"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T12:52:06Z","entityUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","parentUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","uuid":"807dbcd9-32b8-41d0-b775-2c582664ab0d"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:52:07Z","entityUuid":"39577ebd-f88a-4c0e-9563-dac8a7f8c7b2","parentUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","uuid":"0771d3c2-3504-4bea-8cb6-15bf68f3164c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Yes"}},"createdAt":"2025-04-09T12:52:08Z","entityUuid":"39577ebd-f88a-4c0e-9563-dac8a7f8c7b2","parentUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","uuid":"9cd32f4a-e645-4705-8183-d307ced48956"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:52:09Z","entityUuid":"560d3042-2274-47cc-a3d8-15289d4cab23","parentUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","uuid":"a420aa7e-7aa3-4733-b5a1-18f6a2b8d117"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-04-09T12:52:10Z","entityUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","parentUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","uuid":"e208d944-1b5f-4279-876d-49b9daaa4dd4"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T12:52:11Z","entityUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","parentUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","uuid":"cfe73328-154e-4188-ac4a-6134d451a563"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-04-09T12:52:12Z","entityUuid":"a42bc47b-37f0-49b7-9c68-0791fd70dafb","parentUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","uuid":"741ef677-2522-4a9d-a1ba-d4e11d4a6bde"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:13Z","entityUuid":"a42bc47b-37f0-49b7-9c68-0791fd70dafb","parentUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","uuid":"4c46db90-79e4-473b-b289-614b85eec582"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-04-09T12:52:14Z","entityUuid":"7670aeb5-dc6a-4b54-80d8-b17b4ed392d3","parentUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","uuid":"57aa9ad9-7ee7-4c24-85c5-b76dccbd690d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:15Z","entityUuid":"7670aeb5-dc6a-4b54-80d8-b17b4ed392d3","parentUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","uuid":"6cae8bcb-61b9-48f0-a142-81b6261b8c2d"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:52:16Z","entityUuid":"021700c0-72d5-4db9-949c-6c8b5879163e","parentUuid":"7670aeb5-dc6a-4b54-80d8-b17b4ed392d3","uuid":"95810411-1be7-45f9-aeee-f18df5e673a2"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Please specify the other form(s) of non-equipment-based data collection"}},"createdAt":"2025-04-09T12:52:17Z","entityUuid":"021700c0-72d5-4db9-949c-6c8b5879163e","parentUuid":"7670aeb5-dc6a-4b54-80d8-b17b4ed392d3","uuid":"a076d424-f505-4603-b714-b3128a45b30b"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["a028dfdd-b769-4f76-8f30-83b302e35b24","fd94f449-9646-4828-aca7-ab5c2c9bca1d","a5c04467-a068-4ac5-8e6b-6c66f8bdb2dc","a8278435-dcee-4109-99aa-4c7b3712482c","a69e9563-d5f5-4c33-a586-015a17a0fb7a","f64be5b3-5941-4135-8df9-4904b05e1cbb","a1b95e00-6c0f-49bb-b1b4-b04f9ffc0ba2"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:18Z","entityUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","parentUuid":"3676c02e-5560-4781-aec7-8b5b29838480","uuid":"68cc6ef7-cf75-41f4-b3d7-eb7c0f9a352e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you be collecting through questionnaires?"}},"createdAt":"2025-04-09T12:52:19Z","entityUuid":"a028dfdd-b769-4f76-8f30-83b302e35b24","parentUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","uuid":"9f358079-d6a0-4409-9db0-9f6c9cb8b266"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you be using case report forms?"}},"createdAt":"2025-04-09T12:52:20Z","entityUuid":"fd94f449-9646-4828-aca7-ab5c2c9bca1d","parentUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","uuid":"2b0eae05-11d6-4ebe-8381-c584509cfd1f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you be using any other forms of non-equipment-based data collection?"}},"createdAt":"2025-04-09T12:52:21Z","entityUuid":"a8278435-dcee-4109-99aa-4c7b3712482c","parentUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","uuid":"f11af637-cd74-4b8b-b647-92f1475da7e1"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2025-04-09T12:52:22Z","entityUuid":"021700c0-72d5-4db9-949c-6c8b5879163e","parentUuid":"7670aeb5-dc6a-4b54-80d8-b17b4ed392d3","uuid":"b61a8203-b1aa-4ff4-9770-7b9d7fa61d9e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Many kinds of data are connected to people. If there could be a way for someone, including yourself, to find out who that person is, that is considered personal data.\n\nSimple examples are name, birth day or address; but there are many other data that can be personal: for example a voice recording, a combination of a location and a time (traffic flow), genetic information, or an X-ray of the skull."},"title":{"changed":false}},"createdAt":"2025-04-09T12:52:23Z","entityUuid":"e98d3229-be0b-480b-8ce6-326d9cf5da89","parentUuid":"907eea55-34af-4011-a782-172fca8290da","uuid":"7e2d7f6b-7e2f-45ac-baae-d0c7d9d4fd1a"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"65ba276b-3e3b-4c45-9b69-2dab2bd66452"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"If a new version of the dataset becomes available during your project, how will you handle it?"}},"createdAt":"2025-04-09T12:52:24Z","entityUuid":"10009746-517f-4d74-828f-8b738876d20a","parentUuid":"e5a5738b-6134-4e48-9011-1f5d297982b1","uuid":"afcde89a-771b-4c89-add0-a589a7db88c0"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-04-09T12:52:25Z","entityUuid":"f18bc994-3b0a-4dca-b9b1-72a35eb33566","parentUuid":"10009746-517f-4d74-828f-8b738876d20a","uuid":"1c308c79-cb30-48fb-b755-d318d901f0ea"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"The decision will depend on the type and extent of the update"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:26Z","entityUuid":"f18bc994-3b0a-4dca-b9b1-72a35eb33566","parentUuid":"10009746-517f-4d74-828f-8b738876d20a","uuid":"598596b1-eb52-4b7a-a266-59a10315044e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b6e1554b-18f3-47c1-bec2-83f62ca60bd3"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T12:52:27Z","entityUuid":"10009746-517f-4d74-828f-8b738876d20a","parentUuid":"e5a5738b-6134-4e48-9011-1f5d297982b1","uuid":"197f448a-0c49-4272-b2ae-49cfa3898e16"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"The party responsible for data collection owns the data"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:28Z","entityUuid":"c741d4c8-44bc-43d6-9921-c25aaae773bd","parentUuid":"53245d90-1c27-4e75-bcc6-43d987f9827c","uuid":"7694068d-6ba4-4f54-bdfd-c6ba8caa3d1b"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Other arrangements have been made"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:29Z","entityUuid":"bd420c17-1ae1-48f4-b6fe-e7b4ad99bc76","parentUuid":"53245d90-1c27-4e75-bcc6-43d987f9827c","uuid":"b4904647-779a-47bd-b1bd-6ab1b534bc03"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Ownership is equally shared between all project partners"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:30Z","entityUuid":"59c05855-9a21-46f6-bd09-882feb2e53c9","parentUuid":"53245d90-1c27-4e75-bcc6-43d987f9827c","uuid":"46ab90cf-c4d2-4635-90fa-7ef2ac547cb3"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If ownership is held by one partner or a third party, please choose option C and specify the arrangement in the follow-up question."},"title":{"changed":false}},"createdAt":"2025-04-09T12:52:31Z","entityUuid":"53245d90-1c27-4e75-bcc6-43d987f9827c","parentUuid":"f936a795-10aa-4879-aa4f-ea1e34a8c2cb","uuid":"da56fc49-0479-41b6-932b-bd39bd5a83e6"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Cross-referencing means establishing clear, direct links so you can easily identify which digital data belongs to which physical sample, and vice versa."},"title":{"changed":false}},"createdAt":"2025-04-09T12:52:32Z","entityUuid":"cfe918a3-e0ea-44b1-8222-203269f2d56c","parentUuid":"f2967d52-1781-4b97-8514-96711e66a0b5","uuid":"6f3cafcf-b736-4d85-9d60-1f4fac3b939d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please describe the specific methods or systems you will use to ensure that each physical sample is reliably linked to its digital data. This might include technical solutions, documentation practices, or management tools that make it easy to trace and access both sample and data.\nThis could involve assigning unique identifiers to samples that are recorded in metadata files, using a dedicated database or management system to track and link samples and data, or maintaining documentation that clearly maps sample IDs to digital files. Consistent labeling of physical samples combined with storing this information in a searchable system also helps facilitate quick and accurate retrieval."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T12:52:33Z","entityUuid":"190346e3-5782-4bef-aaca-88944b540eff","parentUuid":"e1783caa-dc4f-4c37-b3b9-c858095bda96","uuid":"5cbc2b9b-551f-41dd-8156-1eaad12b315f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Fully anonymised data means that all personal identifiers have been removed or altered so that no individual can be identified—either directly (e.g., by name or ID) or indirectly (e.g., through combination of other data points). This includes removing or masking information like birth dates, locations, or unique characteristics that could reveal someone’s identity. Once data is fully anonymised, it is no longer considered personal data under data protection laws."},"title":{"changed":true,"value":"Is the personal data fully anonymised, such that no individual can be identified, directly or indirectly?"}},"createdAt":"2025-04-09T12:52:34Z","entityUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","parentUuid":"16c0e7dd-03cc-4ec8-9928-41d87631ddb3","uuid":"d558ca58-9b64-4f78-ba31-900daaec44d3"},{"content":{"advice":{"changed":true,"value":"Since the data is not fully anonymised, your project falls under the General Data Protection Regulation (GDPR)."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:35Z","entityUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","parentUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","uuid":"89902a39-d5fb-4979-8336-49853cbbc6bd"},{"content":{"advice":{"changed":true,"value":"Since the data is fully anonymised, your project does not fall under the General Data Protection Regulation (GDPR)."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:52:36Z","entityUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","parentUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","uuid":"76cd8958-2108-46cd-93e1-e0e56ff64eb8"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","24becfca-9173-4bfa-b9e0-20c8f445dc22"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T12:52:37Z","entityUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","parentUuid":"16c0e7dd-03cc-4ec8-9928-41d87631ddb3","uuid":"d8b0cd19-1de5-4124-ae36-038394f00d7b"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-04-09T12:52:38Z","entityUuid":"dd4a9014-0a10-47da-8743-3efea6236572","parentUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","uuid":"85d2a769-5dbe-4f56-a954-bbb68b1dcbfa"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:52:39Z","entityUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","parentUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","uuid":"509b1bcd-3279-4210-b49b-b451e5589e79"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Which anonymisation techniques are or will be applied to ensure individuals cannot be identified?"}},"createdAt":"2025-04-09T12:52:40Z","entityUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","parentUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","uuid":"ccb9f7e1-13e2-4ef9-b173-06b4ac465d4f"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T12:52:41Z","entityUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","parentUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","uuid":"155cf734-b70a-45aa-84f0-1113cea54e0b"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:52:42Z","entityUuid":"be5f4601-ab72-4dd7-b85b-ec13c15d667b","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"defac087-d6a5-41c4-9a78-8d610d127579"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Removal of direct identifiers (e.g. names, emails, personal identification number)"}},"createdAt":"2025-04-09T12:52:43Z","entityUuid":"be5f4601-ab72-4dd7-b85b-ec13c15d667b","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"72157edb-4a9f-4b37-8150-fc1e8091f260"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:52:44Z","entityUuid":"96c264f4-6107-4b37-8317-95a22c83550e","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"dd3d1884-c4d6-446a-9a63-667ceb453504"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Generalisation (replacing specific values with broader categories, e.g. age ranges instead of exact ages)"}},"createdAt":"2025-04-09T12:52:45Z","entityUuid":"96c264f4-6107-4b37-8317-95a22c83550e","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"ac7e8cdb-0a70-4796-8879-df1494726ae3"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:52:46Z","entityUuid":"31e744fe-ba17-40b6-8238-69b6135aacfd","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"3848ebdd-fb86-4270-a5bc-c95695b3ce7f"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Aggregation (summarising individual records into groups, e.g. totals, averages)"}},"createdAt":"2025-04-09T12:52:47Z","entityUuid":"31e744fe-ba17-40b6-8238-69b6135aacfd","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"9f6365c9-6534-4157-a64b-418c2f95c0f0"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:52:48Z","entityUuid":"bb9242c0-ff1e-4726-9220-3aac9630342e","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"ed219682-f589-4857-bd49-37c2615b998d"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Suppression of unique or small groups (removing data that could identify individuals due to uniqueness)"}},"createdAt":"2025-04-09T12:52:49Z","entityUuid":"bb9242c0-ff1e-4726-9220-3aac9630342e","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"7216a5a4-cb35-4e2f-a247-db57b9626b20"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:52:50Z","entityUuid":"9eec6c91-4280-4c73-ac2e-f5d7f2a9dbe3","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"ccc10dbe-7325-494a-aafa-c9e91dbe3a46"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Synthetic data generation (replacing real data with statistically similar artificial data)"}},"createdAt":"2025-04-09T12:52:51Z","entityUuid":"9eec6c91-4280-4c73-ac2e-f5d7f2a9dbe3","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"96de2492-49ef-4597-9f18-8f21be053e87"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:52:52Z","entityUuid":"15309aff-c222-4411-b637-353fd209f075","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"0307a220-e175-4ce4-a563-f723a8dc651d"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Irreversible data masking (obscuring data in a way that prevents recovery, e.g., one-way encryption)"}},"createdAt":"2025-04-09T12:52:53Z","entityUuid":"15309aff-c222-4411-b637-353fd209f075","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"da1671ce-9bfb-4200-a56c-d168b963d0b9"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:52:54Z","entityUuid":"d365b756-4b0f-413a-aa98-8074505763eb","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"be33cf43-a7ce-434b-ad79-cf942decfa52"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Removal of metadata (removing identifying information from metadata, e.g. timestamps)"}},"createdAt":"2025-04-09T12:52:55Z","entityUuid":"d365b756-4b0f-413a-aa98-8074505763eb","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"5cf110aa-ca81-47e2-8034-ef4dc0897de6"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:52:56Z","entityUuid":"4cf5ba10-a784-49b0-bf93-2b04c6dacc73","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"250a3774-1bd9-411e-96c8-df0090361c1b"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Data minimisation (collecting and retaining only the data necessary for the intended purpose)"}},"createdAt":"2025-04-09T12:52:57Z","entityUuid":"4cf5ba10-a784-49b0-bf93-2b04c6dacc73","parentUuid":"8b765c87-ea86-4e8c-b8d5-dda54b62045f","uuid":"959f97d4-7184-4635-846d-ff39cc0828c1"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Select all applicable techniques and/or describe any additional methods you use that are not listed in the following question."},"title":{"changed":false}},"created