eUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Which version will you use?"}},"createdAt":"2023-08-01T14:09:53Z","entityUuid":"43a7ce55-9e99-4d44-94ba-e7d8991102e5","parentUuid":"e5a5738b-6134-4e48-9011-1f5d297982b1","uuid":"4d1917b1-8e53-4abf-b763-c8ddfd7484ca"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If there are different versions available, you have to decide with all project partners together which version you will be using. Probably you will go for the latest release as of the date of the start of your research project. However, if you have other data from older projects that need to be merged, you may need to consider using the same release you used for a previous project."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2023-08-01T14:09:54Z","entityUuid":"43a7ce55-9e99-4d44-94ba-e7d8991102e5","parentUuid":"e5a5738b-6134-4e48-9011-1f5d297982b1","uuid":"9c2117f7-5f6f-461d-99a5-ce1a898ea409"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T14:09:55Z","entityUuid":"10009746-517f-4d74-828f-8b738876d20a","parentUuid":"e5a5738b-6134-4e48-9011-1f5d297982b1","uuid":"5a5e8dc6-1bad-41b0-88f8-0fff828810a1"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If the version changes while you are working on your research project, you need to decide whether you will follow these changes. Most likely that will mean that you have to do some analyses again, so you will need to make sure enough resources are available to do so. You can decide to stay with the version that you started with; this can have the disadvantage that you will not benefit from added information or added consistency."},"title":{"changed":true,"value":"Will you change version if it updates?"}},"createdAt":"2023-08-01T14:09:56Z","entityUuid":"10009746-517f-4d74-828f-8b738876d20a","parentUuid":"e5a5738b-6134-4e48-9011-1f5d297982b1","uuid":"6643c4e4-a3c8-4d7e-838a-aaff5071d519"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T14:09:57Z","entityUuid":"43998997-7245-406c-8c44-4e79bf48dbfb","parentUuid":"10009746-517f-4d74-828f-8b738876d20a","uuid":"7a56ada8-3300-404b-a10e-5a982262978f"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Will stay with the old version"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T14:09:58Z","entityUuid":"43998997-7245-406c-8c44-4e79bf48dbfb","parentUuid":"10009746-517f-4d74-828f-8b738876d20a","uuid":"fd6dac48-e96f-4e3b-a7ac-39c48a4e3116"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T14:09:59Z","entityUuid":"2659c6c4-12b7-4753-91e8-e9633a93ea86","parentUuid":"10009746-517f-4d74-828f-8b738876d20a","uuid":"bb5c9021-7019-42d5-b2d1-a4103605fd28"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"New analyses will be done with the new version"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T14:10:00Z","entityUuid":"2659c6c4-12b7-47