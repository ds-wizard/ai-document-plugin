se},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":""}},"createdAt":"2023-08-01T14:00:38Z","entityUuid":"3d1f3a4c-fcc5-447a-bba2-0e84d00369a8","parentUuid":"d1332925-ff50-45cc-bae3-4839019be645","uuid":"783048cf-be62-4a8a-814c-33b8c259ded9"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2023-08-01T14:00:39Z","entityUuid":"3d1f3a4c-fcc5-447a-bba2-0e84d00369a8","parentUuid":"d1332925-ff50-45cc-bae3-4839019be645","uuid":"4152a1ab-97a1-4e64-985e-bc8d356f0d54"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T14:00:40Z","entityUuid":"8160741e-8f81-405e-9bf8-5b0e293efa38","parentUuid":"7263167f-7670-42a8-8683-c4a859dc6bc6","uuid":"d5c9b1d1-a483-4968-8aaa-52c2beb19454"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"When assessing the risk, take into account who has access to the lab, who has (physical) access to the computer hardware itself. Also consider whether data on those systems is properly backed up"},"title":{"changed":true,"value":"Do project members store data or software on computers in the lab or external hard drives connected to those computers?"}},"createdAt":"2023-08-01T14:00:41Z","entityUuid":"8160741e-8f81-405e-9bf8-5b0e293efa38","parentUuid":"7263167f-7670-42a8-8683-c4a859dc6bc6","uuid":"6d3e5c52-c67b-45dc-909c-cc1fdd6402cb"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T14:00:42Z","entityUuid":"c1c16c3a-0adc-44f1-b96f-4816c09eb481","