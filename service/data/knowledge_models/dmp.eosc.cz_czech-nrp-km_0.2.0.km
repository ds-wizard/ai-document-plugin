hanged":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Complicated (binary) file formats tend to change over time, and software may not stay compatible with older versions. Also, some formats (e.g. DOC, XLS) hamper long term usability by making use of patents or being hampered by restrictive licensing. \n\nIdeally a format should be simple, text only, completely described, not restricted by copyrights, and implemented in different software packages."},"title":{"changed":true,"value":"Does this data format enable sharing and long term archiving?"}},"createdAt":"2023-08-01T13:47:44Z","entityUuid":"58e8fa76-a414-4c81-b115-d3d7c232e597","parentUuid":"f1e49a7e-5671-4e4f-b4dc-703a197fcb4f","uuid":"8e2b2f5a-9e63-4de5-b6fe-7ebe606b03cc"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:47:45Z","entityUuid":"63071f65-824e-4085-988a-bd317e4ec4ee","parentUuid":"56c8fce9-89c7-4e93-acbc-0d39073cd1fa","uuid":"7dfc34de-b815-4194-8040-b983eccff814"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you convert to a file format more suitable for archiving later?"}},"createdAt":"2023-08-01T13:47:46Z","entityUuid":"63071f65-824e-4085-988a-bd317e4ec4ee","parentUuid":"56c8fce9-89c7-4e93-acbc-0d39073cd1fa","uuid":"5ebae925-937e-4a0c-8761-5cf805b7eaf8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:47:47