e-a199-f4ae5bd798fa"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Please specify the name of the repository or biobank where your samples will be stored during the project:"}},"createdAt":"2025-04-09T12:53:38Z","entityUuid":"f4e32cda-0fa3-4a79-8398-6ad243f37750","parentUuid":"5ae8c50f-3644-4839-8a27-73395bce1ee0","uuid":"9764f928-33f8-41d7-87b0-895cae99e1c9"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-04-09T12:53:39Z","entityUuid":"f4e32cda-0fa3-4a79-8398-6ad243f37750","parentUuid":"5ae8c50f-3644-4839-8a27-73395bce1ee0","uuid":"0a8adb8a-7abc-4551-8470-ada7683a131e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-04-09T12:53:40Z","entityUuid":"76b872ea-360d-4816-b06f-ef2edf912f57","parentUuid":"d76c93e8-6616-4e67-a3a2-57435d3d1987","uuid":"733d62b0-f0ef-47b6-a3f7-327d296dfc43"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please explain why the samples will not be deposited for long-term storage."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T12:53:41Z","entityUuid":"eba39cdd-5bfc-4e94-93b3-a92437cc2d95","parentUuid":"5ae8c50f-3644-4839-8a27-73395bce1ee0","uuid":"1d8e1add-9d6b-42d2-884d-b04d9158f2ef"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Please specify the name of the repository or biobank where your samples will be stored during the project"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T12:53:42Z","entityUuid":"f4e32cda-0fa3-4a79-8398-6ad243f37750","parentUuid":"5ae8c50f-3644-4839-8a27-73395bce1ee0","uuid":"aa701b87-c6d1-404f-ba75-0823ccbd3769"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Identification is crucial for linking physical samples to their metadata and ensuring traceability."},"title":{"changed":false}},"createdAt":"2025-04-09T12:53:43Z","entityUuid":"5cae4660-4f2d-41f2-96ca-549aba44e72b","parentUuid":"4dfbe93f-932a-401a-aa18-91a12d8fb65f","uuid":"f8a84e03-a63d-4187-a22b-f3f34221696e"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"4dfbe93f-932a-401a-aa18-91a12d8fb65f"},"createdAt":"2025-04-09T12:53:44Z","entityUuid":"cfe918a3-e0ea-44b1-8222-203269f2d56c","parentUuid":"f2967d52-1781-4b97-8514-96711e66a0b5","uuid":"ba17adf7-c7b2-49b3-8ead-178181965800"},{"content":{"advice":{"changed":true,"value":null},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T12:53:45Z","entityUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","parentUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","uuid":"a701449c-0e4a-40a6-93a7-108641648843"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Since you indicated that the data are not fully anonymised, they fall under the scope of the GDPR. Please specify whether the personal data are **pseudonymised** or **fully identifiable**.\n\n**Pseudonymisation** refers to the processing of personal data in such a manner that the personal data can no longer be attributed to a specific person without the use of additional information, i.e. any identifying characteristics are replaced with a pseudonym.\n\n**Identifiable** data contain direct or indirect identifiers that make it possible to attribute the information to a specific person, either on their own or in combination with other available data."},"title":{"changed":true,"value":"Select level of identifiability for the stored data"}},"createdAt":"2025-04-09T12:53:46Z","entityUuid":"bcc72ed4-bc15-4f9b-83a4-f789af1cafba","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"e31b6f7a-c98a-4b7f-85d1-d32a4f3b2f58"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"To ensure that the personal data that you process in the project is protected at an appropriate level, you should apply technical and procedural safeguards to ensure that the rights of the data subjects are not violated. Examples of such measures include, but are not limited to, pseudonymisation and encryption of data, the use of computing and storage environments with heightened security, and clear and documented procedures for project members to follow."},"title":{"changed":false}},"createdAt":"2025-04-09T12:53:47Z","entityUuid":"2b842099-d4f6-4994-9a31-789d529ecf25","parentUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","uuid":"fc7ae497-b7a0-4edd-971f-21f99cb1381f"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2025-04-09T12:53:48Z","entityUuid":"a2576971-1147-41f5-b754-acb0196ecfa4","parentUuid":"bcc72ed4-bc15-4f9b-83a4-f789af1cafba","uuid":"263060af-444f-43b4-a9b5-c0f2c58e883a"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:53:49Z","entityUuid":"ad90a2b2-d954-4dfb-94ac-683d9aa08855","parentUuid":"f6624003-3e6a-4223-b382-7b942ee58adc","uuid":"f35ece80-918c-422d-8687-71c7ec2af6a0"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Pseudonymisation is a recommended safeguard under the GDPR and national regulations, such as the [Czech Data Protection Act (Act No. 110/2019 Coll.)](https://www.zakonyprolidi.cz/translation/cs/2019-110?langid=1033). If your data remain fully identifiable, you should provide a clear and well-justified reason. This may include legal, ethical, technical, or scientific considerations that make pseudonymisation inappropriate or impractical in your specific case. Simply omitting this step without justification may not be compliant with data protection standards."},"title":{"changed":true,"value":"What is the reason for not applying at least pseudonymisation to the data?"},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-04-09T12:53:50Z","entityUuid":"ad90a2b2-d954-4dfb-94ac-683d9aa08855","parentUuid":"f6624003-3e6a-4223-b382-7b942ee58adc","uuid":"359a8aa8-aad7-4eda-bd8b-edc4c9496d98"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Sensitive data refers to information that could pose risks to individuals or organizations for example financial information, medical records, passwords and personal identity number."},"title":{"changed":false}},"createdAt":"2025-04-09T12:53:51Z","entityUuid":"d816c7e4-e450-4fd4-95e7-142481597074","parentUuid":"907eea55-34af-4011-a782-172fca8290da","uuid":"96478fb9-6724-4085-a074-f2d3e48697fa"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"93d6fe6e-256a-4888-8c09-9b885f8f0b20"},"createdAt":"2025-04-09T12:53:52Z","entityUuid":"e98d3229-be0b-480b-8ce6-326d9cf5da89","parentUuid":"907eea55-34af-4011-a782-172fca8290da","uuid":"28d5e692-1b56-4934-9d22-a5d0ed848eac"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:53:53Z","entityUuid":"ed737c80-68a0-418d-9ddb-2ecd59d3ab72","parentUuid":"7c4593f8-43d6-4cf3-b74e-75ae29f8249e","uuid":"d04e5c72-df5c-41c8-92ab-2e78ae0c2ab5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"This may include trade secrets, proprietary business data, classified information, sensitive ecological or archaeological site locations, data protected by non-disclosure agreements (NDAs), or culturally sensitive content. Please describe the type of data and any relevant restrictions or considerations."},"title":{"changed":true,"value":"What other types of sensitive data (excluding personal data) will you be working with?"}},"createdAt":"2025-04-09T12:53:54Z","entityUuid":"ed737c80-68a0-418d-9ddb-2ecd59d3ab72","parentUuid":"7c4593f8-43d6-4cf3-b74e-75ae29f8249e","uuid":"ef22d5b6-b903-4e5c-b41b-0e2501df85e2"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2025-04-09T12:53:55Z","entityUuid":"ed737c80-68a0-418d-9ddb-2ecd59d3ab72","parentUuid":"7c4593f8-43d6-4cf3-b74e-75ae29f8249e","uuid":"3fdca9fe-477a-495a-bb8e-9bd5263b893a"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Are some of the data in the project stored within folders? Folder organization strategies are most relevant for systems that use a hierarchical file structure or something similar—such as local or shared file systems, spreadsheet-based storage, or even object stores. While object stores are technically “flat,” they often simulate folder structures using naming conventions (prefixes or keys), making logical grouping possible."},"title":{"changed":true,"value":"Do you organise your data using folders?"}},"createdAt":"2025-04-09T12:53:56Z","entityUuid":"2e070ab7-1ee4-49dc-88ab-58957aec186c","parentUuid":"afbfa2aa-314f-4277-94b0-68cb1b94a476","uuid":"f2d06eeb-12aa-42cf-9423-73522e6bb416"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:53:57Z","entityUuid":"ff38c067-8c68-4cf0-95dc-43c327a3ea54","parentUuid":"f384b8d6-c075-40b3-964c-77fce092f706","uuid":"091cbffd-837d-452a-a108-86c23dc7475a"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please include the following considerations:\n- Whether you use separate folders for each sample or subject\n- Whether you organize information by (repeated) analyses or workflow steps\n- Your naming conventions for these folders\n\nMake sure names are relatively short, and avoid spaces and special characters. You can use underscore characters, and consider using unique identifiers for the samples/experiments. You can consider to add versioning using the date in YYYYMMDD format."},"title":{"changed":true,"value":"Please describe your folder organisation strategy"},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-04-09T12:53:58Z","entityUuid":"ff38c067-8c68-4cf0-95dc-43c327a3ea54","parentUuid":"f384b8d6-c075-40b3-964c-77fce092f706","uuid":"ef875b6a-6074-427d-97fb-bbd2f2aa4458"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-04-09T12:53:59Z","entityUuid":"792427e1-22b1-4625-8262-7601ed945380","parentUuid":"f384b8d6-c075-40b3-964c-77fce092f706","uuid":"a02bbd40-25c1-435b-ace4-ab98fef8ec5d"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-0