reatedAt":"2025-04-09T12:55:01Z","entityUuid":"2b860673-5bc1-4dc2-9723-cddfe3d0b48c","parentUuid":"4040c36a-26cb-45ff-badb-95d202377448","uuid":"5ad89380-ddc5-4885-8d5e-6aa4c9f9ee38"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Please specify"}},"createdAt":"2025-04-09T12:55:02Z","entityUuid":"2b860673-5bc1-4dc2-9723-cddfe3d0b48c","parentUuid":"4040c36a-26cb-45ff-badb-95d202377448","uuid":"91f194d2-7e1c-45e5-9c94-2d67c4e0d0bc"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-04-09T12:55:03Z","entityUuid":"2b860673-5bc1-4dc2-9723-cddfe3d0b48c","parentUuid":"4040c36a-26cb-45ff-badb-95d202377448","uuid":"e36153fe-3ba4-48b5-9f45-0f1fe86f8237"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-04-09T12:55:04Z","entityUuid":"ed6cc751-a49c-4982-a385-fd62a69a0d90","parentUuid":"afbfa2aa-314f-4277-94b0-68cb1b94a476","uuid":"90b96e1d-194c-4ac7-9ae1-6059c36f3aa5"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-04-09T12:55:05Z","entityUuid":"3847ebbe-247f-4a6f-aeb5-67dae49d5675","parentUuid":"afbfa2aa-314f-4277-94b0-68cb1b94a476","uuid":"40ca731a-4ab9-46c2-9473-6c818bf7bbed"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-04-09T12:55:06Z","entityUuid":"1b98cbff-9917-4a20-864e-17335dd97042","parentUuid":"afbfa2aa-314f-4277-94b0-68cb1b94a476","uuid":"43ddaa80-b006-461c-b864-81ace6a384da"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"**List all expected or actual costs related to data reuse, production, storage, and distribution across your project.** This includes specific expenses associated with making data FAIR—such as metadata creation, documentation, licensing, or repository fees—as well as costs for using specialised tools or infrastructure.\n\nFor each cost item, provide a clear title, a short description, the estimated or actual amount (including currency), and select the most relevant associated activities. While the list of activities is fixed, you may use the description field to clarify or elaborate as needed.\n\nAs your project progresses, remember to update estimated amounts with the actual paid values when they become available."},"title":{"changed":false}},"createdAt":"2025-04-09T12:55:07Z","entityUuid":"f2b5ebb5-e672-4505-9c6c-421bab9e3be5","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"937f245a-d095-4e21-b581-5e5c0255c3cb"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Specify the activity associated with this cost. If none of the listed options accurately reflect the purpose of the expense, please provide additional details in the text field below."},"title":{"changed":false}},"createdAt":"2025-04-09T12:55:08Z","entityUuid":"085c7383-7842-424c-b6da-980dee9f3efb","parentUuid":"f2b5ebb5-e672-4505-9c6c-421bab9e3be5","uuid":"c0d3f188-7da3-4dd3-b6cd-7361bcad2ee7"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T12:55:09Z","entityUuid":"7bfe0c78-a9fa-4af8-92e5-c80505704c3f","parentUuid":"f2b5ebb5-e672-4505-9c6c-421bab9e3be5","uuid":"16d04011-d9c0-475b-940d-a28ed8727ace"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If none of the listed activities above accurately represent the purpose of this cost, please provide additional details here. **Otherwise, you may leave the field empty.**"},"title":{"changed":true,"value":"Details beyond listed allocations"},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-04-09T12:55:10Z","entityUuid":"7bfe0c78-a9fa-4af8-92e5-c80505704c3f","parentUuid":"f2b5ebb5-e672-4505-9c6c-421bab9e3be5","uuid":"aaf27208-6db8-408c-bc19-f252b1199072"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["e4479aab-fb24-44b9-947b-59e636dadb35","db5ad91e-37af-4d51-b1cc-307cad8e1abb","f1504bae-7394-428a-b36a-74bf24c11fa1","bc1110cd-b06d-4752-b0e6-08c80e893944","085c7383-7842-424c-b6da-980dee9f3efb","7bfe0c78-a9fa-4af8-92e5-c80505704c3f","21be1204-3175-4b25-80c8-d5c6cbf96b12"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"**List all expected or actual costs related to data reuse, production, storage, and distribution across your project.** This includes specific expenses associated with making data FAIR—such as metadata creation, documentation, licensing, or repository fees—as well as costs for using specialised tools or infrastructure.\n\nFor each cost item, provide a clear title, a short description, the estimated or actual amount (including currency), and select the most relevant associated activities. While the list of activities is fixed, you may use the details field to clarify or elaborate as needed.\n\nAs your project progresses, remember to update estimated amounts with the actual costs when they become available."},"title":{"changed":false}},"createdAt":"2025-04-09T12:55:11Z","entityUuid":"f2b5ebb5-e672-4505-9c6c-421bab9e3be5","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"43a9e05a-fd13-40e7-8a9e-11a82a8a06bc"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:55:12Z","entityUuid":"ca47a185-f543-4f31-b0df-1b3addbfeb97","parentUuid":"085c7383-7842-424c-b6da-980dee9f3efb","uuid":"a13b137e-7cd3-4fe5-8872-935094946986"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Data curation and cleaning (e.g. validation, standardisation, formatting)"}},"createdAt":"2025-04-09T12:55:13Z","entityUuid":"ca47a185-f543-4f31-b0df-1b3addbfeb97","parentUuid":"085c7383-7842-424c-b6da-980dee9f3efb","uuid":"0b4e73e1-de75-453d-8ddb-6f73f5d5208e"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:55:14Z","entityUuid":"8698f4f2-cf12-4352-94c7-0b38d2061da9","parentUuid":"085c7383-7842-424c-b6da-980dee9f3efb","uuid":"f5b9500f-d583-4134-a341-e7ad84d6b5df"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Data anonymisation and privacy protection (e.g. pseudonymisation, GDPR compliance)"}},"createdAt":"2025-04-09T12:55:15Z","entityUuid":"8698f4f2-cf12-4352-94c7-0b38d2061da9","parentUuid":"085c7383-7842-424c-b6da-980dee9f3efb","uuid":"1a01937d-47e4-49c8-9a09-57dd9546e6a6"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-04-09T12:55:16Z","e