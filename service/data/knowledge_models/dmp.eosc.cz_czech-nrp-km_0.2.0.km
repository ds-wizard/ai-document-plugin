e},"valueType":{"changed":false}},"createdAt":"2025-07-24T09:24:49Z","entityUuid":"cd632cf8-3e00-43da-be2f-e412fc22746e","parentUuid":"711300c0-39fb-4eb0-9baa-dd6d5aa77174","uuid":"81c89829-8abd-42e0-bae5-df0bb14c36e2"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Description of how and why you are using this policy or procedure"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-07-24T09:24:50Z","entityUuid":"015405a5-b109-4f7d-b568-e827e75e377c","parentUuid":"711300c0-39fb-4eb0-9baa-dd6d5aa77174","uuid":"6df26fef-35b2-4756-b63d-36ac8ae67ad7"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"It is good for you to know approximately when you wish to start your data collection, as well as how long this process can last. Indicate the approximate date you plan to start (or have started) this data collection process."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-07-24T09:24:51Z","entityUuid":"daed5011-cbc9-4bc3-a4e9-33cd6ac98224","parentUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","uuid":"050b6ef9-e569-41c8-b10b-d8be33642241"},{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"isDocumentationAvailable"}]},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-07-24T09:24:52Z","entityUuid":"bb5b34b9-19c7-4dac-8fef-b9435b6d8438","parentUuid":"38958e9a-7b80-4d9d-b3bd-2d1ae8475260","uuid":"2fb5d16b-dd91-4544-bc94-69020340b1ce"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2025-07-24T09:24:53Z","entityUuid":"51db345e-0ac5-4385-adb2-5da6e05e3a06","parentUuid":"08fae6f7-2502-4195-9c80-ddd975aecb5f","uuid":"a453203f-1863-49ba-996b-5c5aa56a6d90"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The following legal bases are unlikely to be used for processing personal data when doing research.\n\nThe meaning of the different options are as follows:\n* Fulfil contract: we require the processing in order to fulfil our contract with the data subjects.\n* Legitimate interest: data subjects all expect us to do this data processing because of who we are.\n* Vital interest: we need to do this to protect the vital interests of the data subject.\n* Legal requirement: we are legally obliged to do this data processing.\n"},"title":{"changed":false}},"createdAt":"2025-07-24T09:24:54Z","entityUuid":"08fae6f7-2502-4195-9c80-ddd975aecb5f","parentUuid":"4792e5da-292c-4ad0-acdd-691c266b9333","uuid":"64a001f4-7fd3-493d-8c2d-99645ffa0543"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please provide a label of this metadata specification. In this context, the “metadata specification” refers to the description you are currently providing in this questionnaire about how metadata for your data will be defined. The label is only used internally to help distinguish this entry from others."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-07-24T09:24:55Z","entityUuid":"29189ee1-0cb5-4ec3-87c1-7662f3d9894e","parentUuid":"7a12e6c6-09f8-4ee2-a6fc-99c4946c3de9","uuid":"c9556328-8e4a-4aa6-96d7-196a25bf06d8"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will metadata be made openly available and licensed under a public domain dedication CC0?"}},"createdAt":"2025-07-24T09:24:56Z","entityUuid":"5876f65b-be89-4200-9584-ed01e9b2aadc","parentUuid":"7a12e6c6-09f8-4ee2-a6fc-99c4946c3de9","uuid":"e16c6a0c-8a2d-4438-8acf-97b5ee85a527"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"This chapter details the conditions and restrictions for data access and (re)use."},"title":{"changed":true,"value":"Data Access and (Re)Use Restrictions"}},"createdAt":"2025-07-24T09:24:57Z","entityUuid":"8e2dd2aa-8488-4433-afef-d7decd11c1b5","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"8d3ef477-5628-49f2-a94d-bfa0a0c3d9d8"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Data Access and (Re)Use Restriction"}},"createdAt":"2025-07-24T09:24:58Z","entityUuid":"59c95237-c27c-40a5-96c1-260fdece89b4","parentUuid":"8e2dd2aa-8488-4433-afef-d7decd11c1b5","uuid":"8d4e4640-d917-41e1-9e14-9df230c60ac5"},{"content":{"an