 full unit name instead of the unit abbreviation."},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2023-08-01T14:22:28Z","entityUuid":"35943206-7d10-4bd6-931d-b9a5ba62f479","parentUuid":"67c17b2d-2f00-47f5-a460-14e944f992cf","uuid":"868e40fc-fbdf-4596-adfb-322ff7c6f94c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"A Grant ID provides unique identification for the grant and is typically assigned by the funding agency or grant-awarding organization."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:22:29Z","entityUuid":"acd91149-ae2f-4af0-b59c-e90f284fb615","parentUuid":"fda5df56-bb70-4bae-9594-afa9b665ede7","uuid":"d8cffdc3-139b-45fa-bd7f-51adbbc3798b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Select the current status of the funding. **Planned** indicates you are preparing to apply, **Applied** means you have submitted the application and are awaiting the outcome, **Granted** means your project has been approved, and **Rejected** means your application was declined."},"title":{"changed":false}},"createdAt":"2023-08-01T14:22:30Z","entityUuid":"9650b56c-cd2e-409d-92cb-3c2a4de66d0b","parentUuid":"fda5df56-bb70-4bae-9594-afa9b665ede7","uuid":"2e83dc38-b2f7-4b90-801c-9582d0a027e0"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"A **stakeholder** is anyone who has an interest in or is affected by a project’s outcome. This can include individuals, groups, or organizations involved directly or indirectly."},"title":{"changed":false}},"createdAt":"2023-08-01T14:22:31Z","entityUuid":"11ee0c25-3017-4bd2-949d-c97439dffcb2","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"11a246de-2443-4b35-a1e6-90db154a61e4"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T14:22:32Z","entityUuid":"afbdbfa5-97db-48dc-8b8e-2128e9f68563","parentUuid":"085c7383-7842-424c-b6da-980dee9f3efb","uuid":"38fd94d5-4d97-4e5b-924c-a3bc41b11a89"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Using special tools"}},"createdAt":"2023-08-01T14:22:33Z","entityUuid":"afbdbfa5-97db-48dc-8b8e-2128e9f68563","parentUuid":"085c7383-7842-424c-b6da-980dee9f3efb","uuid":"8ed8bc80-a5dd-457d-9215-4eeefbc66c1a"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Specify the activity associated with this cost."},"title":{"changed":false}},"createdAt":"2023-08-01T14:22:34Z","entityUuid":"085c7383-7842-424c-b6da-980dee9f3efb","parentUuid":"f2b5ebb5-e672-4505-9c6c-421bab9e3be5","uuid":"e07c2cf9-624e-4486-b5c7-449f343b2726"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"listQuestionUuid":{"changed":false},"questionType":"ItemSelectQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Select from the previously mentioned funding grants that will be used to cover this cost."},"title":{"changed":false}},"createdAt":"2023-08-01T14:22:35Z","entityUuid":"b7401db8-d270-4f7a-b490-712baedc61df","parentUuid":"ea534b1b-4bfa-4e96-9c00-c964274aef14","uuid":"49398e04-6eed-4dd7-88e5-bfdcf09e27ef"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Describe a dataset you will be producing in your research."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:22:36Z","entityUuid":"622c9523-b96e-48cc-8693-7441003eacb8","parentUuid":"4f76d114-2a43-4d6b-91ab-d96c4cfa5614","uuid":"075d1fa3-84b2-4edd-b971-db8092ce2287"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":null},"title":{"changed":false}},"createdAt":"2023-08-01T14:22:37Z","entityUuid":"fe4619ab-1488-4535-b1fe-64e756bc0f6c","parentUuid":"907eea55-34af-4011-a782-172fca8290da","uuid":"215b6825-9f7d-4893-896a-456472c2c5d0"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:22:38Z","entityUuid":"84d84e3a-163c-4b7e-8706-bc2734a18502","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"47a22beb-ed5c-4760-88bb-ab27602cddd9"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:22:39Z","entityUuid":"e77ea17e-2724-42f0-b643-99b84a50c8b0","parentUuid":"a5c04467-a068-4ac5-8e6b-6c66f8bdb2dc","uuid":"1c4c2cf1-322a-4133-8493-b16c37e71278"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":false},"referenceType":"URLReference","url":{"changed":true,"value":"Is the collected data privacy sensitive?"}},"createdAt":"2023-08-01T14:22:40Z","entityUuid":"e77ea17e-2724-42f0-b643-99b84a50c8b0","parentUuid":"a5c04467-a068-4ac5-8e6b-6c66f8bdb2dc","uuid":"a1227143-ce16-4460-94c9-548a3eeef482"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":false}},"createdAt":"2023-08-01T14:22:41Z","entityUuid":"e77ea17e-2724-42f0-b643-99b84a50c8b0","parentUuid":"a5c04467-a068-4ac5-8e6b-6c66f8bdb2dc","uuid":"d005f7c6-e008-43cf-8202-860c2ca24fb5"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"84d84e3a-163c-4b7e-8706-bc2734a18502"}},"createdAt":"2023-08-01T14:22:42Z","entityUuid":"e77ea17e-2724-42f0-b643-99b84a50c8b0","parentUuid":"a5c04467-a068-4ac5-8e6b-6c66f8bdb2dc","uuid":"658eeb1b-70c4-451c-a7a8-48d746befc25"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"listQuestionUuid":{"changed":false},"questionType":"ItemSelectQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please select a contact person for this distribution from the list of previously added stakeholders."},"title":{"changed":false}},"createdAt":"2023-08-01T14:22:43Z","entityUuid":"67656fcf-48db-4d7f-8a83-5874f058e5bf","parentUuid":"fbb17122-3bc9-4780-9f8a-bbb0986e4b17","uuid":"092578d0-57e7-4bca-b068-fa5cc7cc68fa"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:22:44Z","entityUuid":"62fbfeba-59ae-458a-a212-1e050303ba1a","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"8db710ae-124a-484e-8a53-cf7069ccdbf4"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Data is often viewed as serving only the specific experiment for which it was generated. However, even in such cases, multiple team members—including those from different institutions—may need regular access to this data. It’s crucial to consider not only the legal and privacy implications but also the technical challenges that may arise when sharing data within a research group or consortium. This issue extends beyond the data itself. For example, if proprietary tools are used for preprocessing or if you utilize tools that are free for academic use but restricted for commercial purposes, sharing the data with private partners in your consortium may not be permissible. Additionally, if the data is too large or sensitive to be moved, ensure that all team members who require access can do so locally.\n\n## Key Tips\n- **Engage Early:** Discuss your data generation plans with all consortium partners early in the process.\n- **Verify Licensing:** Ensure that any licensed tools and vocabularies used to process, map, or format the data allow for sharing across the entire consortium.\n- **Anticipate Data Challenges:** Consider the size and complexity of the data and prepare for any hurdles that these features may present for effective sharing.\n\n## Avoid\n- **Don’t Assume Open Source Freedom:** Not all open-source tools and formats permit unrestricted sharing.\n- **Don’t Underestimate Partner Needs:** Avoid assuming that all consortium partners have only academic and pre-competitive interests in the data.\n- **Don’t Overlook Technical Limitations:** Confirm that all partners have adequate bandwidth, local storage, and computing resources to handle the data before proceeding.\n"},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Who needs access?"}},"createdAt":"2023-08-01T14:22:45Z","entityUuid":"62fbfeba-59ae-458a-a212-1e050303ba1a","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"c1271262-180b-4302-a990-74b8d0df9207"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:22:46Z","entityUuid":"b0d7f210-7163-4b07-8e2b-fc2e5b2f725c","parentUuid":"b4f3da10-773a-4d3e-8e14-cf4e77797743","uuid":"200c686e-92dc-43da-ad66-06c5515b1a47"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"62fbfeba-59ae-458a-a212-1e050303ba1a"}},"createdAt":"2023-08-01T14:22:47Z","entityUuid":"b0d7f210-7163-4b07-8e2b-fc2e5b2f725c","parentUuid":"b4f3da10-773a-4d3e-8e14-cf4e77797743","uuid":"304ff0a8-364c-4df3-aaf0-27526248fd27"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"## What's Up?\n\nWhen dealing with data, especially sensitive information such as patient data, it is essential to implement structural protections. This involves a thorough evaluation of the necessary security levels, including anonymization, pseudonymization, and encryption of the data. Additionally, you must ensure that the consent obtained from the patient permits all intended studies involving their data. A growing challenge is the increased reuse of valuable datasets and cohorts, which often occurs beyond the scope of the original consent. Without renewed consent, these additional experiments may be illegal, so it is crucial to obtain the broadest possible consent allowed by ethical committees while remaining acceptable to individual patients. One option is to keep control of personal data entirely in the hands of research subjects, allowing them to provide informed consent for each future study that involves their data. In this case, specialized technologies are needed (see PHT). In all instances, be mindful of the potential to achieve the same results by reusing existing datasets rather than unnecessarily creating new privacy-sensitive data, which can impose significant responsibilities and financial challenges on your research group.\n\n## Key Tips\n- Consult with all investigators to determine whether temporary or structural protection of the data is necessary.\n- Estimate the duration for which the data needs protection and assess the availability of infrastructure, funding, and procedures to facilitate that.\n- Calculate the costs associated with long-term protection of the data after experiments are concluded and results are published.\n\n## Avoid\n- Assume that data can be placed on \"any laptop\" within the institution, even if there are no privacy or sensitivity concerns. Doing so may violate internal procedures.\n- Note: This is an ideal area where \"local expertise and resources\" can be customized as a \"button on the website\" for the institution. Existing collections stewards can actively maintain records of what is available, thereby minimizing the risk that naive PhD students and their equally inexperienced (or overcommitted) PIs will unnecessarily start from scratch.\n"},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Is the collected data privacy sensitive?"}},"createdAt":"2023-08-01T14:22:48Z","entityUuid":"84d84e3a-163c-4b7e-8706-bc2734a18502","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"ceb190aa-1960-497e-9489-5c9a45a80ce7"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:22:49Z","entityUuid":"0e6099d3-f7fa-4edf-86ac-21240271e2aa","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"1775d2bf-cccf-4584-82c2-b3cae507b7eb"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"A key issue in science is to define any concept with the highest level of precision. In data stewardship and FAIR data principles, a critical aspect is the use of controlled vocabularies, thesauri, and ontologies—collectively referred to as \"terminology systems.\" These systems aim to define concepts as accurately as possible. Before you begin mapping the concepts in your data to a specific terminology system, it is essential to understand the basics of these systems, including the differences between controlled term lists and synonyms versus the functional relationships established in ontologies. Ontologies represent a particular abstraction of reality that may not always align with your needs.\n\nControlled vocabularies and thesauri typically provide terms along with their defined meanings, synonyms, and, in some instances, homonyms (terms with multiple meanings).\n\nFor a deeper understanding of terminology systems, particularly the semiotic (Ogden triangle) and its relation to data publishing, we recommend the reference *(Mons + Velterop)*.\n\nIn summary, the FAIR guiding principles stipulate that every concept in your data should be referred to using a machine-resolvable persistent identifier.\n\n## Key Tips\n- Ensure you do not label yourself as a data expert without a fundamental understanding of terminology systems, including their strengths, weaknesses, and limitations.\n- Confirm that all concepts you intend to reference are covered by an existing terminology system that has broad community adoption.\n- Compile a list of concepts present in your data that are not included in your preferred terminology system.\n- Consider using persistent identifiers from other terminology systems, following the same criteria for community adoption.\n- Only create a new concept identity and define its meaning if existing terminology systems do not adequately identify the concepts you need.\n- Report the creation of a new concept and its defined meaning to the nearest relevant authority and, preferably, to the stewards of the terminology system most suited for the newly defined concept.\n\n## Avoid\n- Avoid using the terms \"ontology,\" \"controlled vocabulary,\" and \"thesaurus\" interchangeably in discussions and written communication.\n- Refrain from using ontologies when a controlled vocabulary suffices. Ontologies involve multiple links to other concepts, which may not be accurate for your situation.\n- Do not create a new symbol or identifier for a concept in your data without thoroughly searching existing terminology systems.\n- Avoid creating a concept without first defining the specific \"unit of thought\" represented by the new identifier.\n- Refrain from developing your own sub-terminology system without sharing that effort with the community.\n"},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Are there suitable terminology systems?"}},"createdAt":"2023-08-01T14:22:50Z","entityUuid":"0e6099d3-f7fa-4edf-86ac-21240271e2aa","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"6877a452-5c68-4d38-8ce0-3b62f757b9f0"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:22:51Z","entityUuid":"69fcbbd4-8521-4dfe-9aa8-83c9c197b892","parentUuid":"491a6e28-b2ce-4257-8459-a316c864d86b","uuid":"6304e15c-fba1-4461-b9a9-cfed02d61bd6"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"0e6099d3-f7fa-4edf-86ac-21240271e2aa"}},"createdAt":"2023-08-01T14:22:52Z","entityUuid":"69fcbbd4-8521-4dfe-9aa8-83c9c197b892","parentUuid":"491a6e28-b2ce-4257-8459-a316c864d86b","uuid":"ab8a487c-be9a-4083-ac5c-f77e2d1c79ee"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Project Start Date"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:22:53Z","entityUuid":"6e679f0d-1b7a-4e80-b372-ac7ef454c84f","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"1345214b-b79b-42e5-98ff-ec6502340cf0"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Project End Date"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:22:54Z","entityUuid":"e31d9e4d-6072-4653-b44e-3903d7c711ce","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"958d3d28-8a5f-4ffa-8eb6-2c66a0634160"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"At the start of the project, provide the estimated amount. Once the actual amount is known, adjust it to reflect the final paid amount."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:22:55Z","entityUuid":"bc1110cd-b06d-4752-b0e6-08c80e893944","parentUuid":"f2b5ebb5-e672-4505-9c6c-421bab9e3be5","uuid":"9b454459-3975-4b9e-868c-ef1d1b6ce171"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Are there any data sets available in the world (online or offline) that are relevant to your planned research?"},"title":{"changed":false}},"createdAt":"2023-08-01T14:22:56Z","entityUuid":"eea1d687-b880-4305-97e6-8b3821497c5f","parentUuid":"c79f38d4-5c6f-4f86-86a1-94bac529a666","uuid":"81e6192e-4d04-4330-b4f7-c2ea34868336"},{"content":{"annotations":{"changed":false},"eventType"