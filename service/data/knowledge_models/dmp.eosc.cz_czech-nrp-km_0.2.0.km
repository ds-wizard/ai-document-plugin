:false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, they must stay in the EU"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:43:38Z","entityUuid":"912709d3-f2a1-474c-92b1-ff06b6daa982","parentUuid":"7dd60773-a412-4b12-a02f-b09edf58a926","uuid":"6a34d188-44fe-4495-9f83-3573930f4625"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:43:39Z","entityUuid":"c99ad69c-86e9-4cc3-8e7c-e6d9505c8992","parentUuid":"7dd60773-a412-4b12-a02f-b09edf58a926","uuid":"45a90cbb-bc1d-42d2-8854-c87b71bdc75b"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, they must stay in the same country"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:43:40Z","entityUuid":"c99ad69c-86e9-4cc3-8e7c-e6d9505c8992","parentUuid":"7dd60773-a412-4b12-a02f-b09edf58a926","uuid":"485c6257-efa7-40ff-9cf5-4ec722f702ee"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:43:41Z","entityUuid":"a99d9b2b-d06f-439a-b6fa-18b38eb67290","parentUuid":"7dd60773-a412-4b12-a02f-b09edf58a926","uuid":"c76677b8-34ab-4fe2-b5ce-14544cfad450"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, they must stay in the same institute"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:43:42Z","entityUuid":"a99d9b2b-d06f-439a-b6fa-18b38eb67290","parentUuid":"7dd60773-a412-4b12-a02f-b09edf58a926","uuid":"6d9ee8c0-0243-4920-ae8f-ea0a0736dff0"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:43:43Z","entityUuid":"5abc1a6f-5d27-42e4-b59b-10edef01aba0","parentUuid":"5222c57d-5c98-4ae3-ace8-b2b7e03f7b3a","uuid":"986b72ac-676e-4e1b-9757-9c1f6fe405c5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Legally, pseudonymous data (which means that someone has the key to reverse the process) is still considered privacy sensitive information. However, the EU is working on special cases where the data can still be opened as long as the key availability is sufficiently limited."},"title":{"changed":true,"value":"Could pseudonymization be used to make the data more openly available?"}},"createdAt":"2023-08-01T13:43:44Z","entityUuid":"5abc1a6f-5d27-42e4-b59b-10edef01aba0","parentUuid":"5222c57d-5c98-4ae3-ace8-b2b7e03f7b3a","uuid":"e40f9f0c-e0f2-4899-8009-67d0011951ae"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:43:45Z","entityUuid":"474eb9fe-0116-47dd-b063-61e28abe0053","parentUuid":"5abc1a6f-5d27-42e4-b59b-10edef01aba0","uuid":"257d458d-861d-403e-911f-1d73c9cc69cb"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:43:46Z","entityUuid":"474eb9fe-0116-47dd-b063-61e28abe0053","parentUuid":"5abc1a6f-5d27-42e4-b59b-10edef01aba0","uuid":"ff06160c-3580-4c73-9eee-9d11ffe4297c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:43:47Z","entityUuid":"11518fa2-b553-4da8-8015-29996c39eb25","parentUuid":"474eb9fe-0116-47dd-b063-61e28abe0