":false},"itemTemplateQuestionUuids":{"changed":true,"value":["a2353a20-be1f-451a-8caf-4e51670432ba","32d3b634-9403-42ab-8db4-e231ddd7e48a","aa34ed64-10ba-488b-b215-5bc50f75b286","44e5313a-f6e0-4a2d-890b-89f9348a5254","a08ffdfd-f568-4847-9ac0-073a8dfa6793"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T13:00:49Z","entityUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47","parentUuid":"c86ec70c-e5ef-4b0c-b969-772c658ffdb9","uuid":"bd368147-7d70-421f-a51c-9cf255b95b28"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T13:00:50Z","entityUuid":"d221b5ed-6748-4b1a-ae76-d4d67d0bcd3b","parentUuid":"59c95237-c27c-40a5-96c1-260fdece89b4","uuid":"2bf5005d-461f-41cb-847b-d3be06d4cd7d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please provide a label for this Data (Re)Use Restriction Specification. This label is only used to help distinguish this entry within the questionnaire."},"title":{"changed":true,"value":"Label for this Data (Re)Use Restriction Specification"}},"createdAt":"2025-04-09T13:00:51Z","entityUuid":"d221b5ed-6748-4b1a-ae76-d4d67d0bcd3b","parentUuid":"59c95237-c27c-40a5-96c1-260fdece89b4","uuid":"7df80f65-3247-4179-a726-e682ed844ceb"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["5d9fa997-90a2-477d-b2ab-90a5e38c94ca","d221b5ed-6748-4b1a-ae76-d4d67d0bcd3b","a2f4cc5a-17fb-4fa5-9d24-cff659613427","d716312a-6fd8-4c07-917c-42c2ff9069ab","b4f3da10-773a-4d3e-8e14-cf4e77797743"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T13:00:52Z","entityUuid":"59c95237-c27c-40a5-96c1-260fdece89b4","parentUuid":"8e2dd2aa-8488-4433-afef-d7decd11c1b5","uuid":"d257d7a1-1e30-4823-96ab-955ab5065fed"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"**List all expected or actual costs related to data reuse, production, storage, and distribution across your project.** This includes specific expenses associated with making data FAIR—such as metadata creation, documentation, licensing, or repository fees—as well as costs for using specialised tools or infrastructure.\n\nFor each cost item, provide a clear title, a short description, the estimated or actual amount (including currency), and select the most relevant associated activities. While the list of activities is fixed, you may use the details field to clarify or elaborate as needed.\n\n**As your project progresses, remember to update estimated amounts with the actual costs when they become available.**"},"title":{"changed":false}},"createdAt":"2025-04-09T13:00:53Z","entityUuid":"f2b5ebb5-e672-4505-9c6c-421bab9e3be5","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"06ef1abe-7feb-4217-8f34-15c19a0d8443"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":true,"value":[]},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:00:54Z","entityUuid":"e2dc07f9-0cea-456a-b628-79e6b1a076bb","parentUuid":"11ee0c25-3017-4bd2-949d-c97439dffcb2","uuid":"edc1416f-42f0-422b-a1fe-ccb869aa5b38"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Each person or institution contributing to creating or executing the data management plan should be added as a contributor. **A project probably should have a Contact Person, and a Data Curator.**"},"title":{"changed":false}},"createdAt":"2025-04-09T13:00:55Z","entityUuid":"11ee0c25-3017-4bd2-949d-c97439dffcb2","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"bec42889-c194-4d39-8fb4-075c762eceed"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Clear and consistent communication is essential for successful project coordination. Establishing communication channels early on enables contributors—regardless of their roles—to efficiently share updates, ask questions, and collaborate effectively. Well-defined communication structures help maintain project momentum, ensure alignment with project goals, and support timely decision-making.\n\nIn projects that involve handling personal data or non-anonymous survey responses, additional care should be taken to ensure compliance with data protection requirements. This includes keeping relevant parties—such as data managers, researchers, and privacy officers—informed of protocols and responsibilities. Where appropriate, implementing Non-Disclosure Agreements (NDAs) or other confidentiality measures can help safeguard sensitive information and maintain trust among stakeholders."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:00:56Z","entityUuid":"bf4cb9e3-64ce-4b3a-97f8-cb80b8258081","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"6136f1bc-5306-47f7-8b10-b67d5c23f31e"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"This chapter offers an overview of all datasets to be generated during your project(s), along with detailed information about each one."},"title":{"changed":false}},"createdAt":"2025-04-09T13:00:57Z","entityUuid":"b55c4488-6c0e-4c36-88e5-44aa401157db","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"bc35ffa5-1464-40a8-ad51-0af51c12b774"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please list each dataset you will produce as a **separate entry**."},"title":{"changed":false}},"createdAt":"2025-04-09T13:00:58Z","entityUuid":"a7a67bd9-7912-4321-880e-7cf0355ce301","parentUuid":"b55c4488-6c0e-4c36-88e5-44aa401157db","uuid":"96fa1022-0d1f-4317-a44e-10a20eda3958"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T13:00:59Z","entityUuid":"7799d709-918e-4441-b0ae-867702f5e839","parentUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb","uuid":"df8576de-20de-4804-81d4-0b3b71acbca6"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Dataset Identifier Type Integration"}},"createdAt":"2025-04-09T13:01:00Z","entityUuid":"7799d709-918e-4441-b0ae-867702f5e839","parentUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb","uuid":"e7127f33-f880-46cd-be08-3c33550060e7"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"1c3647c2-089e-40bd-a744-4137da49edc2"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-04-09T13:01:01Z","entityUuid":"7799d709-918e-4441-b0ae-867702f5e839","parentUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb","uuid":"1643224d-7274-4b42-9794-6b4184dae042"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["040509af-4616-4683-9228-5b4c907ce4b2","4970dda2-e412-4778-81af-b49e7d95010b","7799d709-918e-4441-b0ae-867702f5e839"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:02Z","entityUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb","parentUuid":"a7a67bd9-7912-4321-880e-7cf0355ce301","uuid":"12947e50-fb26-472a-bf21-e168a6bde96e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Provide the type of identifier. You will be presented with suggestions from [FAIRSharing](https://fairsharing.org/), but you also have the option to manually enter the identifier type that is not listed there."},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-04-09T13:01:03Z","entityUuid":"7799d709-918e-4441-b0ae-867702f5e839","parentUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb","uuid":"0b4efd72-68d6-4756-8926-773f5d8a40b3"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If possible, provide the type according to: DataCite and/or COAR dictionary.\n\n* [https://schema.datacite.org/meta/kernel-4.1/doc/DataCite-MetadataKernel_v4.1.pdf](https://schema.datacite.org/meta/kernel-4.1/doc/DataCite-MetadataKernel_v4.1.pdf)\n* [https://vocabularies.coar-repositories.org/resource_types/](https://vocabularies.coar-repositories.org/resource_types/)\n\nOtherwise use the common name for the type, e.g. raw data, software, survey, etc."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:04Z","entityUuid":"fe4e19b1-cc2e-4031-8a28-b49976ce0f78","parentUuid":"a7a67bd9-7912-4321-880e-7cf0355ce301","uuid":"df4c8f87-ed99-4be3-a55e-7ed6e66695ab"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":null},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:05Z","entityUuid":"7f1733cb-5e4f-497f-bc9d-bb8eace51b62","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"7011a4fa-eb00-47ad-b7f2-d1139ece78ba"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-04-09T13:01:06Z","entityUuid":"7598e37b-def5-483e-be0f-c4b3d48f9103","parentUuid":"a7a67bd9-7912-4321-880e-7cf0355ce301","uuid":"4c1e554f-0053-48b3-b378-d9a040ea96e8"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"This chapter outlines the methods and processes for collecting the different datasets throughout your project(s)."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:07Z","entityUuid":"30dd2bb9-9c2d-4ccf-b24a-428aea429b7a","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"9af1dce8-de91-48c6-b7f6-9ecd978d130b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please document each **distinct data collection process** as a **separate entry**.\n\nFor each entry, begin by specifying whether the described data collection process applies to **all datasets** or only to **specific datasets**. If it applies only to selected datasets, you will have the opportunity to identify exactly which datasets were produced using this method.\n\nIf your project(s) involves only **one data collection process**, complete a **single entry** that thoroughly describes that process.\n\nPlease pay **close attention** to ensure that **all datasets** associated with your project are fully accounted for and appropriately linked to their respective data collection processes. This is essential for maintaining transparency and completeness."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:08Z","entityUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","parentUuid":"30dd2bb9-9c2d-4ccf-b24a-428aea429b7a","uuid":"3244db94-1421-4b67-9bee-e53ff55c5580"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Is the data collection approach consistent across all datasets you've produced?"}},"createdAt":"2025-04-09T13:01:09Z","entityUuid":"0c88f0a5-92cf-4e82-b528-6bdcf3a0bc8c","parentUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","uuid":"9fb12f85-958e-468f-8fdb-9a4f403c35fb"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["d2098bc8-d3d4-45bc-b5f2-b395e12c5103","0c88f0a5-92cf-4e82-b528-6bdcf3a0bc8c","daed5011-cbc9-4bc3-a4e9-33cd6ac98224","28c7dad9-dacb-468d-8d57-3e36978e9f00","fe4619ab-1488-4535-b1fe-64e756bc0f6c","968cb22c-d75c-4c69-884e-39b55773b61a","3676c02e-5560-4781-aec7-8b5b29838480","d816c7e4-e450-4fd4-95e7-142481597074","dedc1acc-2be5-4af1-9287-96c9c95f85d7","689a01b7-cf2f-47ff-a5c1-a88b49bf2a38"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:10Z","entityUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","parentUuid":"30dd2bb9-9c2d-4ccf-b24a-428aea429b7a","uuid":"f1d0fecc-d6c5-4978-b411-48830777fcda"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please provide a label for this Data Collection Process. This label is used solely to distinguish this entry within the questionnaire."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:11Z","entityUuid":"d2098bc8-d3d4-45bc-b5f2-b395e12c5103","parentUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","uuid":"d30a9d01-6f48-44f6-bbbe-aa90e1ce0b1b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"It is good for you to know approxiately when you wish to start your data collection, as well as how long this process can last. Indicate the approximate date you plan to start (or have started) the data collection for the specific dataset."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:12Z","entityUuid":"daed5011-cbc9-4bc3-a4e9-33cd6ac98224","parentUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","uuid":"b3a35ae6-04d2-487c-b4c6-1d43d3aef941"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"You should know the approximate duration of your data collection period, to make sure you will have data in time for handing over your project deliverables. Indicate the approximate end date of the data collection for the specific dataset."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:13Z","entityUuid":"28c7dad9-dacb-468d-8d57-3e36978e9f00","parentUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","uuid":"a89b0fb7-6627-48e3-9908-88f3f46a6806"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"In applied research, calibration often refers to the adjustment of processes and instruments rather than traditional measurements."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:14Z","entityUuid":"8aa7e3a6-a74d-4323-8b15-f5b32b11508b","parentUuid":"a776f152-25b6-44c8-a6cc-06046054f2a4","uuid":"eb206805-022e-48fc-8706-ef1f93c8600d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Search using the full unit name instead of the unit abbreviation.\n\nPlease enter measurement units only when applicable to the dataset. If the dataset does not include quantifiable values, this field may be left blank."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:15Z","entityUuid":"1ead92e3-72be-4bd1-98f6-3a2927903e32","parentUuid":"0fed0061-5fbe-4776-98d6-a73a98310997","uuid":"dbd49567-14ea-4ecc-99eb-5be4c757aa6f"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Please specify the name of the repository or biobank where your samples will be stored during the project:"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:16Z","entityUuid":"f4e32cda-0fa3-4a79-8398-6ad243f37750","parentUuid":"5ae8c50f-3644-4839-8a27-73395bce1ee0","uuid":"af9fe825-8886-4719-803e-9f4530e9c506"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Search using the full unit name instead of the unit abbreviation.\n\nPlease enter measurement units only when applicable to the dataset. If the dataset does not include quantifiable values, this field may be left blank."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:17Z","entityUuid":"67c17b2d-2f00-47f5-a460-14e944f992cf","parentUuid":"f2967d52-1781-4b97-8514-96711e66a0b5","uuid":"ecd69994-76ff-4af0-9e48-e4e0eec3a510"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Search using the full unit name instead of the unit abbreviation.\n\nPlease enter measurement units only when applicable to the dataset. If the dataset does not include quantifiable values, this field may be left blank."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:18Z","entityUuid":"a1b95e00-6c0f-49bb-b1b4-b04f9ffc0ba2","parentUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","uuid":"78040acf-26f6-4c6b-8276-390a0cc0d6e0"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Describe all security measures applied to protect sensitive non-personal information in the dataset.\nThis may include techniques such as encryption, access restrictions (e.g., physical access only), or internal data handling procedures. Sensitive non-personal data can include proprietary business information (such as trade secrets or financial data), unpublished research results, security-related technical details (like system configurations or vulnerabilities), or classified environmental or geopolitical information."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:19Z","entityUuid":"c9b17b43-8fe6-4655-98cf-4d9fc941dfc4","parentUuid":"93d6fe6e-256a-4888-8c09-9b885f8f0b20","uuid":"923a9621-b163-4464-a4a7-84a42394f6c9"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Add any additional details about the storage type that are relevant to your specific context or intended use."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:20Z","entityUuid":"a0ab6dce-280f-47f4-a2bc-47fd80f5366c","parentUuid":"b34dc4a0-1cf3-4402-a2a0-1b67ac695278","uuid":"c61c6e28-371d-4103-854c-6ac55a27447a"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["81912324-2c66-43c3-b3c5-107a475f5439","606ee38d-b118-4d68-973c-7a96bb9ceff5","8962457b-e836-4b74-8550-8052cd20a341","efc9bb91-9257-460e-9852-6f366c013868","2a1f93d3-3adf-40f5-bf37-7b1fd87f248c","a0ab6dce-280f-47f4-a2bc-47fd80f5366c","6856ec6e-9cb3-4310-bb03-c24b9ed8901a","de95678c-75ca-449d-a730-86a3cb2796b0","82c605d7-2f85-4766-ac18-e7183181c531"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T13:01:21Z","entityUuid":"b34dc4a0-1cf3-4402-a2a0-1b67ac695278","parentUuid":"cb785668-1d38-4efe-92f8-99b6a264bc71","uuid":"a3cb9778-8618-4707-9818-9fb93dd651eb"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Describe any requirements or steps necessary to access and use the hosting infrastructure. This may include creating a user account, obtaining access credentials or API keys, agreeing to usage terms, undergoing approval processes, or installing specific tools or software."},"title":{"changed":true,"value":"What arrangements are needed to utilize the Data Storage Infrastructure?"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:22Z","entityUuid":"83485162-536e-4acf-ba59-34d5f61d2b8a","parentUuid":"be881f59-db85-4713-a911-929ca539010a","uuid":"7b54c31c-326d-453c-b4ba-e2df01752054"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What is the geolocation of the Data Storage Infrastructure?"},"variables":{"changed":false}},"createdAt":"2025-04-09T13:01:23Z","entityUuid":"70058fa0-8b44-45d6-a41a-c5c6514912ba","parentUuid":"be881f59-db85-4713-a911-929ca539010a","uuid":"7759df0d-c8f2-43f1-998b-09b81c7c59c3"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"This chapter provides an overview of all distributions created from the datasets produced by your project(s)."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:24Z","entityUuid":"7fccc342-deaa-4105-bfdf-43b872291c86","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"38201bd1-2bbd-4f44-b88e-87a5044ef11c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["3bb3bf13-3adc-4fe2-93d5-94de606543d3","cca825e4-5c84-4290-865a-88eeba3867ba","62378027-96f4-411b-a1d9-efd51b68c3e9","67656fcf-48db-4d7f-8a83-5874f058e5bf","b560dc2c-817a-4343-aea3-4a13f0b5b1d3","c113f70e-1e78-4bf3-8e68-851287b9b2d8","eab525f3-5bd5-4f73-a788-0514f5924f0e","6eecbc04-ad0c-4e4f-9dbd-a56326520508","46930e91-3b93-46cd-897f-4baa460ce0be"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:25Z","entityUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b","parentUuid":"7fccc342-deaa-4105-bfdf-43b872291c86","uuid":"fb1f8f0a-40ba-4815-9ab4-a8741e624912"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Have you identified types of data that you will use that are used by others too? Some types of data (for example \"images\" or \"tables\") are used by many different projects. For such data, often common standards exist (in our example \"JPG\" and \"CSV\" [comma separated values]) that help to make these data reusable. Are you using such common data formats?\n\nPlease make sure you list all the data types that are important for your distribution."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:26Z","entityUuid":"f1e49a7e-5671-4e4f-b4dc-703a197fcb4f","parentUuid":"4dba41ea-62eb-43d1-adcc-02f03fb2e35a","uuid":"eed17743-a81c-4172-bdb6-be3f47acf647"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"In this chapter, please focus on the data organization practices used in your project(s). This includes how data is structured and managed—for example, folder hierarchies, file naming conventions, versioning strategies, use of metadata, or any documentation practices that support data consistency and accessibility."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:27Z","entityUuid":"30fda3ae-3b4d-486c-b626-fb585fa92571","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"730ca73d-ea20-4415-8c9c-ec776d39c98e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["ef41eae9-d3a9-4e6b-b922-ec6652787ad2","7f5a30bf-c6d5-49a6-9dc2-fba2094eb541","26532378-cfa7-49d7-a179-e437b6768c92","2e070ab7-1ee4-49dc-88ab-58957aec186c","fa0383eb-17cb-4dcd-aba1-8a53321c51f4"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please document each **distinct collection of data organisation practices** as a **separate entry**.\n\nFor each entry, begin by specifying whether the described organisation practices applies to **all datasets** or only to **specific datasets**. If it applies only to selected datasets, you will have the opportunity to identify exactly which datasets undertook this collection of organisation practices.\n\nIf your project(s) involves only **one collection of organisation practices**, complete a **single entry** that thoroughly describes that process.\n\nPlease pay **close attention** to ensure that **all datasets** associated with your project are fully accounted for and appropriately linked to their respective organisation practices. This is essential for maintaining transparency and completeness."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:28Z","entityUuid":"d6a2ece7-c068-48b4-bfaa-b032f432afd8","parentUuid":"30fda3ae-3b4d-486c-b626-fb585fa92571","uuid":"fb44ecd7-bb3c-4d83-9c27-f52702e1c875"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-04-09T13:01:29Z","entityUuid":"f3d8864f-04b5-4d40-8389-f2bbdcde8fb8","parentUuid":"30fda3ae-3b4d-486c-b626-fb585fa92571","uuid":"d6982bbf-7aa4-40f8-9282-e9d8d3dc3d4f"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-04-09T13:01:30Z","entityUuid":"f3d8864f-04b5-4d40-8389-f2bbdcde8fb8","parentUuid":"30fda3ae-3b4d-486c-b626-fb585fa92571","uuid":"f92526ea-f077-4026-ba04-936a19284d88"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Carefully considering file naming conventions in advance can prevent confusion and significantly reduce issues later in the project."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:31Z","entityUuid":"26532378-cfa7-49d7-a179-e437b6768c92","parentUuid":"d6a2ece7-c068-48b4-bfaa-b032f432afd8","uuid":"dac65657-209e-409b-8548-4eadf3a95011"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Recommendation: Use consistent identifiers for sample IDs and similar elements across the entire project to ensure clarity and traceability."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:32Z","entityUuid":"1f9d37c3-be62-4f4d-86c4-3d4e24944548","parentUuid":"ae45e778-5059-4beb-90ff-b6ebdc30cb7f","uuid":"d00e0d5e-999c-493f-b18d-57c84ce9d6fb"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"While file names can serve as helpful metadata for project team members, they are treated merely as identifiers by computers. To avoid issues—such as broken links caused by renamed files—metadata should always be stored in a dedicated, structured format (e.g., metadata files or databases), not solely within the file names.\n\nAdditionally, if any metadata is likely to change during the project, embedding it in file names can lead to the need for renaming files, which may disrupt references and workflows that depend on stable file names."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:33Z","entityUuid":"7d69adcf-1837-4b51-9eae-30c3c49f283e","parentUuid":"ae45e778-5059-4beb-90ff-b6ebdc30cb7f","uuid":"e5d9ee46-b810-47f4-8d81-312017494796"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"In large projects, using a persistent identifier system to reference data internally can be highly beneficial. Such a system helps maintain reliable data tracking, even when files are moved or reorganized, by decoupling data references from physical storage locations."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:34Z","entityUuid":"53251566-5795-4d6f-83cd-9d0d52f4127d","parentUuid":"ae45e778-5059-4beb-90ff-b6ebdc30cb7f","uuid":"ab704d97-05af-4efe-a182-39d322e52db8"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"This chapter focuses on the strategies and practices for ensuring the preservation of data both during the project and after its completion."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:35Z","entityUuid":"c86ec70c-e5ef-4b0c-b969-772c658ffdb9","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"6e46e161-feb9-47c2-a5cf-8530e989c9d0"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please document each **distinct data preservation specification** as a **separate entry**.\n\nFor each entry, begin by specifying whether the described data preservation specification applies to **all datasets** or only to **specific datasets**. If it applies only to selected datasets, you will have the opportunity to identify exactly which datasets were produced using this method.\n\nIf your project(s) involves only **one data preservation specification**, complete a **single entry** that thoroughly describes that process.\n\nPlease pay **close attention** to ensure that **all datasets** associated with your project are fully accounted for and appropriately linked to their respective data preservation strategy. This is essential for maintaining transparency and completeness."},"title":{"changed":true,"value":"Data Preservation Specification"}},"createdAt":"2025-04-09T13:01:36Z","entityUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47","parentUuid":"c86ec70c-e5ef-4b0c-b969-772c658ffdb9","uuid":"12ed53d2-812f-462e-b057-a1ff78688b34"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-04-09T13:01:37Z","entityUuid":"32d3b634-9403-42ab-8db4-e231ddd7e48a","parentUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47","uuid":"a019bff2-d2e6-44b9-86a2-83fd980f3e5a"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["32d3b634-9403-42ab-8db4-e231ddd7e48a","a2353a20-be1f-451a-8caf-4e51670432ba","aa34ed64-10ba-488b-b215-5bc50f75b286","44e5313a-f6e0-4a2d-890b-89f9348a5254","a08ffdfd-f568-4847-9ac0-073a8dfa6793"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:38Z","entityUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47","parentUuid":"c86ec70c-e5ef-4b0c-b969-772c658ffdb9","uuid":"0b068aff-e27e-4f11-8b9d-c0f10f011126"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Label for this Data Preservation Specifications"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:39Z","entityUuid":"32d3b634-9403-42ab-8db4-e231ddd7e48a","parentUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47","uuid":"e608a8ec-5da5-485b-9254-4421f84af4f8"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Data Preservation Specifications"}},"createdAt":"2025-04-09T13:01:40Z","entityUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47","parentUuid":"c86ec70c-e5ef-4b0c-b969-772c658ffdb9","uuid":"323a60a3-6257-4cf9-8ba0-e02ebb6af75a"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Keep in mind the importance of metadata retention and appropriate data formats. Ensure that metadata is stored alongside the data in the archive, and that community-supported, open, and widely accepted data formats are used to support long-term preservation and accessibility."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:41Z","entityUuid":"1c6d2903-9890-49bc-abc0-df26b8545dce","parentUuid":"86602970-af92-4134-876c-7d395913977c","uuid":"02e84889-e411-414b-96de-db8343e6a594"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please document each **distinct data preservation strategy** as a **separate entry**.\n\nFor each entry, begin by specifying whether the described data preservation strategy applies to **all datasets** or only to **specific datasets**. If it applies only to selected datasets, you will have the opportunity to identify exactly which datasets.\n\nIf your project(s) involves only **one data preservation strategy**, complete a **single entry** that thoroughly describes that preservation strategy.\n\nPlease pay **close attention** to ensure that **all datasets** associated with your project are fully accounted for and appropriately linked to their respective data preservation strategy. This is essential for maintaining transparency and completeness."},"title":{"changed":true,"value":"Data Preservation Strategy"}},"createdAt":"2025-04-09T13:01:42Z","entityUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47","parentUuid":"c86ec70c-e5ef-4b0c-b969-772c658ffdb9","uuid":"fecc3bfb-47ab-4358-9fd6-bb97212dc1a5"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please provide a label for this data preservation strategy. This label is only used to help distinguish this entry within the questionnaire."},"title":{"changed":true,"value":"Label for this data preservation strategy"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:43Z","entityUuid":"32d3b634-9403-42ab-8db4-e231ddd7e48a","parentUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47","uuid":"f39cf826-a171-4b7c-a086-3cb842ade3cb"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Is the data preservation strategy applied uniformly across the entire project, e.g. to all produced datasets?"}},"createdAt":"2025-04-09T13:01:44Z","entityUuid":"a2353a20-be1f-451a-8caf-4e51670432ba","parentUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47","uuid":"74238649-2812-4057-92f0-a0a0d8e2c250"},{"content":{"advice":{"changed":true,"value":"To accurately describe the **data preservation strategies for each dataset** (or group of datasets that share the same data preservation specifications), please create a **separate entry for each distinct data preservation strategy**.\n"},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No, different data preservation specifications are used for different produced datasets"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T13:01:45Z","entityUuid":"52315c7a-4d5d-401b-8109-b9ca4e1cd448","parentUuid":"a2353a20-be1f-451a-8caf-4e51670432ba","uuid":"670b892f-893b-47b0-9357-476dbb30adb5"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Your project involves **multiple data preservation strategies**, each described in separate entries, please **list here all relevant datasets associated with this specific data preservation strategy**."},"title":{"changed":true,"value":"Please specify which datasets follow the strategy described here"}},"createdAt":"2025-04-09T13:01:46Z","entityUuid":"fc3fe73e-e723-4fcf-a897-aa30863582b3","parentUuid":"52315c7a-4d5d-401b-8109-b9ca4e1cd448","uuid":"6d563dbe-691d-4563-80dc-23f6752d859e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"listQuestionUuid":{"changed":false},"questionType":"ItemSelectQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Dataset following this data preservation strategy"}},"createdAt":"2025-04-09T13:01:47Z","entityUuid":"d60cc6f1-8fe7-4f71-8f85-6c4023972ebc","parentUuid":"fc3fe73e-e723-4fcf-a897-aa30863582b3","uuid":"9dfb1094-1f84-43a8-b86c-f75581641fde"},{"content":{"advice":{"changed":true,"value":"To accurately describe the **data preservation strategies for all datasets** across the project, please create **only one entry** to describe the data preservation strategy."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, the data preservation strategy is applied consistently across all produced datasets"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T13:01:48Z","entityUuid":"fa7c875f-f908-4de3-871e-863f489243c4","parentUuid":"a2353a20-be1f-451a-8caf-4e51670432ba","uuid":"1b27b9c9-a95a-46f8-a068-1233e4920a31"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please document each **distinct data collection process** as a **separate entry**.\n\nFor each entry, begin by specifying whether the described data collection process applies to **all datasets** or only to **specific datasets**. If it applies only to selected datasets, you will have the opportunity to identify exactly which datasets were produced using this process.\n\nIf your project(s) involves only **one data collection process**, complete a **single entry** that thoroughly describes that process.\n\nPlease pay **close attention** to ensure that **all datasets** associated with your project are fully accounted for and appropriately linked to their respective data collection processes. This is essential for maintaining transparency and completeness."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:49Z","entityUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","parentUuid":"30dd2bb9-9c2d-4ccf-b24a-428aea429b7a","uuid":"1fff220f-693c-44f8-b7c1-8b4aadd9499b"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please provide a label for this data collection process. This label is used solely to distinguish this entry within the questionnaire."},"title":{"changed":true,"value":"Label for this data collection process"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:50Z","entityUuid":"d2098bc8-d3d4-45bc-b5f2-b395e12c5103","parentUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","uuid":"576bfb51-1f85-4ae9-9eb8-72c3747d6a98"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please document each **distinct data collection strategy** as a **separate entry**.\n\nFor each entry, begin by specifying whether the described organisation practices applies to **all datasets** or only to **specific datasets**. If it applies only to selected datasets, you will have the opportunity to identify exactly which datasets undertook this organisation strategy.\n\nIf your project(s) involves only **one data organisation strategy**, complete a **single entry** that thoroughly describes that strategy.\n\nPlease pay **close attention** to ensure that **all datasets** associated with your project are fully accounted for and appropriately linked to their respective organisation strategy. This is essential for maintaining transparency and completeness."},"title":{"changed":true,"value":"Data Organisation Strategy"}},"createdAt":"2025-04-09T13:01:51Z","entityUuid":"d6a2ece7-c068-48b4-bfaa-b032f432afd8","parentUuid":"30fda3ae-3b4d-486c-b626-fb585fa92571","uuid":"0403fcbc-d3e2-42af-b8ae-68ba3792650c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please provide a label for this data organisation strategy. This label is only used to help distinguish this entry within the questionnaire."},"title":{"changed":true,"value":"Label for this data organisation strategy"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:01:52Z","entityUuid":"ef41eae9-d3a9-4e6b-b922-ec6652787ad2","parentUuid":"d6a2ece7-c068-48b4-bfaa-b032f432afd8","uuid":"4caea08f-5bbe-4b05-8d8c-f5944e93ffe6"},{"content":{"advice":{"changed":true,"value":"To accurately describe the **data organisation strategy for each dataset** (or group of datasets that share the same organisation practices), please create a **separate entry for each strategy**."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No, different data organisation practices are used for different produced datasets"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T13:01:53Z","entityUuid":"5838dbce-80bd-44d5-b717-34e83de1e92e","parentUuid":"7f5a30bf-c6d5-49a6-9dc2-fba2094eb541","uuid":"ab1f7708-f704-48b2-b5e2-c7cf0dafd059"},{"content":{"advice":{"changed":true,"value":"To accurately describe the **data organisation strategy for all datasets** across the project, please create **only one entry** to describe the organisation strategy."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes, the data organisation practices are applied consistently across all produced datasets"},"metricMeasures":{"changed":false}},"createdAt":"2025-04-09T13:01:54Z","entityUuid":"06cedb3a-3d3a-4085-9dfe-eb1621cf1558","parentUuid":"7f5a30bf-c6d5-49a6-9dc2-fba2094eb541","uuid":"7bf05a0b-ab3c-4e01-8667-c412d53480e0"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"This chapter details the conditions and restrictions for data usage and reuse."},"title":{"changed":false}},"createdAt":"2025-04-09T13:01:55Z","entityUuid":"8e2dd2aa-8488-4433-afef-d7decd11c1b5","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"06f5b086-e86a-44c0-b23a-8242b64bc5f2"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"ch