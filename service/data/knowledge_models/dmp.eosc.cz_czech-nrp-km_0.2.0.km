ed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2023-08-01T14:29:50Z","entityUuid":"5563c4d5-23cb-4c5f-9e0c-2655745fb5bb","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"f793eb93-d675-4790-8a62-2819368752ad"}],"forkOfPackageId":null,"id":"dmp.eosc.cz:czech-nrp-km:0.1.0","kmId":"czech-nrp-km","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Czech National Repository Platform KM","nonEditable":false,"organizationId":"dmp.eosc.cz","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":null,"readme":"# Czech National Repository Platform KM\n\n*DSW Knowledge Model tailored to needs and specifics of Czech National Repository Platform for Research Data*\n\n## Maintainers\n\nResponsible for the overall management and development of the knowledge model, ensuring its continuous improvement, and overseeing contributions to maintain its integrity and relevance.\n\n* **Jana Martínková** \n  * [jana.martinkova@cvut.cz](mailto:jana.martinkova@cvut.cz)\n  * ORCID: [0000-0001-8575-6533](https://orcid.org/0000-0001-8575-6533)\n  * *Czech Technical University in Prague*\n* **Kryštof Komanec** \n  * [krystof.komanec@fit.cvut.cz](mailto:krystof.komanec@fit.cvut.cz)\n  * ORCID: [0000-0003-3856-1682](https://orcid.org/0000-0003-3856-1682) \n  * *Czech Technical University in Prague*\n\n## Contributors\n\nContribute to the knowledge model by adding new information, refining existing content, or providing insights to improve its quality and applicability.\n\n* **Marek Suchánek**, ORCID: [0000-0001-7525-9218](https://orcid.org/0000-0001-7525-9218), *Czech Technical University in Prague*\n* **Georgia Koutentaki**, ORCID: [0000-0002-8099-9963](https://orcid.org/0000-0002-8099-9963), *Czech Technical University in Prague*\n\n## Acknowledgements\n\n| ![](https://dmp.eosc.cz/static/eu-msmt.svg) | This work is supported by the project National Repository Platform for Research Data no. [CZ.02.01.01/00/23_014/0008787](https://www.eosc.cz/en/projects/national-repository-platform-for-research-data-os-i-nrp/national-repository-platform). |\n|-------------------------------------|---|\n\n## Changelog\n\n### 0.1.0\n\n*Released*: 2025-08-01\n\n* Initial version for testing and further development","version":"0.1.0"},{"createdAt":"2025-03-05T07:30:51.828507Z","description":"DMP tailored to Czech National Repository Platform for Research Data ","events":[{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-01-13T08:04:24Z","entityUuid":"051456b4-3569-4ff1-9d90-62fbe7fcfd61","parentUuid":"d079929c-4f64-4cb6-818b-39ccdefcbc07","uuid":"cf55753f-de25-400d-b5bd-bd0df00f437a"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Have you already chosen a license for your dataset?"}},"createdAt":"2025-01-13T08:04:25Z","entityUuid":"051456b4-3569-4ff1-9d90-62fbe7fcfd61","parentUuid":"d079929c-4f64-4cb6-818b-39ccdefcbc07","uuid":"34e17e20-c393-41ff-ba44-5b7fb59da948"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-01-13T08:04:26Z","entityUuid":"c0357e85-0ef2-4a4f-98d8-d838ca4cad02","parentUuid":"051456b4-3569-4ff1-9d90-62fbe7fcfd61","uuid":"f8cad7a5-3135-4f9b-b486-b9036029d27d"},{"content":{"advice":{"changed":false},"annotatio