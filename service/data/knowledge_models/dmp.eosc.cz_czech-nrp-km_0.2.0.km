s":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-05-27T05:59:49Z","entityUuid":"7bfe0c78-a9fa-4af8-92e5-c80505704c3f","parentUuid":"f2b5ebb5-e672-4505-9c6c-421bab9e3be5","uuid":"8329301d-82ee-42f6-a007-4789661326fd"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What potential risks do you expect?"}},"createdAt":"2025-05-27T05:59:50Z","entityUuid":"85cd1720-48bc-4cd4-ba23-1a5713efd4df","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"c440bf28-a806-4f4c-b380-bfc3581600a3"},{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"isMitigationPlanned"}]},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-05-27T05:59:51Z","entityUuid":"73810c2e-d154-4054-96bb-b35517c99747","parentUuid":"85cd1720-48bc-4cd4-ba23-1a5713efd4df","uuid":"33cc20f5-f57e-4f63-8172-ccfa7ddc0b2f"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-05-27T05:59:52Z","entityUuid":"e7a6e949-d8e3-454b-80f9-1e3a9d1ad04d","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"65d03621-084e-430d-aca0-8b7abfb82f46"},{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"areCommunicationChannelsSet"}]},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Clear and consistent communication is essential for successful project coordination. Establishing communication channels early on enables contributors—regardless of their roles—to efficiently share updates, ask questions, and collaborate effectively. Well-defined communication structures help maintain project momentum, ensure alignment with project goals, and support timely decision-making.\n\nIn projects that involve handling personal data or non-anonymous survey responses, additional care should be taken to ensure compliance with data protection requirements. This includes keeping relevant parties—such as data managers, researchers, and privacy officers—informed of protocols and responsibilities. Where appropriate, implementing Non-Disclosure Agreements (NDAs) or other confidentiality measures can help safeguard sensitive information and maintain trust among stakeholders."},"title":{"changed":true,"value":"Have any communication channels been established between the contributors?"}},"createdAt":"2025-05-27T05:59:53Z","entityUuid":"e7a6e949-d8e3-454b-80f9-1e3a9d1ad04d","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"830371c6-6783-458b-ad37-10afc9ca9dce"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T05:59:54Z","entityUuid":"2fb0b662-8fdd-45af-88b9-2167be5c31d5","parentUuid":"e7a6e949-d8e3-454b-80f9-1e3a9d1ad04d","uuid":"1d2aa5d4-d033-49cb-9880-9eebaf8bccb6"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"creat