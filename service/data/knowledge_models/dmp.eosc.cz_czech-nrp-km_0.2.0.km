d":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":true,"value":{"request":{"body":null,"headers":[{"key":"Accept","value":"application/json"}],"method":"GET","url":"https://api.crossref.org/funders?query=Czech%20Technical"},"response":{"body":"{\"status\":\"ok\",\"message-type\":\"funder-list\",\"message-version\":\"1.0.0\",\"message\":{\"items-per-page\":20,\"query\":{\"start-index\":0,\"search-terms\":\"Czech Technical\"},\"total-results\":2,\"items\":[{\"id\":\"100007655\",\"location\":\"Czechia\",\"name\":\"\\u010cesk\\u00e9 Vysok\\u00e9 U\\u010den\\u00ed Technick\\u00e9 v Praze\",\"alt-names\":[\"Czech Technical University in Prague\",\"\\u010cVUT\"],\"uri\":\"https:\\/\\/doi.org\\/10.13039\\/100007655\",\"replaces\":[],\"replaced-by\":[],\"tokens\":[\"\\u010desk\\u00e9\",\"vysok\\u00e9\",\"u\\u010den\\u00ed\",\"technick\\u00e9\",\"v\",\"praze\",\"czech\",\"technical\",\"university\",\"in\",\"prague\",\"\\u010dvut\"]},{\"id\":\"100018240\",\"location\":\"Czechia\",\"name\":\"Research Center for Informatics, Czech Technical University in Prague\",\"alt-names\":[\"Research Center for Informatics\",\"RCI\"],\"uri\":\"https:\\/\\/doi.org\\/10.13039\\/100018240\",\"replaces\":[],\"replaced-by\":[],\"tokens\":[\"research\",\"center\",\"for\",\"informatics\",\"czech\",\"technical\",\"university\",\"in\",\"prague\",\"research\",\"center\",\"for\",\"informatics\",\"rci\"]}]}}","contentType":"application/json","responseType":"SuccessTypeHintResponse","status":200}}},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-07-24T09:41:13Z","entityUuid":"96f8c472-80a3-4841-b328-bf2340bb254a","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"1662d526-ca4f-4184-a0ec-e68df9744f69"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":true,"value":"[**{{item.name}}**]({{ item.uri }}) ({{item.location}})"},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-07-24T09:41:14Z","entityUuid":"96f8c472-80a3-4841-b328-bf2340bb254a","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"66c4c3b6-0cff-4130-a560-9d71c65fe6ec"}],"forkOfPackageId":null,"id":"dmp.eosc.cz:czech-nrp-km:0.1.6","kmId":"czech-nrp-km","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Data Management Planning KM","nonEditable":false,"organizationId":"dmp.eosc.cz","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dmp.eosc.cz:czech-nrp-km:0.1.5","readme":"# Data Management Planning KM\n\n*DSW Knowledge Model for Data Management Planning, tailored to the needs and specifics of the Czech National Repository Platform for Research Data.*\n\n## Maintainers\n\nResponsible for the overall management and development of the knowledge model, ensuring its continuous improvement, and overseeing contributions to maintain its integrity and relevance.\n\n* **Jana Martínková** \n  * [jana.martinkova@cvut.cz](mailto:jana.martinkova@cvut.cz)\n  * ORCID: [0000-0001-8575-6533](https://orcid.org/0000-0001-8575-6533)\n  * *Czech Technical University in Prague*\n* **Kryštof Komanec** \n  * [krystof.komanec@fit.cvut.cz](mailto:krystof.komanec@fit.cvut.cz)\n  * ORCID: [0000-0003-3856-1682](https://orcid.org/0000-0003-3856-1682) \n  * *Czech Technical University in Prague*\n\n## Contributors\n\nContribute to the knowledge model by adding new information, refining existing content, or providing insights to improve its quality and applicability.\n\n* **Marek Suchánek**, ORCID: [0000-0001-7525-9218](https://orcid.org/0000-0001-7525-9218), *Czech Technical University in Prague*\n* **Georgia Koutentaki**, ORCID: [0000-0002-8099-9963](https://orcid.org/0000-0002-8099-9963), *Czech Technical University in Prague*\n* **Michal Růžička**, ORCID: [0000-0001-5547-8720](https://orcid.org/0000-0001-5547-8720), *Masaryk University*,  (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Barbora Loskotová**, *Tomas Bata University in Zlín*, (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Antonín Zita**, ORCID: [0009-0002-1049-107X](\nhttps://orcid.org/0009-0002-1049-107X\n), *Masaryk University*, (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Marika Hrubá**, *Masaryk University*, (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Tereza Kolmačková**, *Library of the Czech Academy of Sciences*\n* **Jindřich Fejfar**, *Library of the Czech Academy of Sciences*\n* **Lucie Hošková**, ORCID: [0009-0001-9695-2342](https://orcid.org/0009-0001-9695-2342), *Charles University*\n* **Matěj Uchytil**, *Charles University*\n* **Anna Horecká**, *Charles University*\n\n## Acknowledgements\n\n| ![](https://dmp.eosc.cz/static/eu-msmt.svg) | This work is supported by the project National Repository Platform for Research Data no. [CZ.02.01.01/00/23_014/0008787](https://www.eosc.cz/en/projects/national-repository-platform-for-research-data-os-i-nrp/national-repository-platform). |\n|-------------------------------------|---|\n\n## Changelog\n\n### 0.1.6\n\n*Released*: 2025-16-10\n\n* Add annotations for document templates\n* Add tag \"maDMP\" to questions\n* General updates based on feedback from KA7 NRP project\n* Add resource links to Data Management Expert Guide\n\n### 0.1.5\n\n*Released*: 2025-24-07\n\n* Add annotations for document templates\n* Add tag \"Horizon Europe template\" to questions\n* General updates based on feedback from KA7 NRP project\n\n### 0.1.4\n\n*Released*: 2025-21-05\n\n* Refine the \"Producing Data\" chapter\n* Add phases to questions\n* General updates based on feedback from KA7 NRP project\n\n### 0.1.3\n\n*Released*: 2025-08-04\n\n* Integrate License Selector tool\n\n### 0.1.2\n\n*Released*: 2025-25-03\n\n* Refine the wording and order of the questions\n* Add a question for uploading the Data Sharing Agreement and Preservation Statement documents\n* Add URL question for measuring instrument, Data Sharing Agreement and Preservation Statement\n\n### 0.1.1\n\n*Released*: 2025-05-03\n\n* Add structure and preparation for License Selector\n* Add standard protocol and SW documentation\n* Add ORCID validation\n* Add \"Creator of DMP\" to roles\n* Improve integrations (link in response)\n\n### 0.1.0\n\n*Released*: 2025-08-01\n\n* Initial version for testing and further development","version":"0.1.6"},{"createdAt":"2025-11-11T10:19:06.403242Z","description":"DMP tailored to Czech National Repository Platform for Research Data ","events":[{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[{"key":"json.value","value":"soon_one"}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-10-24T12:57:05Z","entityUuid":"227eb2d9-d733-416c-bcba-c9111fe0f0ee","parentUuid":"152028b9-16fa-404f-8a1f-f45cd46871f2","uuid":"4bf68e3b-f4fa-4074-9f5c-71888102c451"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-10-24T12:57:06Z","entityUuid":"86e7e0ae-1f71-43c6-b02c-ec3df5b0b4ad","parentUuid":"91cc447f-10f2-45a2-b873-076cf8139355","uuid":"2e6480e8-7a4b-41da-bb18-