-08-01T13:52:47Z","entityUuid":"124e8a0d-9b13-4893-af48-abf24cdaa930","parentUuid":"fbb17122-3bc9-4780-9f8a-bbb0986e4b17","uuid":"ecdd2cdb-12ef-4830-bafc-7078e5dca419"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:52:48Z","entityUuid":"acb838d3-6abe-4c8d-aeaa-860a9152bf21","parentUuid":"124e8a0d-9b13-4893-af48-abf24cdaa930","uuid":"e017da81-c1cb-4ed1-a15a-a21e8ce41a8d"},{"content":{"advice":{"changed":true,"value":"Make sure to make the notes available in electronic form along with your data."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We use lab notebooks"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:52:49Z","entityUuid":"acb838d3-6abe-4c8d-aeaa-860a9152bf21","parentUuid":"124e8a0d-9b13-4893-af48-abf24cdaa930","uuid":"13f6a94c-c23b-400a-8869-d148b3f83c99"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:52:50Z","entityUuid":"0aa422e5-e53b-414e-a86c-5d083327c262","parentUuid":"124e8a0d-9b13-4893-af48-abf24cdaa930","uuid":"3a80ce5f-d8fe-45da-97af-f4ee7084d751"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We use an electronic lab notebook"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:52:51Z","entityUuid":"0aa422e5-e53b-414e-a86c-5d083327c262","parentUuid":"124e8a0d-9b13-4893-af48-abf24cdaa930","uuid":"5d4f64ba-a063-4593-a174-8c67b2bc3cb3"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:52:52Z","entityUuid":"bf5926ad-96dc-4f3e-b42b-9d74c31e0732","parentUuid":"124e8a0d-9b13-4893-af48-abf24cdaa930","uuid":"663c74e4-18a9-4373-88e3-ff6458b66c61"},{"content":{"advice":{"changed":fa