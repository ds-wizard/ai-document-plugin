nged":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Data concerning vulnerable data subjects including minors, employees, elderly, mentally incapacitated, patients receiving care. "}},"createdAt":"2023-08-01T13:36:56Z","entityUuid":"212b8959-6c6d-49b6-b4d0-f6764331b950","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"74c78191-ba9e-4b6e-91b5-6a752b12f3d6"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:36:57Z","entityUuid":"efb99e64-c227-4522-b5e5-e3e55fb1809a","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"cd7dd160-28a3-4432-a4e4-97516f5a41c7"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Sensitive data or data of a highly personal nature: which includes racial or ethnic origin; political opinions; religious or philosophical beliefs; trade union membership; genetic data; data concerning health; biometric data; sexual orientation. "}},"createdAt":"2023-08-01T13:36:58Z","entityUuid":"efb99e64-c227-4522-b5e5-e3e55fb1809a","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"795253bf-637d-412c-92a6-2271f110e16a"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:36:59Z","entityUuid":"348a93f7-77a2-4c04-ba9a-72a98ab5919a","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"9c9a41c4-c0f0-4a2e-bce3-d2dba1ec6f80"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Data processed on a large scale: data of proportion of the relevant population, long term processing, wide geographical scale, large volume or range of data ."}},"createdAt":"2023-08-01T13:37:00Z","entityUuid":"348a93f7-77a2-4c04-ba9a-72a98ab5919a","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"88861a2a-5444-437b-9d60-d3636bfcecc1"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:37:01Z","entityUuid":"bf1856ac-e8de-4fdf-bb3e-456204b35d7a","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"377911eb-ac71-4ee5-8bab-15b1dabd88c7"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Automated-decision making with legal or similar significant effect on data subjects."}},"createdAt":"2023-08-01T13:37:02Z","entityUuid":"bf1856ac-e8de-4fdf-bb3e-456204b35d7a","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"8bf5f212-a3c9-4561-89ac-d7a7c6171e2b"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:37:03Z","entityUuid":"07ce127a-63be-41e2-9c1c-aa38f2fa2776","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"62bd4960-d718-4bef-be8a-18fbd20324cb"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Evaluation or scoring on aspects concerning the data subject's performance at work, economic situation, health, personal preferences or interests, reliability or behavior, location or movements."}},"createdAt":"2023-08-01T13:37:04Z","entityUuid":"07ce127a-63be-41e2-9c1c-aa38f2fa2776","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"980d0093-2e95-45df-84a0-e6ea736a3162"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:37:05Z","entityUuid":"14f5c11b-3425-4531-a149-c86c78cbfc67","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"fe7fe492-a6ca-44ee-9101-e3f7bade88dd"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Systematic monitoring, processing used to observe, monitor or control data subjects, including data collected through networks."}},"createdAt":"2023-08-01T13:37:06Z","entityUuid":"14f5c11b-3425-4531-a149-c86c78cbfc67","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"44cf9330-b98f-419d-8987-f80176cdd20a"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:37:07Z","entityUuid":"c36af02b-1a24-44b2-9960-cca92b9652c6","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"3030bc04-bb68-4174-ac03-97f4ae19f089"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Matching or combining datasets, for example originating from two or more data processing operations performed for different purposes."}},"createdAt":"2023-08-01T13:37:08Z","entityUuid":"c36af02b-1a24-44b2-9960-cca92b9652c6","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"fee3481f-1a7d-4049-bd63-d6233d84de1b"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:37:09Z","entityUuid":"a0463306-69f0-4961-9542-16f8ff9f15b8","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"153e88e0-5616-4c6e-a320-127652b4fa76"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Innovative use or applying new technological or organizational solutions, like combining the use of fingerprint and face recognition for physical access control.  "}},"createdAt":"2023-08-01T13:37:10Z","entityUuid":"a0463306-69f0-4961-9542-16f8ff9f15b8","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"7056c61a-ca9b-4fcc-b530-854cd084912c"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:37:11Z","entityUuid":"e14ad037-fb9a-45fa-af60-a4fe128d5fdb","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"10730440-b60c-4e7c-a7f6-3e51a2db0573"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Processing that prevents data subjects from exercising a right or using a service or a contract."}},"createdAt":"2023-08-01T13:37:12Z","entityUuid":"e14ad037-fb9a-45fa-af60-a4fe128d5fdb","parentUuid":"83a96fdb-ffd3-4a87-bc7b-b3616bdef276","uuid":"767d8462-c1b4-4df1-a38b-1a0771d4a1b5"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T13:37:13Z","entityUuid":"0a8c50a4-d431-4012-92a5-94d8c5d0ae78","parentUuid":"8b169987-5891-4eb7-b45e-f365825b783b","uuid":"88d387e3-daca-400a-b9f8-590a7ab65f54"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on GDPR Compliance"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/gdpr_compliance"}},"createdAt":"2023-08-01T13:37:14Z","entityUuid":"0a8c50a4-d431-4012-92a5-94d8c5d0ae78","parentUuid":"8b169987-5891-4eb7-b45e-f365825b783b","uuid":"bb6a5da1-861a-4628-ad90-7788aa346dbb"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:37:15Z","entityUuid":"2b842099-d4f6-4994-9a31-789d529ecf25","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"0fbbb8a9-6a56-4adf-9817-abaee14f0d5a"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"To ensure that the personal data that you process in the project is protected at an appropriate level, you should apply technical and procedural safeguards to ensure that the rights of the data subjects are not violated. Examples of such measures include, but are not limited to, pseudonymisation and encryption of data, the use of computing and storage environments with heightened security, and clear and documented procedures for project members to follow."},"title":{"changed":true,"value":"What technical and procedural safeguards have been established for processing the data?"}},"createdAt":"2023-08-01T13:37:16Z","entityUuid":"2b842099-d4f6-4994-9a31-789d529ecf25","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"2d8ca085-dcec-4cc9-b323-57c959bb7cb9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:37:17Z","entityUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","parentUuid":"2b842099-d4f6-4994-9a31-789d529ecf25","uuid":"7c5cc000-9abc-4b60-bb63-d90fc85a3e27"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Please specify"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:37:18Z","entityUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","parentUuid":"2b842099-d4f6-4994-9a31-789d529ecf25","uuid":"7f8cc7bd-e98b-4bb5-b43f-0cf8cd3c8442"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:37:19Z","entityUuid":"bcc72ed4-bc15-4f9b-83a4-f789af1cafba","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"891dd955-9b08-46c5-941d-00dc2763bc4b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Anonymisation refers to the processing of personal data in a manner that makes it impossible to identify individuals from them. For example, the data can be rendered down to a general level (aggregated) or converted into statistics so that individuals can no longer  be identified from them. \n\nPseudonymisation refers to the processing of personal data in such a manner that the personal data can no longer be attributed to a specific person without the use of additional information, i.e. any identifying characteristics are replaced with\na pseudonym."},"title":{"changed":true,"value":"Select level of identifiability for the  stored data"}},"createdAt":"2023-08-01T13:37:20Z","entityUuid":"bcc72ed4-bc15-4f9b-83a4-f789af1cafba","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"389bf814-d6ad-4ccd-a5aa-cff694969570"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:37:21Z","entityUuid":"a2576971-1147-41f5-b754-acb0196ecfa4","parentUuid":"bcc72ed4-bc15-4f9b-83a4-f789af1cafba","uuid":"586b345e-c705-46d2-9410-44f552499f72"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Irrevocably anonymised"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:37:22Z","entityUuid":"a2576971-1147-41f5-b754-acb0196ecfa4","parentUuid":"bcc72ed4-bc15-4f9b-83a4-f789af1cafba","uuid":"4c632cf6-2e7c-4ecb-9cc1-070c73043511"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:37:23Z","entityUuid":"6e711116-ef0f-48a3-9372-2b8216e8dbce","parentUuid":"bcc72ed4-bc15-4f9b-83a4-f789af1cafba","uuid":"df20db93-9c3a-4a98-8fb3-8a6ced11b8a5"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Pseudonymised"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:37:24Z","entityUuid":"6e711116-ef0f-48a3-9372-2b8216e8dbce","parentUuid":"bcc72ed4-bc15-4f9b-83a4-f789af1cafba","uuid":"b247976a-4926-4176-9a3f-0f37e0d5a14e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:37:25Z","entityUuid":"f6624003-3e6a-4223-b382-7b942ee58adc","parentUuid":"bcc72ed4-bc15-4f9b-83a4-f789af1cafba","uuid":"66cf8690-f359-4507-8315-740d5ae00a58"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Identifiable"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:37:26Z","entityUuid":"f6624003-3e6a-4223-b382-7b942ee58adc","parentUuid":"bcc72ed4-bc15-4f9b-83a4-f789af1cafba","uuid":"5c0ae25d-8902-4e03-95d7-9f97a52a5b24"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:37:27Z","entityUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"53910bee-2cdd-4f92-b865-a689cc7d0d6d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Elaborate on your other safeguards"}},"createdAt":"2023-08-01T13:37:28Z","entityUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"177a6be4-15a4-4183-a85e-ad4b8069359d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"List technical and procedural safeguards to ensure the privacy protection of the research subjects."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2023-08-01T13:37:29Z","entityUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"64bac7dc-e444-4aea-bd5a-fe403bdcf5dd"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:37:30Z","entityUuid":"a89abfd3-ff27-4347-8e85-21653e4cd75e","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"5a4193c7-d628-4ba8-a19f-fee50b6d40aa"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Where personal data are transferred to a third country or to an international organization, appropriate measures (technical and organizational) must be put in place to protect the data.\nIf sufficient protection levels are not offered by the countries, the addition of specific data protection clauses must be added to contracts.\n\nKeep in mind that a processor shall not transfer data outside the EU/EEA without the data controller’s approval and instructions, and that it should be subject to contractual agreements as imposed by the data controller."},"title":{"changed":true,"value":"Do you plan to transfer data outside the EU/EEA?"}},"createdAt":"2023-08-01T13:37:31Z","entityUuid":"a89abfd3-ff27-4347-8e85-21653e4cd75e","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"5dde9b44-d093-4a3a-b4b4-df68dd3bd852"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:37:32Z","entityUuid":"d948bee3-c181-4ec0-9edb-0200ed6f2c4f","parentUuid":"a89abfd3-ff27-4347-8e85-21653e4cd75e","uuid":"3cbccb43-a56a-47c4-bff0-cc68b3c39b85"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":f