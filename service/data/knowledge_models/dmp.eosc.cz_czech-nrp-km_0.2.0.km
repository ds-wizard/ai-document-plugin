Event","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"For projects involving confidential or sensitive information, such as personal data or non-anonymous surveys, it is essential to establish a clear and well-maintained data protection policy. This includes properly notifying all relevant parties or individuals whose data will be collected. Many projects also require Non-Disclosure Agreements (NDAs) or other confidentiality agreements to ensure the protection of sensitive information.\n\nIn such cases, you must appoint either an internal data protection officer or involve an external expert. Additionally, ensure that the data manager, researcher(s), and privacy officer (if applicable) are informed and involved in maintaining compliance."},"title":{"changed":true,"value":"How are the communication channels between different contributors set?"}},"createdAt":"2023-08-01T14:27:29Z","entityUuid":"bf4cb9e3-64ce-4b3a-97f8-cb80b8258081","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"e04438bf-3fab-4989-950c-e544a0302486"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2023-08-01T14:27:30Z","entityUuid":"bf4cb9e3-64ce-4b3a-97f8-cb80b8258081","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"6527e084-90c2-4f32-b3e1-b3ff1b91b8a7"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T14:27:31Z","entityUuid":"d87b0ee5-3f97-42ff-ba08-41ff