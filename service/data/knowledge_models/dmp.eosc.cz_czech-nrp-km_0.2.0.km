1T13:53:56Z","entityUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb","parentUuid":"4f76d114-2a43-4d6b-91ab-d96c4cfa5614","uuid":"cba00bde-bcee-484b-93a8-13d677129fda"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Identifier of the dataset"}},"createdAt":"2025-03-21T13:53:57Z","entityUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb","parentUuid":"4f76d114-2a43-4d6b-91ab-d96c4cfa5614","uuid":"8bbb1adc-8893-4d5b-80e8-e13a4e78b02d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["428a0c90-3aa8-408a-a663-712793e14d2d","cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb","040509af-4616-4683-9228-5b4c907ce4b2","4970dda2-e412-4778-81af-b49e7d95010b","e7f503a7-7f33-47dc-b1fb-fa1934e24bcd","af64cf22-5532-44a1-b660-d4cc62b9ed90","fe4e19b1-cc2e-4031-8a28-b49976ce0f78","622c9523-b96e-48cc-8693-7441003eacb8","7598e37b-def5-483e-be0f-c4b3d48f9103","52040739-6021-44a4-8bb9-815343afdc0a","37a38895-854e-4eea-a276-a2d3b0b9b24c"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-03-21T13:53:58Z","entityUuid":"4f76d114-2a43-4d6b-91ab-d96c4cfa5614","parentUuid":"a8f18085-458d-48d9-b704-e55438df3e2a","uuid":"14535b81-149a-4b60-bc6f-eaf8f42ee319"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please add all \"formal\" identifiers you have for this data set: these can be handles or DOIs or any other type. One important purpose of these identifiers is to be able to find the dataset back.\n\nA good identifier is _persistent_ (i.e. it does not change, and also the same identifier will never be used for another data set), _globally unique_ (nobody else uses the same identifier for a different data set) and _resolvable_ (you can actually locate the data set if you only know the identifier).\n\nPlease note that if you are publishing the dataset in a repository, the repository may assign a persistent identifier, or you may provide an existing one that has already been assigned. You will be able to specify such additional identifiers under the \"publication\" questions. Specify one main identifier here."},"title":{"changed":false}},"createdAt":"2025-03-21T13:53:59Z","entityUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb","parentUuid":"4f76d114-2a43-4d6b-91ab-d96c4cfa5614","uuid":"7bcf8cc2-c3ad-46c0-8b73-a2f7df9809b6"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb"},"createdAt":"2025-03-21T13:54:00Z","entityUuid":"040509af-4616-4683-9228-5b4c907ce4b2","parentUuid":"4f76d114-2a43-4d6b-91ab-d96c4cfa5614","uuid":"a0d29445-f8be-4cdd-af62-c0ce428ba27f"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"cbd4acb2-d2fa-44b3-b0c3-7e5d14a8a4fb"},"createdAt":"2025-03-21T13:54:01Z","entityUuid":"4970dda2-e412-4778-81af-b49e7d95010b","parentUuid":"4f76d114-2a43-4d6b-91ab-d96c4cfa5614","uuid":"b1554544-88e0-4623-a7fc-558b68dfc76d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Please specify the other dataset identifier type"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-03-21T13:54:02Z","entityUuid":"2656afd6-20ef-4857-8857-09a35d5fcf2d","parentUuid":"4aef3e58-fb9a-4de0-9fab-a3d319d3a93a