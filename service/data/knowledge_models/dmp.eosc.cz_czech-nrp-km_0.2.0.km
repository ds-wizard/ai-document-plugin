?"}},"createdAt":"2023-08-01T14:23:12Z","entityUuid":"dd86fbc9-b5f2-4af4-9b41-3671755af76c","parentUuid":"a776f152-25b6-44c8-a6cc-06046054f2a4","uuid":"7a25f777-2857-4331-a2ee-7f1174ac289f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Are you checking that the data entered (e.g., in forms) satisfies the criteria for reasonableness?"},"title":{"changed":false}},"createdAt":"2023-08-01T14:23:13Z","entityUuid":"80dfb87a-12b7-4e09-98cd-71ce4b441100","parentUuid":"a776f152-25b6-44c8-a6cc-06046054f2a4","uuid":"a8b4ccce-e17e-406b-8c7a-7be1d5fe1466"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Are you measuring samples with known outcomes to monitor consistency?"}},"createdAt":"2023-08-01T14:23:14Z","entityUuid":"639c722b-84ea-4780-81db-97b322372be1","parentUuid":"a776f152-25b6-44c8-a6cc-06046054f2a4","uuid":"c804edfc-9120-40a4-a00b-cfd5b937ce97"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T14:23:15Z","entityUuid":"190346e3-5782-4bef-aaca-88944b540eff","parentUuid":"e1783caa-dc4f-4c37-b3b9-c858095bda96","uuid":"b1de7ab7-740a-4091-86ad-41596d013543"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":null},"title":{"changed":true,"value":"How will you implement the cross-referencing between physical samples and their corresponding digital data?"}},"createdAt":"2023-08-01T14:23:16Z","entityUuid":"190346e3-5782-4bef-aaca-88944b540eff","parentUuid":"e1783caa-dc4f-4c37-b3b9-c858095bda96","uuid":"1f2f6836-02ff-465c-afe3-04724bf98f2c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2023-08-01T14:23:17Z","entityUuid":"190346e3-5782-4bef-aaca-88944b540eff","parentUuid":"e1783caa-dc4f-4c37-b3b9-c858095bda96","uuid":"25a30fa8-ffe4-4a65-8432-2cbc2ffc6e9e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Is the archived data changing over time, thus possibly needs re-archiving?"}},"createdAt":"2023-08-01T14:23:18Z","entityUuid":"81289ed8-acb9-4dcb-8f84-7a8bead491d0","parentUuid":"86602970-af92-4134-876c-7d395913977c","uuid":"feb2eea9-c529-4f82-868d-21e3ac00bd25"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"A preservation statement refers to a formal document or section that outlines the strategies, policies, and procedures for ensuring the long-term preservation of materials, data, or artifacts. It typically addresses how data or physical samples will be maintained over time, including how they will be stored, protected, and made accessible for future use."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:23:19Z","entityUuid":"a08ffdfd-f568-4847-9ac0-073a8dfa6793","parentUuid":"26b391f7-9d84-4ea4-b779-d282ef415c68","uuid":"a139e76f-da86-42cc-9a83-415d58601efe"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Each person or institution contributing to creating or executing the data management plan should be added as a contributor. A project probably should have a Contact Person, and a Data Curator."},"title":{"changed":true,"value":"Contributors"}},"createdAt":"2023-08-01T14:23:20Z","entityUuid":"11ee0c25-3017-4bd2-949d-c97439dffcb2","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"f103ac62-8a98-49ea-a041-816667e4b1e4"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"In applied research, calibration often refers to the adjustment of processes and instruments rather than traditional measurements. Please specify the type of calibration being conducted."},"title":{"changed":true,"value":"Are you calibrating measurements?"}},"createdAt":"2023-08-01T14:23:21Z","entityUuid":"8aa7e3a6-a74d-4323-8b15-f5b32b11508b","parentUuid":"a776f152-25b6-44c8-a6cc-06046054f2a4","uuid":"abeff0af-b132-4a19-9305-3dace3d68d89"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Repeat samples refer to the process of taking multiple samples from the same population or experimental setup to ensure the reliability and consistency of the data collected."},"title":{"changed":true,"value":"Are you conducting repeat samples or repeating measurements to monitor the consistency of your results?"}},"createdAt":"2023-08-01T14:23:22Z","entityUuid":"21752b69-cd1f-47c4-b3c6-3bc068658e2b","parentUuid":"a776f152-25b6-44c8-a6cc-06046054f2a4","uuid":"43141aa6-99ad-4f97-977a-58f570829fc8"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If applicable, please include the instrument vendor (or creator) and their geographical location."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:23:23Z","entityUuid":"d4c152eb-b6b0-4df2-8169-51f80ae5fdfd","parentUuid":"b445defa-9a25-44af-bf10-44a65623ee9b","uuid":"9e59f243-6b16-4cc3-89a5-fb65be92eba0"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Have you thought that once you are using the data/database, the author can release new versions (for any reason, such as a yearly update, error corrections, or adding new measures like a larger population)? How will these changes affect your project or analysis? If the version changes while you are working on your research project, you need to decide whether you will follow these changes. You can decide to stay with the version that you started with; this can have the disadvantage that you will not benefit from the newly added information or consistency. If you use the newer version, it is likely that you will have to do some analyses again, so you will need to make sure that you have enough resources available to do so. "},"title":{"changed":false}},"createdAt":"2023-08-01T14:23:24Z","entityUuid":"10009746-517f-4d74-828f-8b738876d20a","parentUuid":"e5a5738b-6134-4e48-9011-1f5d297982b1","uuid":"8d4269b5-0ba2-40e2-ab97-2bb491d9c292"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Until when is the distribution available?"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:23:25Z","entityUuid":"bcce8f71-7ffc-4e55-9779-ed7a3044ba8c","parentUuid":"bdd7a9c4-f025-449c-8527-3e611b6960f5","uuid":"246bb973-7b40-4a2d-aa2b-695ed4d3c3e9"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T14:23:26Z","entityUuid":"4f8a9683-b9f9-4af0-a8dd-c63b2c533e9b","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"5c755e86-92a7-49ba-8297-b15a41a5003d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Project Webpage"}},"createdAt":"2023-08-01T14:23:27Z","