changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If your project involves **multiple data (re)use restrictions specifications**, each described in separate entries, please **list all relevant datasets associated with this specific data (re)use restrictions**.\n\nIf there is **only one data (re)use restrictions** used for all produced datasets, please **leave this question empty**."},"title":{"changed":false}},"createdAt":"2025-04-09T12:59:10Z","entityUuid":"d9b50856-a853-47b0-81a7-a62c6f316acf","parentUuid":"59c95237-c27c-40a5-96c1-260fdece89b4","uuid":"707ab663-d8bd-4d3b-90d8-7e9a60b374f4"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47"},"createdAt":"2025-04-09T12:59:11Z","entityUuid":"aa34ed64-10ba-488b-b215-5bc50f75b286","parentUuid":"26b391f7-9d84-4ea4-b779-d282ef415c68","uuid":"5773f179-2225-437e-8724-32c45baa9fa6"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47"},"createdAt":"2025-04-09T12:59:12Z","entityUuid":"44e5313a-f6e0-4a2d-890b-89f9348a5254","parentUuid":"26b391f7-9d84-4ea4-b779-d282ef415c68","uuid":"1b693f8a-b6bb-45de-a13f-e0b2109fc218"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"ddd721da-cad4-48fa-9794-3bd876b0ef47"},"createdAt":"2025-04-09T12:59:13Z","entityUuid":"a08ffdfd-f568-4847-9ac0-073a8dfa6793","parentUuid":"26b391f7-9d84-4ea4-b779-d282ef415c68","uuid":"7a647168-861e-4ea0-b6ae-7ae301140a86"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-04-09T12:59:14Z","entityUuid":"0aabf887-2848-4908-8911-3cdec1ee9f85","parentUuid":"d1332925-ff50-45cc-bae3-4839019be645","uuid":"c0c4e4a6-3151-49c5-b764-2bb44b377594"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"a7a67bd9-7912-4321-880e-7cf0355ce301"},"createdAt":"2025-04-09T12:59:15Z","entityUuid":"c9b17b43-8fe6-4655-98cf-4d9fc941dfc4","parentUuid":"d1332925-ff50-45cc-bae3-4839019be645","uuid":"7bc43b90-4831-4c26-bdd1-c9884c69bebd"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"To list all security and privacy measures applied to a dataset to protect sensitive information, for example encryption, anonymization, data masking, and compliance with data protection regulations (e.g. GDPR or HIPAA). It can also be used to express any security measures required for handling the dataset, e.g. only physical access, etc. "},"title":{"changed":false}},"createdAt":"2025-04-09T12:59:16Z","entityUuid":"c9b17b43-8fe6-4655-98cf-4d9fc941dfc4","parentUuid":"a7a67bd9-7912-4321-880e-7cf0355ce301","uuid":"e0ec5f16-ea90-4d88-8b4d-fd0c18b7b427"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"You should indicate whether the data collection involves sensitive information, human subjects, or other elements that require compliance with ethical guidelines or legal regulations such as GDPR, HIPAA, or relevant national or international laws.\n\nNote that even non-sensitive data may be subject to ethical legislation. For example, environmental data collected in protected areas, cultural heritage data involving Indigenous knowledge or traditional practices, or data from vulnerable populations (even if anonymized, such as minors or refugees) may still require ethical approval due to the context of their collection or use."},"title":{"changed":false}},"createdAt":"2025-04-09T12:59:17Z","entityUuid":"dedc1acc-2be5-4af1-9287-96c9c95f85d7","parentUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","uuid":"2ff3bd50-9c1d-4afe-b1e7-0803f5e81243"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"93d6fe6e-256a-4888-8c09-9b885f8f0b20"},"createdAt":"2025-04-09T12:59:18Z","entityUuid":"c9b17b43-8fe6-4655-98cf-4d9fc941dfc4","parentUuid":"a7a67bd9-7912-4321-880e-7cf0355ce301","uuid":"94ca73df-ef7f-41ca-bc52-4333626b5cc3"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What other security precautions exist?"}},"createdAt":"2025-04-09T12:59:19Z","entityUuid":"c9b17b43-8fe6-4655-98cf-4d9fc941dfc4","parentUuid":"93d6fe6e-256a-4888-8c09-9b885f8f0b20","uuid":"1819e171-527f-4948-918e-6e88bbf2cc88"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Unit of measurement"},"variables":{"changed":false}},"createdAt":"2025-04-09T12:59:20Z","entityUuid":"985cc0ae-68f8-48a0-8199-ea8db6bc3799","parentUuid":"1ead92e3-72be-4bd1-98f6-3a2927903e32","uuid":"9b781774-17d6-49f5-a607-a77a322c3ba5"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":t