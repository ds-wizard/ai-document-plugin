4cae-b2b4-477b2e55cbb7","parentUuid":"d1332925-ff50-45cc-bae3-4839019be645","uuid":"d0665cf7-0c8c-47a5-97be-b7bff8601051"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":true,"value":["040509af-4616-4683-9228-5b4c907ce4b2","622c9523-b96e-48cc-8693-7441003eacb8","7598e37b-def5-483e-be0f-c4b3d48f9103","fe4619ab-1488-4535-b1fe-64e756bc0f6c","17112d66-b5ba-41ab-951f-cee71409d1e9","e686d38b-cc29-4cae-b2b4-477b2e55cbb7","fbb17122-3bc9-4780-9f8a-bbb0986e4b17"]},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-01T13:33:50Z","entityUuid":"d1332925-ff50-45cc-bae3-4839019be645","parentUuid":"ed019990-a2da-4301-8a09-030ba38ef992","uuid":"0c89469d-cc4d-4ca3-9585-50109851ef2c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:33:51Z","entityUuid":"e98d3229-be0b-480b-8ce6-326d9cf5da89","parentUuid":"d1332925-ff50-45cc-bae3-4839019be645","uuid":"0675dcb6-4893-4686-baed-7e8d3be194b3"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2023-08-01T13:33:52Z","entityUuid":"e98d3229-be0b-480b-8ce6-326d9cf5da89","parentUuid":"d1332925-ff50-45cc-bae3-4839019be645","uuid":"2cfa42f1-a440-4168-a614-36083df87c99"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Very many kinds of data are connected to people. If there could be a way for someone, including yourself, to find out who that person is, that is considered personal data.\n\nSimple examples are name, birth day or address; but there are many other data that can be personal: for example a voice recording, a combination of a location and a time (traffic flow), genetic information, or an X-ray of the skull."},"title":{"changed":true,"value":"Will you collect any data connected to a person, \"personal data\"?"}},"createdAt":"2023-08-01T13:33:53Z","entityUuid":"e98d3229-be0b-480b-8ce6-326d9cf5da89","parentUuid":"d1332925-ff50-45cc-bae3-4839019be645","uuid":"68fc0bf6-95d5-482a-b4d5-861bd2c395da"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:33:54Z","entityUuid":"7c4593f8-43d6-4cf3-b74e-75ae29f8249e","parentUuid":"e98d3229-be0b-480b-8ce6-326d9cf5da89","uuid":"5d1536a0-b3b7-4daf-8d43-f5e108665dd7"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:33:55Z","entityUuid":"7c4593f8-43d6-4cf3-b74e-75ae29f8249e","parentUuid":"e98d3229-be0b-480b-8ce6-326d9cf5da89","uuid":"7b453b17-3562-4bb6-b206-4f197b011d1e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:33:56Z","entityUuid":"16c0e7dd-03cc-4ec8-9928-41d87631ddb3","parentUuid":"e98d3229-be0b-480b-8ce6-326d9cf5da89","uuid":"f32be55b-e3ea-48ab-86fb-133fa60efa2b"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"}