ame":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":true,"value":{"record_type":"","registry":"standard","status":"ready"}},"variables":{"changed":false}},"createdAt":"2025-07-24T09:29:38Z","entityUuid":"ec3431be-6644-4896-8951-2a705974b9d4","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"5969a6f6-701d-485c-9e04-f2ee4193ec48"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":true,"value":{"request":{"body":null,"headers":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"[SECRET:fs_apiKey]"}],"method":"GET","url":"[SECRET:fs_apiUrl]/search?registry=standard&record_type=&q=doi&status=ready"},"response":{"body":"{\"data\":[],\"links\":{\"self\":null,\"first\":null,\"prev\":null,\"next\":null,\"last\":null},\"note\":\"Proxied for use in Data Stewardship Wizard (see https://ds-wizard.org for more)\"}","contentType":"application/json","responseType":"SuccessTypeHintResponse","status":200}}},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-07-24T09:29:39Z","entityUuid":"ec3431be-6644-4896-8951-2a705974b9d4","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"0feacff6-3fb9-473d-a700-f8e2c47b8eb2"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":true,"value":{"record_type":"identifier_schema","registry":"standard","status":"ready"}},"variables":{"changed":false}},"createdAt":"2025-07-24T09:29:40Z","entityUuid":"ec3431be-6644-4896-8951-2a705974b9d4","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"808291f2-5f71-4556-8e4a-acd6f4520665"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":true,"value":{"request":{"body":null,"headers":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"[SECRET:fs_apiKey]"}],"method":"GET","url":"[SECRET:fs_apiUrl]/search?registry=standard&record_type=identifier_schema&q=doi&status=ready"},"response":{"body":"{\"data\":[{\"id\":\"1332\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"Digital Object Identifier\",\"abbreviation\":\"DOI\",\"description\":\"The digital object identifier (DOI) system originated in a joint initiative of three trade associations in the publishing industry (International Publishers Association; International Association of Scientific, Technical and Medical Publishers; Association of American Publishers). The system was announced at the Frankfurt Book Fair 1997. The International DOI® Foundation (IDF) was created to develop and manage the DOI system, also in 1997. The DOI system was adopted as International Standard ISO 26324 in 2012. The DOI system implements the Handle System and adds a number of new features. The DOI system provides an infrastructure for persistent unique identification of objects of any type. The DOI system is designed to work over the Internet. A DOI name is permanently assigned to an object to provide a resolvable persistent network link to current information about that object, including where the object, or information about it, can be found on the Internet. While information about an object can change over time, its DOI name will not change. A DOI name can be resolved within the DOI system to values of one or more types of data relating to the object identified by that DOI name, such as a URL, an e-mail address, other identifiers and descriptive metadata. The DOI system enables the construction of automated services and transactions. Applications of the DOI system include but are not limited to managing information and documentation location and access; managing metadata; facilitating electronic transactions; persistent unique identification of any form of any data; and commercial and non-commercial transactions. The content of an object associated with a DOI name is described unambiguously by DOI metadata, based on a structured extensible data model that enables the object to be associated with metadata of any desired degree of precision and granularity to support description and services. The data model supports interoperability between DOI applications. The scope of the DOI system is not defined by reference to the type of content (format, etc.) of the referent, but by reference to the functionalities it provides and the context of use. The DOI system provides, within networks of DOI applications, for unique identification, persistence, resolution, metadata and semantic interoperability.\",\"doi\":\"10.25504/FAIRsharing.hFLKCn\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.hFLKCn\",\"homepage\":\"https://www.doi.org\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Knowledge and Information Systems\",\"Subject Agnostic\"],\"domains\":[\"centrally registered identifier\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[\"bsg-001182\",\"bsg-s001182\"],\"created_at\":\"2018-04-23T14:22:48.000Z\",\"updated_at\":\"2025-06-17T08:01:12.193Z\"},{\"id\":\"3904\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"Research Activity Identifier\",\"abbreviation\":\"RAiD\",\"description\":\"Research Activity Identifier (RAiD) is an identifier mechanism designed for research projects and activities. It is persistent and connects existing PIDs for researchers, institutions, outputs and tools together to create a timeline of research activity which makes connecting digital infrastructure, reporting on impact and establishing data provenance clear and easy. RAiD is one of the Identifier Services owned and offered by the Australia Research Data Commons (ARDC), and can be accessed for machine-to-machine service by API integration, using a RAiD service point designated platform, or by manually minting via the RAiD user Dashboard.\",\"doi\":\"10.25504/FAIRsharing.dc702a\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.dc702a\",\"homepage\":\"https://raid.org/\",\"countries\":[\"Australia\"],\"disciplines\":[\"Subject Agnostic\"],\"domains\":[\"Resource metadata\",\"centrally registered identifier\",\"Knowledge representation\",\"FAIR\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2022-03-09T19:02:59.839Z\",\"updated_at\":\"2025-09-05T12:19:47.696Z\"},{\"id\":\"4538\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"International Generic Sample Number\",\"abbreviation\":\"IGSN (Generic)\",\"description\":\"An IGSN ID is a globally unique and persistent identifier for physical samples in all scientific fields. An IGSN ID can be applied to an individual sample, an aggregation of samples, or to a feature-of-interest (the real-world feature that the sample is taken from). From 2021, IGSN IDs are functionally DOIs and are registered with metadata encoded in the DataCite Metadata Schema. The IGSN ID, previously known as an \\\"International GeoSample Number\\\", naming schema has changed, to reflects the expanding scope and utilization as a partnership agreement between DataCite and the IGSN e.V.\",\"doi\":\"10.25504/FAIRsharing.c7f365\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.c7f365\",\"homepage\":\"https://www.igsn.org\",\"countries\":[\"Germany\",\"United States\",\"Worldwide\"],\"disciplines\":[\"Hydrogeology\",\"Geochemistry\",\"Environmental Science\",\"Data Management\",\"Omics\",\"Archaeology\",\"Geology\",\"Earth Science\"],\"domains\":[\"centrally registered identifier\",\"Biospecimen\"],\"taxonomies\":[\"environmental samples\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2022-12-01T10:06:07.871Z\",\"updated_at\":\"2025-07-28T14:45:32.653Z\"},{\"id\":\"4495\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"DDI Agency Identifier\",\"abbreviation\":null,\"description\":\"The DDI Agency Identifier is part of a free globally-unique identifier system for metadata-producing organizations. In concert with the DDI Agency Registry, the DDI Agency Identifier acts as both a namespace in a globally-unique id and a pointer for distributed service resolution.\\nBased on ISO/IEC 11179 Part 6 International Registration Data Identifiers (11179 IRDIs), DDI agency identifiers are used as the Registration Authority (11179 RA) in a IRDI and in DDI URNs.\",\"doi\":\"10.25504/FAIRsharing.cfe09b\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.cfe09b\",\"homepage\":\"https://registry.ddialliance.org/\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Subject Agnostic\"],\"domains\":[\"Resource metadata\",\"centrally registered identifier\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2022-11-02T08:11:27.620Z\",\"updated_at\":\"2024-04-18T09:31:37.139Z\"},{\"id\":\"6575\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"Common Science and Technology Resource Identifier\",\"abbreviation\":\"CSTR\",\"description\":\"The Common Science and Technology Resource Identifier (\\\"CSTR\\\") is a persistent identifier schema for locating, accessing, and manipulating science and technology resources. CSTR aims to promote the interconnection among various science and technology resources, to promote the openness and sharing of science and technology resources.\",\"doi\":\"10.25504/FAIRsharing.f0d465\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.f0d465\",\"homepage\":\"https://www.cstr.cn/doc/specification/\",\"countries\":[\"China\"],\"disciplines\":[\"Subject Agnostic\"],\"domains\":[\"centrally registered identifier\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[\"Open Science\"],\"legacy_ids\":[],\"created_at\":\"2025-07-15T11:49:34.123Z\",\"updated_at\":\"2025-07-15T12:56:22.279Z\"},{\"id\":\"4142\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"Persistent Identifier Consortium for eResearch\",\"abbreviation\":\"ePIC Identifier\",\"description\":\"ePIC is to set up and maintain a reliable joint service for registering, storing and resolving persistent identifiers based on handles for the research community. ePIC was founded in 2009 by a consortium of European partners in order to provide PID services for the European Research Community, based on the handle system, for the allocation and resolution of persistent identifiers. The consortium signed a Memorandum of Understanding aiming to provide long term reliability for the PID services. Meanwhile ePIC is also an international consortium and open to partners from the research community worldwide.\",\"doi\":\"10.25504/FAIRsharing.83ded0\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.83ded0\",\"homepage\":\"https://doc.pidconsortium.net/docs/generate\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Subject Agnostic\"],\"domains\":[\"Resource metadata\",\"Data retrieval\",\"web service\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[\"Metadata standardization\"],\"legacy_ids\":[],\"created_at\":\"2022-05-25T00:29:28.549Z\",\"updated_at\":\"2025-07-28T14:43:57.660Z\"},{\"id\":\"5050\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"Uniform Resource Name\",\"abbreviation\":\"URN\",\"description\":\"A Uniform Resource Name (URN) is a Uniform Resource Identifier (URI) that is assigned under the \\\"urn\\\" URI scheme and a particular URN namespace, with the intent that the URN will be a persistent, location-independent resource identifier.\",\"doi\":\"10.25504/FAIRsharing.981c26\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.981c26\",\"homepage\":\"https://datatracker.ietf.org/doc/html/rfc8141\",\"countries\":[],\"disciplines\":[\"Knowledge and Information Systems\",\"Subject Agnostic\"],\"domains\":[\"centrally registered identifier\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2023-10-20T08:34:33.994Z\",\"updated_at\":\"2024-10-10T08:48:31.988Z\"},{\"id\":\"4503\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"Research Organization Registry ID Schema\",\"abbreviation\":\"ROR ID\",\"description\":\"The Research Organization Registry (ROR) ID schema is the specification of the identifier for institutions in ROR. ROR is a global, community-led registry of open persistent identifiers for research organizations. ROR makes it easy for anyone or any system to disambiguate institution names and connect research organizations to researchers and research outputs.\",\"doi\":\"10.25504/FAIRsharing.f73143\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.f73143\",\"homepage\":\"https://ror.readme.io/docs/ror-identifier-pattern\",\"countries\":[\"United States\"],\"disciplines\":[\"Subject Agnostic\"],\"domains\":[\"Data retrieval\",\"centrally registered identifier\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2022-11-10T19:39:10.416Z\",\"updated_at\":\"2025-07-01T07:22:53.325Z\"},{\"id\":\"5092\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"Protein Data Bank Identifier\",\"abbreviation\":\"PDB ID\",\"description\":\"PDB IDs are identifiers used at all levels of the structural hierarchy for entries in the Protein Data Bank using the prefix “pdb” followed by a 4-character alphanumeric identifier. These identifiers are used to specifically select, visualize, locate a specific instance of a ligand, and/or an amino acid in a protein chain in a particular PDB entry.\",\"doi\":\"10.25504/FAIRsharing.457f35\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.457f35\",\"homepage\":\"https://www.rcsb.org/docs/general-help/identifiers-in-pdb\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Knowledge and Information Systems\",\"Omics\",\"Bioinformatics\",\"Structural Biology\",\"Proteomics\"],\"domains\":[\"Structure\",\"Protein structure\",\"Data analysis\",\"centrally registered identifier\"],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[],\"legacy_ids\":[],\"created_at\":\"2023-11-14T10:13:43.957Z\",\"updated_at\":\"2025-04-22T20:25:30.305Z\"},{\"id\":\"6248\",\"registry\":\"standard\",\"record_type\":\"identifier_schema\",\"name\":\"Space Physics Archive Search and Extract Resource ID\",\"abbreviation\":\"SPASE resource Id\",\"description\":\"A SPASE resource Identifier is a name for a resource within the SPASE registry. This name can be used to identify a resource from the SPASE registry (for reference in metadata), to cross-reference entities in the SPASE registry, and to retrieve the metadata of an entity present in the SPASE Registry like a dataset, an observatory or a repository.\",\"doi\":\"10.25504/FAIRsharing.8b8737\",\"url\":\"https://fairsharing.org/10.25504/FAIRsharing.8b8737\",\"homepage\":\"https://spase-group.org/docs/conventions/Resource-ID-Formation-Rule-v5.pdf\",\"countries\":[\"Worldwide\"],\"disciplines\":[\"Planetary Astronomy\",\"Astronomy and Astrophysics\"],\"domains\":[],\"taxonomies\":[\"Not applicable\"],\"user_defined_tags\":[\"Solar physics\",\"space weather\",\"heliophysics\"],\"legacy_ids\":[],\"created_at\":\"2025-02-20T08:43:47.245Z\",\"updated_at\":\"2025-07-28T14:44:04.137Z\"}],\"links\":{\"self\":null,\"first\":null,\"prev\":null,\"next\":null,\"last\":null},\"note\":\"Proxied for use in Data Stewardship Wizard (see https://ds-wizard.org for more)\"}","contentType":"application/json","responseType":"SuccessTypeHintResponse","status":200}}},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-07-24T09:29:41Z","entityUuid":"ec3431be-6644-4896-8951-2a705974b9d4","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"551fc63a-a284-4dad-a5ae-09d9b0af6138"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":true,"value":"FAIRsharing "},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testRespo