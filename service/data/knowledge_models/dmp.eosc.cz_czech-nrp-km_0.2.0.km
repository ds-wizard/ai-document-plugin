"createdAt":"2023-08-01T13:34:06Z","entityUuid":"30e48b8f-af35-4e6e-9ab7-a9bf5dbd5301","parentUuid":"e98d3229-be0b-480b-8ce6-326d9cf5da89","uuid":"d6b58738-bfc3-43b4-ab60-5ada50f29fce"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:34:07Z","entityUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","parentUuid":"16c0e7dd-03cc-4ec8-9928-41d87631ddb3","uuid":"6b39869e-c9e9-407f-a88e-da4e0ca708f1"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Does your project fall under General Data Protection Regulation (GDPR)?"}},"createdAt":"2023-08-01T13:34:08Z","entityUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","parentUuid":"16c0e7dd-03cc-4ec8-9928-41d87631ddb3","uuid":"a1616de2-511e-4fc2-be65-136d341bd6b2"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:09Z","entityUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","parentUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","uuid":"cef5908a-693c-4a38-ab97-7060dd54477e"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:10Z","entityUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","parentUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","uuid":"912e5cdd-95bf-49fe-8e72-870f2752f319"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:11Z","entityUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","parentUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","uuid":"99a5462e-2f90-4c40-8b40-b20fb375798d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:12Z","entityUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","parentUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","uuid":"c7fc9238-8d2c-464a-bec3-8b0bd941bdf9"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:34:13Z","entityUuid":"dd4a9014-0a10-47da-8743-3efea6236572","parentUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","uuid":"c71362c4-602e-41be-ad73-1c8b24798167"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What laws or regulations apply to your project, and how will compliance be assured?"},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2023-08-01T13:34:14Z","entityUuid":"dd4a9014-0a10-47da-8743-3efea6236572","parentUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","uuid":"e3597639-7399-4299-8e00-c8896147faf4"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:34:15Z","entityUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","parentUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","uuid":"4ad7dd81-d4bf-4aec-83fb-66bc0f42e1a3"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"[Article 6](https://gdpr-info.eu/art-6-gdpr/) (1) lists under what conditions the processing is considered lawful. Of these, **Consent** or **Public** interest are relevant when it comes to research. You should determine what legal basis (or bases) you have for processing the personal data in your project. \n\nTraditionally, *consent* has been the basis for processing personal data for research, but under the GDPR there cannot be an imbalance between the processor and the data subject for it to be considered to be freely given. In some countries the use of *consent* as the legal basis for processing by universities for research purposes is therefore not recommended. In those cases, public interest should probably be your legal basis. Note that if your legal basis for processing is consent, [a number of requirements](https://gdpr-info.eu/issues/consent/) exists for the consent to be considered valid under the GDPR. Consents given before the GDPR might not live up to this. \n\nAlso note that even if *public interest* is the legal basis, other laws and research ethics standards might still require you to have consent from the subjects for performing the research.\n\nPlease consult with the Data Protection Officer of your organisation on which legal basis to apply to your data."},"title":{"changed":true,"value":"What legal basis are you using to collect and process the personal data?"}},"createdAt":"2023-08-01T13:34:16Z","entityUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","parentUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","uuid":"042c5bcf-8bb9-41c6-a490-e1b3a0e92fac"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:17Z","entityUuid":"bde3dcfb-58d7-46e0-8f41-358ec78ef705","parentUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","uuid":"2dabe689-baf3-4cf9-97b7-0559591eed02"},{"content":{"advice":{"changed":true,"value":"Note that scientific research is not considered public interest in many jurisdictions."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Public interest"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:18Z","entityUuid":"bde3dcfb-58d7-46e0-8f41-358ec78ef705","parentUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","uuid":"1617ebfb-45ab-4203-8bc4-6803d4950664"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:19Z","entityUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","parentUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","uuid":"e8340bd1-194b-4150-9737-c31fd575bcce"},{"content":{"advice":{"changed":true,"value":"Traditionally, *consent* has been the basis for processing personal data for research, but under the GDPR there cannot be an imbalance between the processor and the data subject for it to be considered to be freely given. In some countries the use of *consent* as the legal basis for processing by universities for research purposes is therefore not recommended. In those cases, public interest should probably be your legal basis. Note that if your legal basis for processing is consent, [a number of requirements](https://gdpr-info.eu/issues/consent/) exists for the consent to be considered valid under the GDPR. Consents given before the GDPR might not live up to this. \n\nNote that consent needs to be completely voluntary. If the subject gets any service or good in return for their permission, this is not considered consent. Also note that in European (GDPR) law, a data subject should be able to retract their consent at any moment."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We ask the data subjects for their consent"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:20Z","entityUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","parentUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","uuid":"447c1a9e-f17a-402a-83cb-bf0b28e4719a"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T13:34:21Z","entityUuid":"32dbe84a-855a-4bdf-8f53-463b6badaa72","parentUuid":"67656fcf-48db-4d7f-8a83-5874f058e5bf","uuid":"0a41ea00-7bfc-4e29-8558-309c9ab1ca35"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:34:22Z","entityUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"cfbddad5-32ac-40eb-8a40-b4edb268f47e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What kind of consent will you be acquiring?"}},"createdAt":"2023-08-01T13:34:23Z","entityUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"6dda8f9e-b808-484e-a650-35d808c0dfe3"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:24Z","entityUuid":"2fd79a81-c929-4c63-a03e-6818f58bc51f","parentUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","uuid":"2a26474e-5d22-4874-92b3-e6e3991af8d2"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We collect consent for our specific use of the data"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:25Z","entityUuid":"2fd79a81-c929-4c63-a03e-6818f58bc51f","parentUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","uuid":"14b746af-a716-4f23-915f-06fccd488498"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:26Z","entityUuid":"db404485-a0a4-4974-9554-f47f40c41d4d","parentUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","uuid":"1b1fffdd-62e3-494a-8932-2a4ff5c3693d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We collect consent for our use as well as for reuse of the data"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:27Z","entityUuid":"db404485-a0a4-4974-9554-f47f40c41d4d","parentUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","uuid":"f649be3f-6e4e-45cd-8181-a5635a45dfbc"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:28Z","entityUuid":"0fce2808-9724-43eb-a2cf-3b81119d0cd0","parentUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","uuid":"3c2e4cfc-975c-4271-87f8-bf9d0fc02217"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We will collect consent for our use of the data and for anonymization; We will anonymize the data afterwards for reuse"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:29Z","entityUuid":"0fce2808-9724-43eb-a2cf-3b81119d0cd0","parentUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","uuid":"577d6895-4605-4657-9f86-543bc390949b"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:30Z","entityUuid":"dc32559c-1de2-4af8-bfa2-0e0885254faa","parentUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","uuid":"542644c1-7944-4b90-b715-1f504fb411f8"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We ask for consent for anonymization; We will anonymize first and all further processing is on the anonymous data"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:31Z","entityUuid":"dc32559c-1de2-4af8-bfa2-0e0885254faa","parentUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","uuid":"b5a1c239-06ee-44bf-9e0f-fe554feeb854"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:34:32Z","entityUuid":"67acb1fc-e363-40d8-a35c-356eb2595cfe","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"9e855426-1bbf-4220-86cd-e58d610934b1"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Explain how data subjects will be informed. "}},"createdAt":"2023-08-01T13:34:33Z","entityUuid":"67acb1fc-e363-40d8-a35c-356eb2595cfe","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"be740445-580f-446d-9eaf-ca05748d5085"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Explain how data subjects will be informed and how data subject's requests will be handled.\n\nData subjects must be informed of the purpose, the interest of the study, the type of collected data, and the potential risks to which they will be exposed.\n\nIf the processing operation is exempted from the right to information according to the GDPR, provide a justification.\nMention the relevant document in which the responsibilities regarding the information of data subjects are indicated."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2023-08-01T13:34:34Z","entityUuid":"67acb1fc-e363-40d8-a35c-356eb2595cfe","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"7472ede3-569d-4c39-8aa3-6bfd8e0a0b1a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:35Z","entityUuid":"d8560926-3980-4616-ac93-ead946d02538","parentUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","uuid":"850013e6-0266-465d-a4c9-d37e5f028618"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Will the consent form be available for re-users?"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:36Z","entityUuid":"d8560926-3980-4616-ac93-ead946d02538","parentUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","uuid":"f6c51ac4-2011-41a0-8d60-13a77c6c12d7"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2023-08-01T13:34:37Z","entityUuid":"d8560926-3980-4616-ac93-ead946d02538","parentUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","uuid":"f5c5dad8-f4ce-4bae-a5d0-ce9d69eea898"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:34:38Z","entityUuid":"20f6cb57-bcd0-4cea-b539-72dcb3ca8990","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"aff5ef81-2add-43a7-8bea-167d31700fc4"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will the consent form be available for re-users?"}},"createdAt":"2023-08-01T13:34:39Z","entityUuid":"20f6cb57-bcd0-4cea-b539-72dcb3ca8990","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"279b512d-33cf-4fc8-98a0-258541d696d6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:40Z","entityUuid":"cc25b02e-70f1-4832-b977-13222161b9f0","parentUuid":"20f6cb57-bcd0-4cea-b539-72dcb3ca8990","uuid":"dbaf54a1-610b-4ba2-8276-c2ea20533f13"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:41Z","entityUuid":"cc25b02e-70f1-4832-b977-13222161b9f0","parentUuid":"20f6cb57-bcd0-4cea-b539-72dcb3ca8990","uuid":"77bb8a10-4100-4193-8b94-0a8042fe9325"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:34:42Z","entityUuid":"6439b6f5-e0cd-4267-9206-5d5e3b0a52c7","parentUuid":"20f6cb57-bcd0-4cea-b539-72dcb3ca8990","uuid":"f9d2c4f0-3c91-462d-8ce7-1bb912d54e00"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:34:43Z","entityUuid":"6439b6f5-e0cd-4267-9206-5d5e3b0a52c7","parentUuid":"20f6cb57-bcd0-4cea-b539-72dcb3ca8990","uuid":"383139b1-bbb3-424f-aed3-ee17b33bd673"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:34:44Z","entityUuid":"806fab08-efea-4637-ba43-daa4f93dde72","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"fdf742c8-7e04-452f-8e7e-5fff807db63f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Describe the procedure for obtaining consent from data subjects"}},"createdAt":"2023-08-01T13:34:45Z","entityUuid":"806fab08-efea-4637-ba43-daa4f93dde72","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"746edd52-dc38-48da-b8ec-7bb2ebf2e227"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Where the processing is under consent, appropriate measures should be take to demonstrate how the data subjects have consented.\nMention the documents where the consent is established (e.g., data information sheet)."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2023-08-01T13:34:46Z","entityUuid":"806fab08-efea-4637-ba43-daa4f93dde72","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"d8c61723-453d-4d88-b8f4-653c992b4a82"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:34:47Z","entityUuid":"fb4ffda1-4bda-4c88-bdb3-219237d05a4a","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"f8ab8310-35f3-46c9-9efb-6b16fcc0324c"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Describe how data subjects exercise their rights to their data"}},"createdAt":"2023-08-01T13:34:48Z","entityUuid":"fb4ffda1-4bda-4c88-bdb3-219237d05a4a","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"0ffb9e29-cbbc-4bb5-8d19-c8d5abf8f00f"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:34:49Z","entityUuid":"31d1ca00-22d0-4f71-a222-f5b56344bcfb","parentUuid":"fb4ffda1-4bda-4c88-bdb3-219237d05a4a","uuid":"4e77ca1a-3d7b-4122-bc4e-442b50e415ff"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"They can access the data after the project's completion."}},"createdAt":"2023-08-01T13:34:50Z","entityUuid":"31d1ca00-22d0-4f71-a222-f5b56344bcfb","parentUuid":"fb4ffda1-4bda-4c88-bdb3-219237d05a4a","uuid":"93be8eb8-988b-4dcf-9a6e-ec6911ff4a3b"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:34:51Z","entityUuid":"7b39073a-c558-40bb-a83b-a23bbe999270","parentUuid":"fb4ffda1-4bda-4c88-bdb3-219237d05a4a","uuid":"ea5b965a-f39d-46fe-8545-c7c6d434a578"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"They can ask for the data to be modified after the project's completion (which may include the deletion of the data)."}},"createdAt":"2023-08-01T13:34:52Z","entityUuid":"7b39073a-c558-40bb-a83b-a23bbe999270","parentUuid":"fb4ffda1-4bda-4c88-bdb3-219237d05a4a","uuid":"7127ed92-df76-425b-8ef1-9d4c290994b0"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:34:53Z","entityUuid":"23239165-2dc5-4230-aff3-610f5728db38","parentUuid":"fb4ffda1-4bda-4c88-bdb3-219237d05a4a","uuid":"f8f9dacf-1f60-4090-a1e7-f32b189628d1"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","labe