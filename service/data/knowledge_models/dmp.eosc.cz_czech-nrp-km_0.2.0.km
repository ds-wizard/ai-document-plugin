false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Describe the measures put in place to protect data during the transfer as well as the measures taken to ensure GDPR compliance by third parties, e.g. by establishing agreements."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2023-08-01T13:37:38Z","entityUuid":"93440f32-679d-4566-9954-171ea7f96e94","parentUuid":"20f0a75b-a2cd-48d4-ba66-df7ca4c7eb82","uuid":"03a5b69c-d60a-4b15-8b9b-53f644d9ff12"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T13:37:39Z","entityUuid":"305b0550-0760-4dae-82cd-be82b116ec93","parentUuid":"2b842099-d4f6-4994-9a31-789d529ecf25","uuid":"565cff1b-b349-49cb-ab26-3abbb1e7f837"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","label":{"changed":true,"value":"RDMkit on Data Security"},"referenceType":"URLReference","url":{"changed":true,"value":"https://rdmkit.elixir-europe.org/data_security"}},"createdAt":"2023-08-01T13:37:40Z","entityUuid":"305b0550-0760-4dae-82cd-be82b116ec93","parentUuid":"2b842099-d4f6-4994-9a31-789d529ecf25","uuid":"080e5fd6-023f-4f42-9f34-4d1698e510a3"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1"},"createdAt":"2023-08-01T13:37:41Z","entityUuid":"2b842099-d4f6-4994-9a31-789d529ecf25","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"db18b573-ddb4-4904-a1da-adf5380fa930"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1"},"createdAt":"2023-08-01T13:37:42Z","entityUuid":"8b169987-5891-4eb7-b45e-f365825b783b","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"d332264a-f5af-454e-9f37-80c3b4874f14"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1"},"createdAt":"2023-08-01T13:37:43Z","entityUuid":"5