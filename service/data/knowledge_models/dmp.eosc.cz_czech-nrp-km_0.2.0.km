lse},"label":{"changed":true,"value":""},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:35:15Z","entityUuid":"7cf20fe0-2d88-42e7-9a13-f11b788ae3e5","parentUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","uuid":"81718d2f-4956-48a5-840e-09b55391291d"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2023-08-01T13:35:16Z","entityUuid":"7cf20fe0-2d88-42e7-9a13-f11b788ae3e5","parentUuid":"9b531bf1-ca5a-47cb-882f-3671001de1ba","uuid":"35527567-1779-41f6-96b7-6ec87f8d1e06"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:35:17Z","entityUuid":"28dc53ef-afbd-4d46-9a62-26ef41d7b863","parentUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","uuid":"845e6200-9af5-46fe-8a83-165947d2269b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"State the purpose of processing the personal data"}},"createdAt":"2023-08-01T13:35:18Z","entityUuid":"28dc53ef-afbd-4d46-9a62-26ef41d7b863","parentUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","uuid":"8c8aafbd-6533-45e2-a8ea-636d337db98f"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2023-08-01T13:35:19Z","entityUuid":"28dc53ef-afbd-4d46-9a62-26ef41d7b863","parentUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","uuid":"5ef146c3-7da1-49d0-9270-c114bb1cc3e7"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:35:20Z","entityUuid":"41df9d95-fd58-466b-a2ca-2a8224e6b600","parentUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","uuid":"2cfd6403-2841-4e5e-95da-0a7b183a327f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"[Article 4](https://gdpr-info.eu/art-4-gdpr/) (7): *“**‘controller’** means the natural or legal person, public authority, agency or other body which, alone or jointly with others, **determines the purposes** and means of the processing of personal data; […].”* The Controller is typically the university employer of the PI, and the PI should act as a representative of her university employer and is responsible for ensuring that personal data is handled correctly in her projects. For cross-border collaborative projects the controllers of different datasets should be identified. Also, if joint controllership is considered, make sure that all parties understand their obligations, and it is probably good to define the terms for this in an agreement between the parties."},"title":{"changed":true,"value":"Who are the data controller(s) of the personal data processed in the project?"}},"createdAt":"2023-08-01T13:35:21Z","entityUuid":"41df9d95-fd58-466b-a2ca-2a8224e6b600","parentUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","uuid":"9af813c7-b0af-4e9b-b1a7-57de2b5d63d5"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:35:22Z","entityUuid":"945117a6-c199-44d6-bd47-22173bba122b","parentUuid":"41df9d95-fd58-466b-a2ca-2a8224e6b600","uuid":"2163ec94-3176-4f59-8f4e-f543d59dbb90"},{"co