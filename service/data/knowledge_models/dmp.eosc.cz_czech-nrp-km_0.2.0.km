uid":"7ae73a81-e72b-4ca7-879e-89508a9cba86"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"NumberQuestionValueType"}},"createdAt":"2023-08-01T13:48:07Z","entityUuid":"b860b89d-0af7-4ce6-a18d-d0210d7b23f6","parentUuid":"de8e07a5-43d1-40ab-a11b-3344df06cb81","uuid":"6e164548-b844-4253-aa7d-863dcafdd162"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:48:08Z","entityUuid":"7c96d207-4306-4967-ba38-a297ab2258b0","parentUuid":"c42fa659-7437-458b-ba3a-790735d0cc3f","uuid":"1e58ec38-3bb6-4a6e-b393-e5413bb33e02"},{"content":{"eventType":"DeleteAnswerEvent"},"createdAt":"2023-08-01T13:48:09Z","entityUuid":"7c96d207-4306-4967-ba38-a297ab2258b0","parentUuid":"c42fa659-7437-458b-ba3a-790735d0cc3f","uuid":"2e74f74c-4734-4ff8-941f-3e0adb960286"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:48:10Z","entityUuid":"381db64f-0abc-4a70-b881-1880c35ef121","parentUuid":"f1e49a7e-5671-4e4f-b4dc-703a197fcb4f","uuid":"e22b2804-16c6-471f-b6b3-4bccc6788d0e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Formats like XLS or SQL are very flexible; they can be adapted to many different uses, and this makes them good for interoperability. However, their flexibility also makes that it is not immediately obvious from the file structure how it can be used. The data needs a proper *description* in order for others (or yourself at a later time) to be able to unambiguously understand what it contains."},"title":{"changed":true,"value":"Is this data format completely described?"}},"createdAt":"2023-08-01T13:48:11Z","entityUuid":"381db64f-0abc-4a70-b881-1880c35ef121","parentUuid":"f1e49a7e-5671-4e4f-b4dc-703a197fcb4f","uuid":"622508e3-e40b-4c81-a0d4-9b89410c4b7f"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:48:12Z","entityUuid":"ef793383-a6c1-4173-8e33-9b71a15cdb86","parentUuid":"381db64f-0abc-4a70-b881-1880c35ef121","uuid":"c12c207f-5755-420f-936f-8d399c6ea1cf"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:48:13Z","entityUuid":"ef793383-a6c1-4173-8e33-9b71a15cdb86","parentUuid":"381db64f-0abc-4a70-b881-1880c35ef121","uuid":"a1000adf-74b1-4a81-aad9-59c22b887409"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:48:14Z","entityUuid":"604857e6-4bab-470f-a34a-2504fd236c8e","parentUuid":"381db64f-0abc-4a70-b881-1880c35ef121","uuid":"103ca0f9-86d6-49dd-a74f-74cc515a39e4"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:48:15Z","entityUuid":"604857e6-4bab-470f-a34a-2504fd236c8e","parentUuid":"381db64f-0abc-4a70-b881-1880c35ef121","uuid":"9ce99cd8-f9f2-487f-9f51-f818f8f3a217"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-0