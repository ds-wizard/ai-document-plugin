":"6f126daf-414a-49e6-bdef-6eab6cd1625d"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2023-08-01T14:00:49Z","entityUuid":"8160741e-8f81-405e-9bf8-5b0e293efa38","parentUuid":"7263167f-7670-42a8-8683-c4a859dc6bc6","uuid":"abcdf7a8-5359-4b20-873f-729fbb84e292"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2023-08-01T14:00:50Z","entityUuid":"68a7fc7f-1263-402e-9258-e460ccd5a0dc","parentUuid":"7263167f-7670-42a8-8683-c4a859dc6bc6","uuid":"99bb79e0-07fd-4ead-a1d6-265b2ab6a607"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T14:00:51Z","entityUuid":"fed4a3f4-a25b-4d69-b53f-a8e76ccc4c9e","parentUuid":"ed019990-a2da-4301-8a09-030ba38ef992","uuid":"2a4d9bbf-86ae-4407-8617-b3068e408462"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2023-08-01T14:00:52Z","entityUuid":"fed4a3f4-a25b-4d69-b53f-a8e76ccc4c9e","parentUuid":"ed019990-a2da-4301-8a09-030ba38ef992","uuid":"9aa0500e-1114-4e13-989a-9e5390ef1099"},{"content":{"abbreviation":null,"annotations":[],"description":null,"eventType":"AddMetricEvent","title":""},"createdAt":"2023-08-01T14:00:53Z","entityUuid":"11860c2b-24a5-470e-a45d-123831c06493","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"37ec10ac-dff3-4398-8074-b0cfb21b4803"},{"content":{"abbreviation":{"changed":true,"value":"F"},"annotations":{"changed":false},"description":{"changed":true,"value":"The Findability metric describes how easily data can be located. The score associated with an answer will be higher if it makes it easier for humans or for computers to locate your data set, e.g. if it ends up in an index or has a unique resolvable identifier."},"eventType":"EditMetricEvent","title":{"changed":true,"value":"Findability"}},"createdAt":"2023-08-01T14:00:54Z","entityUuid":"11860c2b-24a5-470e-a45d-123831c06493","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"dcf7a1cb-cd59-4ef4-88d2-036c90614e1f"},{"content":{"abbreviation":null,"annotations":[],"description":null,"eventType":"AddMetricEvent","title":""},"createdAt":"2023-08-01T14:00:55Z","entityUuid":"57e10d6d-426c-41ef-8038-ab08de2afac0","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"2a2b5633-5d50-46b9-a3d2-0911185a5938"},{"content":{"abbreviation":{"changed":true,"value":"A"},"annotations":{"changed":false},"description":{"changed":true,"value":"The Accessibility metric describes how well the access to the database is described and how easy it is to implement. The score associated with an answer will be higher if it makes it easier for humans and computers to get to the data. This is determined by e.g. the protocol for accessing the data or for authenticating users, and also by the guaranteed longevity of the repository. Note that this is different from the Openness metric!"},"eventType":"EditMetricEvent","title":{"changed":true,"value":"Accessibility"}},"createdAt":"2023-08-01T14:00:56Z","entityUuid":"57e10d6d-426c-41ef-8038-ab08de2afac0","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"a9e7621d-6fa0-495a-acef-86bbab443f5c"},{"content":{"abbreviation":null,"annotations":[],"description":null,"eventType":"AddMetricEvent","title":""},"createdAt":"2023-08-01T14:00:57Z","entityUuid":"1062814f-adb7-4c26-888f-f0fe4e055886","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"6c8e2900-8577-4720-a6da-d24f26d885d2"},{"content":{"abbreviation":{"changed":true,"value":"R"},"annotations":{"changed":false},"description":{"changed":true,"value":"The Reusability metric describes how well the data is suitable for reuse in other context. The score associated with an answer will be higher if it makes it easier for humans and computers to reuse the data. This is influenced largely by proper description of how the data was obtained, and also by the conditions that are put on the reuse (license and, for personally identifying information, consent)."},"eventType":"EditMetricEvent","title":{"changed":true,"value":"Reusability"}},"createdAt":"2023-08-01T14:00:58Z","entityUuid":"1062814f-adb7-4c26-888f-f0fe4e055886","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"ded3fd24-abdd-4b91-8bd6-90315fea8078"},{"content":{"abbreviation":null,"annotations":[],"description":null,"eventType":"AddMetricEvent","title":""},"createdAt":"2023-08-01T14:00:59Z","entityUuid":"7b19c975-9514-45a2-9088-4d2ac2215fa3","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"f3e4261f-27d8-4185-ae1a-b900cce5fc09"},{"content":{"eventType":"DeleteMetricEvent"},"createdAt":"2023-08-01T14:01:00Z","entityUuid":"7b19c975-9514-45a2-9088-4d2ac2215fa3","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"150c7052-6db4-4e7c-9fac-c73c43666e8a"},{"content":{"abbreviation":null,"annotations":[],"description":null,"eventType":"AddMetricEvent","title":""},"createdAt":"2023-08-01T14:01:01Z","entityUuid":"c82b1060-a2fa-4017-ac61-e53a4a8125a5","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"6c5cb2ef-0e65-417b-a8a2-9cba1cb81763"},{"content":{"abbreviation":{"changed":true,"value":"I"},"annotations":{"changed":false},"description":{"changed":true,"value":"The Interoperability metric describes how well the data interoperates with other data. The score associated with an answer will be higher if it makes it easier for humans and computers to couple the data with other data and 'understand' relationships. This is influenced by the use of standard ontologies for different fields and proper descriptions of the relations. It is also influenced by proper standard metadata that is agreed by the community."},"eventType":"EditMetricEvent","title":{"changed":true,"value":"Interoperability"}},"createdAt":"2023-08-01T14:01:02Z","entityUuid":"c82b1060-a2fa-4017-ac61-e53a4a8125a5","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"f67f034d-b4b3-4d64-af68-431fd6792c46"},{"content":{"annotations":{"changed":false},"chapterUuids":{"changed":false},"e