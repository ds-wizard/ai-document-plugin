ertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"65ba276b-3e3b-4c45-9b69-2dab2bd66452"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:20:12Z","entityUuid":"f8ef967b-3a65-4558-9228-2ef46d035445","parentUuid":"234de210-bad6-4551-b96c-24b1d56a4272","uuid":"0d4482c6-a538-4772-8f40-74efcfbfd0ae"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"ca36a6ee-245b-441f-91bf-3aa8b15126f7"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:13Z","entityUuid":"fb49fdeb-3b11-49ba-a87c-0aa1ae278d46","parentUuid":"caa6f175-2ac9-454b-9f56-14e272332a6f","uuid":"52ed73bf-7857-4a96-b657-76c64312cdcd"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"ca36a6ee-245b-441f-91bf-3aa8b15126f7"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:14Z","entityUuid":"fb4ffda1-4bda-4c88-bdb3-219237d05a4a","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"3e9dd94e-9f9c-4d98-87fa-95a0d1f40d48"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"b6e1554b-18f3-47c1-bec2-83f62ca60bd3"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:15Z","entityUuid":"fbb61a9f-8f83-4742-b976-a7e3e8ec6c75","parentUuid":"0fed0061-5fbe-4776-98d6-a73a98310997","uuid":"23f84443-e1b7-462b-ae46-d54c1b2f482d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"ca36a6ee-245b-441f-91bf-3aa8b15126f7"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:16Z","entityUuid":"fd94f449-9646-4828-aca7-ab5c2c9bca1d","parentUuid":"a2454f7d-69d0-4c44-bceb-17e34aa48fe6","uuid":"bb4b34ac-dba4-4789-9a1b-cad6f3d47465"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"ca36a6ee-245b-441f-91bf-3aa8b15126f7"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:17Z","entityUuid":"fda5df56-bb70-4bae-9594-afa9b665ede7","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"7ce2d61f-2189-4f4c-a964-50e64e6f87db"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":true,"value":"ca36a6ee-245b-441f-91bf-3aa8b15126f7"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:18Z","entityUuid":"fe4619ab-1488-4535-b1fe-64e756bc0f6c","parentUuid":"907eea55-34af-4011-a782-172fca8290da","uuid":"ba0d6e4a-4141-4a1d-b3e9-ba7f529f27d0"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"For projects involving data collection from subjects, it must be ensured the subjects can exercise all their rights."},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:19Z","entityUuid":"fb4ffda1-4bda-4c88-bdb3-219237d05a4a","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"bbcde760-5f8e-43c2-b278-92c8b0d84bc7"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Is the identifier of your physical sample present in the metadata for the digital data that associates to it? Will you be able to locate the physical sample if you have the digital data? And how about the reverse?"},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:20Z","entityUuid":"cfe918a3-e0ea-44b1-8222-203269f2d56c","parentUuid":"f2967d52-1781-4b97-8514-96711e66a0b5","uuid":"57e66634-4028-4e54-bb61-9321d61b12d4"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Specify the name of the funder that you ask for funding for your project. If the funder is not present in the suggested list, please specify a complete URL to the funder web site."},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2023-08-01T14:20:21Z","entityUuid":"cb8a257d-9883-44b3-94f5-967a021fddd4","parentUuid":"fda5df56-bb70-4bae-9594-afa9b665ede7","uuid":"c1852890-e897-4c10-88a9-624bcda24df5"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Processing of certain categories of personal data is not allowed unless there are exemptions in law to allow this. Among these categories (“sensitive data”) are *“‘[...] data revealing racial or ethnic origin, [...] genetic data, [...] data concerning health’”*. Most types of personal data collected in biomedical research will fall under these categories. [Article 9](https://gdpr-info.eu/art-9-gdpr/) (2) lists a number of exemptions that apply, of which *consent* and *scientific research* are most likely to be relevant for research. Please consult with your Data Protection Officer of your organisation."},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:22Z","entityUuid":"caa6f175-2ac9-454b-9f56-14e272332a6f","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"c320191f-75b3-410b-8434-080aaca4b50c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Consider that users of a data set will need to be able to get access several years after the project is finished. The best way to arrange this is to put the responsibility for checking the rights to access the data with a fixed body in an organisation, a data access committee, rather than one of the investigators of the project."},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:23Z","entityUuid":"59a6ba36-15aa-4ef5-9e4e-113fbde53389","parentUuid":"d73c7c26-965a-4548-969e-37856d3cadab","uuid":"44315694-f890-440f-9ca3-2e2cb0c98674"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Roles in a project should be given as they are defined by [datacite](https://schema.datacite.org/meta/kernel-4.1/doc/DataCite-MetadataKernel_v4.1.pdf).\n\nYou should specify at least one \"Contact Person\". If your project has a work package for data management, identify the leader of that work package as \"Data Curator\"."},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:24Z","entityUuid":"53d10160-281c-4afe-bd78-8d370ed1cc09","parentUuid":"11ee0c25-3017-4bd2-949d-c97439dffcb2","uuid":"f3361c2b-bd0d-48d8-af19-aa6cb6ee5c7c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Plan time and budget for either documenting this data or for conversion to a well-described specific format.\n\nFormats like XLS or SQL are very flexible; they can be adapted to many different uses, and this makes them good for interoperability. However, their flexibility also makes that it is not immediately obvious from the file structure how it can be used. The data needs a proper *description* in order for others (or yourself at a later time) to be able to unambiguously understand what it contains."},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:25Z","entityUuid":"381db64f-0abc-4a70-b881-1880c35ef121","parentUuid":"f1e49a7e-5671-4e4f-b4dc-703a197fcb4f","uuid":"ca683122-6fd2-4429-9d31-ad57d6561970"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Where does the data come from? And who will need it? Sometimes the raw data is measured somewhere else than where the primary processing is taking place. In such cases the ingestion or transport of the primary data may take special planning. You also need to make sure that data is secure and that data integrity is guaranteed."},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:26Z","entityUuid":"30f6d09e-22cb-42a2-9e9e-ff5134c1db0e","parentUuid":"0fed0061-5fbe-4776-98d6-a73a98310997","uuid":"e39da4d7-4324-4de2-8dd3-f51bca779dba"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"It is important for re-users to know what consent items you asked exactly from participants.\n\nNote that the answers from participants is personal data that requires protection!"},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:27Z","entityUuid":"20f6cb57-bcd0-4cea-b539-72dcb3ca8990","parentUuid":"ed1898ba-2792-4cd2-a967-d5b152f4c558","uuid":"f5373cd1-ad2d-4f0c-8939-bd47995da45c"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The following legal bases are unlikely for processing personal data when doing research.\n\nThe meaning of the different options are as follows:\n* Fulfil contract: we require the processing in order to fulfil our contract with the data subjects.\n* Legitimate interest: data subjects all expect us to do this data processing because of who we are.\n* Vital interest: we need to do this to protect the vital interests of the data subject.\n* Legal requirement: we are legally obliged to do this data processing.\n"},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:28Z","entityUuid":"08fae6f7-2502-4195-9c80-ddd975aecb5f","parentUuid":"4792e5da-292c-4ad0-acdd-691c266b9333","uuid":"f0505e53-e613-4d01-b5b3-ce0436f6a2a9"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Project number is a unique number assigned to the project by the authority that is undertaking the project."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:20:29Z","entityUuid":"79dc637a-5e00-45a1-8246-3c2bf4b615f6","parentUuid":"53dcdc1d-07d1-4392-b8e7-cbf2b5c0dc29","uuid":"650dad6e-1dad-44d5-b66b-fac177b78f52"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Do you know the data format of the reference data? Is this suitable for your work? Does it need to be converted?"},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:30Z","entityUuid":"77c6e91d-2f4c-4a00-a827-c325b26f9830","parentUuid":"dd84fcb8-a5fb-449c-b6cb-071260a439b9","uuid":"207eb32f-3e85-4463-9b60-0c6a49730b3a"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Specify an approximation of the expected data volume."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:20:31Z","entityUuid":"5e991741-6d9d-4f9a-a68a-83079031aa73","parentUuid":"dd84fcb8-a5fb-449c-b6cb-071260a439b9","uuid":"b672188f-60ba-495c-b5db-b9136e621fd4"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"You can use any name for the data set, make sure that it identifies the data set to yourself."},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:32Z","entityUuid":"fe4619ab-1488-4535-b1fe-64e756bc0f6c","parentUuid":"907eea55-34af-4011-a782-172fca8290da","uuid":"7f21ad53-a108-486f-9f05-89e957e5db12"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Specify what technical instruments you are using to collect the data."},"title":{"changed":false}},"createdAt":"2023-08-01T14:20:33Z","entityUuid":"b445defa-9a25-44af-bf10-44a65623ee9b","parentUuid":"0fed0061-5fbe-4776-98d6-a73a98310997","uuid":"ccd62db4-1cfa-4b9b-90d0-96975e16ba22"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"For optimum reusability data needs to be available for as long as possible. There may be financial reasons why you can't keep the data any longer; there may be legal, contractual or regulatory reasons requiring you to delete the data."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2023-08-01T14:20:34Z","entityUuid":"ebc03028-def1-4c9f-a997-b33aa7885f14","parentUuid":"6236ea54-2ee5-40ce-8054-243ec44d7b37","uuid":"3f38dcdd-61c8-4414-881a-ffb88a370c76"},{"content":{"annotations":[],"eventType":"AddResourceCollectionEvent","title":""},"createdAt":"2023-08-01T14:20:35Z","entityUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"b6e15756-0ce9-47f1-940a-ecb362843570"},{"content":{"annotations":{"changed":false},"eventType":"EditResourceCollectionEvent","resourcePageUuids":{"changed":false},"title":{"changed":true,"value":"Data Stewardship Guidance"}},"createdAt":"2023-08-01T14:20:36Z","entityUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"a755481e-4458-492d-a8f7-e4e476ac54b6"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:37Z","entityUuid":"adfc3718-e733-4c00-862c-a45eff39e825","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"4bd6cca1-d218-4ca8-81e3-4654dd2f957f"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Reference data is trusted information used to help interpret new data. It comes in many forms, like curated resources (e.g., UniProt, PDB) or standard datasets (e.g., a human genome reference or Twitter trends). These help you compare your data to established benchmarks.\n\n## Why use it?\nReference data is crucial for interpreting large datasets or even smaller ones, like clinical samples. Many core resources, such as those from ELIXIR, are constantly updated. When using these, ensure they have clear versioning, provenance, and transparent methods.\n\n## Key Tips:\n- Explore relevant reference data for your research.\n- Check the credibility and authority of your sources.\n- Record the version of the reference data you use to ensure reproducibility.\n- Consider downloading and archiving the data you reference.\n## Avoid:\n- Limit your search to obvious sources—explore beyond your field.\n- Assume all reference data is correct.\n- Use non-authorized data if better alternatives exist.\n- Use data without proper citation or version tracking."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Will you use Reference Data?"}},"createdAt":"2023-08-01T14:20:38Z","entityUuid":"adfc3718-e733-4c00-862c-a45eff39e825","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"963d0269-3597-472a-8854-f5eedc82c4c2"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:39Z","entityUuid":"b81b0811-5901-4b05-b251-46ea5f7ab5aa","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"752374ca-9ee1-40ff-912d-a7dc99834782"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"When you create new data, the intellectual property (IP) usually belongs to you or your organization, unless stated otherwise by your funding source. However, for data involving human subjects, the legal ownership typically remains with the individuals who provided the data, and you act as a custodian. This responsibility extends to managing the data properly, especially when creating reference datasets by extracting, transforming, or curating existing data. The IP and licenses of the original data sources are critical and can vary across regions. The licenses from source data may also apply to your new dataset, potentially limiting how it can be used or shared.\n\n## Key Tips:\n- Always verify the IP and licensing of all data sources you plan to use.\n- Even if a dataset seems public, check for hidden restrictions or licensing issues.\n- Ensure the data sources you use have handled IP properly.\n- Contact data owners if you're unsure about their licensing.\n- Seek advice from legal and licensing experts to avoid breaking any rules.\n## Avoid:\n- Don’t create reference data without first consulting a licensing expert.\n- Don’t skip these checks, even if you think only your team will use the data.\n- Don’t underestimate how critical IP issues are, especially if industries may want to use your data.\n- Don’t choose a license for your data without professional guidance; aim for the most open license possible to encourage broader use and sustainability."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"What will the intellectual property be like?"}},"createdAt":"2023-08-01T14:20:40Z","entityUuid":"b81b0811-5901-4b05-b251-46ea5f7ab5aa","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"9288f3fa-bd59-40f7-acbf-123e58be584c"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:41Z","entityUuid":"c1bdf514-78d2-4468-81c6-1854309906ee","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"86c6d3e6-4289-4727-96c1-0813dd8c4ce3"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"As a data steward, it's important to avoid holding onto data beyond its usefulness. Not all data needs to be stored or published indefinitely, especially with large datasets where storage can be expensive. The first step is deciding which parts of your data must be kept long-term. Some files, like intermediate formats, might be safely discarded early on, while others can be compressed to save space without losing important information. For example, you might choose to keep only the variations from a reference genome, rather than the entire dataset.\n\nSometimes archived data becomes unusable due to corruption, outdated formats, or errors. In these cases, it's important to dispose of the data but retain the metadata and identifiers, so the original data can still be traced or referenced.\n\n## Key Tips:\n- Develop a long-term data management plan with your team.\n- Schedule regular reviews of your data's relevance and storage needs.\n- Ensure metadata and identifiers remain available, even if data is deleted.\n- Transfer stewardship responsibilities clearly if handing data over to another party.\n## Avoid:\n- Confuse \"not used\" with \"not reusable\" — valuable data can become important unexpectedly.\n- Delete data, code, or tools without team discussion.\n- Keep clearly corrupted or obsolete data, even if storage isn't a problem."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"How long does the data need to be kept?"}},"createdAt":"2023-08-01T14:20:42Z","entityUuid":"c1bdf514-78d2-4468-81c6-1854309906ee","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"ae45e07f-74ba-45d4-be2f-dfefa05122b7"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:43Z","entityUuid":"a321e9cb-d70f-49a9-acb7-7cd57059e7b4","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"fd9b5bfd-7b52-43f7-9587-4e0ddae8a4b6"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"In today's world, there's a growing debate about distributed trust and computing, including in science and technology. The rise of blockchain, bitcoin, and other solutions has shifted the way we think about local vs. distributed computing. For any study, large or small, it's essential to consider whether you need local computing power or can rely on distributed systems. From smartphones to supercomputers, computing options are varied, and it’s no longer necessary to handle big jobs centrally or within firewalls, even with sensitive data. The cloud, essentially \"other people’s computers,\" is a viable option for many tasks, though local computing might still make sense in some cases. However, don’t invest in expensive local infrastructure just for control if external options are better and cheaper.\n\nThe key question is how much computing power you need directly associated with your data. Consider your network speed and whether you’ll send large data sets or use smaller workflow containers that process data where it resides. More and more, distributed computing can handle scientific tasks efficiently, and overburdening your institution with local hardware and software may be unnecessary and costly.\n\n## Key Tips:\n- Explore cloud-based storage and computing options carefully.\n- Compare different cloud providers for cost, service, and security.\n- Confirm you're allowed to send data externally before doing so.\n- Weigh cloud costs against maintaining local infrastructure.\n- Consider risks like maintenance, support, and future upgrades for local setups.\n- Tailor your computing solution to the specific needs of each project.\n## Avoid:\n- Assume in-house computing is the default without strong reasons.\n- Overestimate the amount of computing power or storage you’ll need.\n- Treat all computing jobs as requiring on-site processing.\n- Confuse large-scale computing challenges with the need for large local infrastructure."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Do you need the storage close to compute capacity?"}},"createdAt":"2023-08-01T14:20:44Z","entityUuid":"a321e9cb-d70f-49a9-acb7-7cd57059e7b4","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"db3d6bf6-05bd-4c49-ba0e-2131ead9a37c"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:45Z","entityUuid":"51eb18c7-51d5-495d-aa34-b1787a12a05e","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"c97f7522-398d-4c85-acdf-cd1d1531c84b"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Some OPEDAS (Open Public or External Data Assets and Sources) may require explicit consent from the owner for use, and their assistance might be necessary. This doesn't mean the data are poorly documented or low quality. They may be restricted by privacy laws, linked to a biobank, or involve personal data. If you need the owner's cooperation, consider time, co-authorship, and informed consent.\n## Key Tips:\n- Check access conditions and contact the owner.\n- Clearly explain why you need the data and how you'll use it.\n- Ensure your explanation is understandable for the owner.\n- Confirm any restrictions with the owner, even those not listed in the metadata.\n- Verify how long the owner will maintain the data in its current format.\n## Avoid:\n- Assume all OPEDAS owners are willing to share their data for any purpose.\n- Underestimate the effort required from the owner.\n- Overlook non-citation incentives, like acknowledgments or co-authorship.\n- Use data from the web without ensuring you follow informed consent and legal rules."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Will owners of that data work with you on this project?"}},"createdAt":"2023-08-01T14:20:46Z","entityUuid":"51eb18c7-51d5-495d-aa34-b1787a12a05e","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"86e395af-7d96-49c4-b0f6-3efa1be619e9"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:47Z","entityUuid":"eed6dc25-d18c-411e-9af6-d1722a4bac71","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"0c5d3b54-5b50-49be-aa2b-577cd80752b0"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"In some cases, it may be cheaper and acceptable to regenerate data rather than store it long-term. For example, re-sequencing a genome could become cheaper than storing it for 10 years, or text mining a large corpus could yield the same results when repeated. However, this decision isn't straightforward. Technology might change, and the original tools or data (like a genome or text corpus) may no longer be available or identical. Re-sequencing may give different results due to factors like somatic mutations or sample changes. So, deciding between regenerating or storing data requires a thorough scientific discussion.\n\n## Key Tips:\n- Carefully consider the problem, including domain-specific factors, before deciding to regenerate data.\n- Opt for regeneration only if long-term storage is costly or challenging.\n- Keep clear records of whether data is truly identical or regenerated from the same methods.\n## Avoid:\n- Assume data can be easily regenerated without understanding the science behind it.\n- Re-generate data and archive it under the same identifier as the original, assuming there will be no differences."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Can the original data be regenerated?"}},"createdAt":"2023-08-01T14:20:48Z","entityUuid":"eed6dc25-d18c-411e-9af6-d1722a4bac71","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"1a58d8a3-3d31-4eef-84b0-8b615c3a2f72"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:49Z","entityUuid":"1eb5829e-5526-4931-9ea7-a34f654c14ea","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"9061c5ae-002b-4102-b1fe-2a4b6fc686e7"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"For machines, it's crucial that the format and structure of data are clearly defined for reuse. When data types, formats, and individual elements are understandable, machines can easily process and transform the data with minimal errors.\n\nIncluding detailed information about format, structure, and terminology in your metadata is essential. While perfectly formatted data may be processed without this information, it’s not best practice to leave machines guessing about the data’s meaning. Explore existing projects that focus on data provenance and metadata recommendations to ensure your metadata is well-structured and informative.\n\n## Key Tips:\n- Learn about established metadata formats.\n- Keep your metadata and data formats simple.\n- Use existing libraries and catalogs for data types and formats.\n- Provide rich metadata, including details on format, structure, size, and terminology used.\n## Avoid:\n- Use non-standard data formats unless absolutely necessary.\n- Assume your data is structured enough to require minimal metadata. Effective metadata is essential for discoverability and reuse."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"How will you describe your data format?"}},"createdAt":"2023-08-01T14:20:50Z","entityUuid":"1eb5829e-5526-4931-9ea7-a34f654c14ea","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"1c35a136-03a4-41d7-a9a8-cafdbcccf2d6"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:51Z","entityUuid":"9bf46cb4-ac38-435d-afbc-c54a2dcd0acd","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"be260323-b974-4e4a-821d-3ff61e2eeea4"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Many data sets, especially reference resources, come in different formats. For example, core life sciences resources like UniProt and HPA now offer their data in machine-readable (FAIR) formats. It’s important to understand these formats, their limitations, and any licensing restrictions that may affect how you can reuse the data. Even openly accessible data may have usage limitations.\n\n## Key Tips:\n- Check the available data formats from the sources you plan to use.\n- Choose the format that best fits your analysis needs.\n- If the needed format isn’t available, reach out to the resource owner to see if it can be provided.\n## Avoid:\n- Use suboptimal data formats without checking if better options exist.\n- Use data without confirming that the format and restrictions won’t affect your analysis or publishing.\n- Use data meant for academic purposes if you plan to leverage the results for commercial innovation."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"What format?"}},"createdAt":"2023-08-01T14:20:52Z","entityUuid":"9bf46cb4-ac38-435d-afbc-c54a2dcd0acd","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"91f2ede6-7134-4754-8aaf-425f1944bd48"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:53Z","entityUuid":"46abb1cf-8619-4d59-8c31-5b840f473acc","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"b2d28842-ec10-4a1d-b491-b76dd3554c5c"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"A biobank is any collection of biological samples, often gathered for research. When dealing with human samples, ethical and privacy concerns make stewardship crucial. While tissue samples can be considered a form of data, we’ll focus on the data stewardship aspects related to biobanks separately. Biobanking is generally well-organized, and more details can be found in the resources section. Importantly, the annotations and metadata for samples should follow FAIR principles.\n\nOften, broad metadata about a biobank can be open, while access to specific samples is restricted for privacy reasons.\n\n## Key Tips:\n- Check with experts at your institution to see if biobanks and related infrastructure already exist.\n- Consult professional biobank owners for optimal planning of infrastructure and curation efforts. Discuss potential support and co-publication opportunities with your supervisor.\n- Create a collection maintenance plan with your team, including versioning, release strategies, and customer support.\n- Get legal advice to ensure that providing samples and data is manageable from a legal standpoint.\n- Work with a professional infrastructure provider to handle the maintenance of reference samples and keep research separate from operational aspects.\n- Develop a strong sustainability plan.\n## Avoid:\n- Create a biobank with public funding and restrict access without a clear, justifiable reason. This could hurt your chances in future proposals.\n- Assume someone in your department will handle the long-term stewardship of your samples just because they seem valuable; many institutions lack incentives to support this.\n- Neglect to make both the annotations and broader metadata FAIR and machine-readable."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Will you be storing physical samples?"}},"createdAt":"2023-08-01T14:20:54Z","entityUuid":"46abb1cf-8619-4d59-8c31-5b840f473acc","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"a7f1e941-5ea1-4903-add6-d2e5e9afca5d"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:55Z","entityUuid":"c2d0ad3a-0917-478f-8f1a-5968733740b0","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"71609245-b5c1-43e6-8eb8-3ff2966021e1"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"If you're creating a new type of data, standard formats might not be available. However, existing formats or a mix of them could still work well. Using established formats is usually better than making something entirely new. It's a good idea to collaborate with communities that focus on data-related issues.\n\n## Key Tips:\n- Explore existing formats and vocabularies, including those from other fields, to see if they fit your data.\n- Combine existing elements if there's no clear best practice.\n- Consult experts in similar data types to ensure you cover all bases.\n## Avoid:\n- Create a new data format without thoroughly checking what’s already available.\n- Develop new data types without consulting experts in related fields."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Will you be using new types of data?"}},"createdAt":"2023-08-01T14:20:56Z","entityUuid":"c2d0ad3a-0917-478f-8f1a-5968733740b0","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"9fd63a52-9336-48bc-9362-2af4209f17e8"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:57Z","entityUuid":"ebddb0c3-7271-4d84-8b64-9c50218f4fe4","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"cd9c6657-51d6-4668-a09c-1a6346ab12eb"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Unless you’re doing completely new research, there are likely many data formats that can capture and process your data. Some formats might be rare or outdated, making them hard to find, use, and share. This is especially important if you plan to integrate your data with other sources. Converting proprietary or unusual formats into more common ones can be tricky and error-prone, so it’s vital to consult experts to get your data in the best format for analysis and reuse.\n\n## Key Tips:\n- Use widely accepted and sustainable data formats whenever you can.\n- Ask experts for advice on the best formats for your data.\n- Be ready to explain how your data will be used and what workflows they’ll go through.\n- Choose formats that allow for detailed information, making it easier to add data later.\n## Avoid:\n- Assume your data is so unique that it needs a completely new format.\n- Rely on spreadsheets with free text labels or personal databases as your main storage method.\n- Store data without including rich metadata and clear provenance.\n- Dispose of the original data unless you’re sure it’s no longer needed, as it could impact publication and reuse opportunities."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Are you using data types used by others too?"}},"createdAt":"2023-08-01T14:20:58Z","entityUuid":"ebddb0c3-7271-4d84-8b64-9c50218f4fe4","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"5cddd547-ed6a-4468-92f7-b790f6edde09"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:20:59Z","entityUuid":"5f220e10-ca80-4a84-b93f-1a9fcc3f1a74","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"c24723f1-f39c-4ae4-b3f0-1c71eb8b4e2c"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Always think about how your data can be used beyond its original purpose. Reusing others’ data without permission can lead to ethical and legal issues. Assuming unlicensed data is free to use is risky and could result in legal trouble, especially in industries like pharmaceuticals. When you publish data or any digital object, it’s important to define a license for reuse. There are many licenses for software, and more are being developed for data. Each license should have a Persistent Identifier (PID) and a URI for easy reference in metadata.\n\nFor example, if you include data that can’t be used commercially, this might limit the use of your entire analysis for commercial purposes. Not licensing your data, even if you’re okay with any use, can hurt its reuse and lower citation rates.\n\n## Key Tips:\n- Choose a clear license for your data when you publish.\n- Include the license’s PID in your metadata.\n- Make the license easy to find in Open Access environments, even if the data isn’t fully accessible yet.\n- Ensure you can enforce the license, as enforcement is usually handled at the institutional level.\n## Avoid:\n- Publish data without a license or choose one without considering reuse.\n- Use a license that can’t be transferred with subsets of your data, but ensure it’s not overly restrictive.\n- Choose a complicated license with too many clauses; stick to widely accepted ones.\n- Limit reuse of your data more than necessary, especially if it’s publicly funded. The default should be open access unless there are strong reasons to restrict it.\n- Opt out of Open Data lightly. Most public funding agencies prefer open data as a default, and limiting access can hurt your chances for grants. Only restrict data reuse if absolutely necessary, and clearly explain why in your stewardship plan."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Will you store licenses with the data?"}},"createdAt":"2023-08-01T14:21:00Z","entityUuid":"5f220e10-ca80-4a84-b93f-1a9fcc3f1a74","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"da0de62a-a200-4285-86fc-d91e08838b61"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:01Z","entityUuid":"e7cc9f33-dadc-4f00-b060-039868e2a90f","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"e69ec5e0-b193-4394-9da0-19f06cff0f02"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"If you're thinking about using machine-readable data from the literature, consider whether you should mine it yourself or if there are existing collections available. Many groups specialize in text mining and provide their results in FAIR format. Unless you’re part of a text mining team, recreating that quality on your own can be very challenging.\n\n## Key Tips:\n- Look for pre-mined data collections that are in machine-readable formats.\n- Treat these collections as OPEDAS (see previous sections) and reach out to the owners, usually text mining experts, to discuss the data's quality.\n- Ensure the output data is in the right format and weigh the options between mapping data to different terms or re-mining it with expert help.\n## Avoid:\n- Assume that computers can accurately read text; they often produce unclear results due to language complexities.\n- Use text-mined data without understanding the challenges of converting human-readable text into machine-readable formats.\n- Attempt text mining with basic tools; this can waste time. Instead, consult with experts and collaborate."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Will you need to add data from literature?"}},"createdAt":"2023-08-01T14:21:02Z","entityUuid":"e7cc9f33-dadc-4f00-b060-039868e2a90f","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"66a80bd3-2f63-4250-94fc-4bef7d27f3b9"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:03Z","entityUuid":"bd7da171-debc-41f1-b2a5-67b757801142","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"b6a0f9e0-3230-4322-8e34-a68a7b756991"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Core reference resources often have versions that get updated. Static datasets from individual experiments can also change over time. When planning your study, consider how updates to Other Peoples Existing Data And Services (OPEDAS) resources or workflows might affect your data analysis. Key questions include: If the source is updated, will you need to re-analyze your data? What detail level do you need, and will updates impact that? If you only need part of the data, can you filter it before downloading?\n\n## Key Tips:\n- Check the versioning policies of the OPEDAS source and think about the consequences.\n- Decide which version to use for your analysis.\n- Plan how to handle updates when they occur.\n- If you want to use a specific version, ensure you have access to it.\n- If the source doesn’t freeze versions, download, store, and document the version you need.\n- Record and publish which version you used in your analysis.\n- Subscribe to updates if possible, to stay informed.\n- If the update policy isn’t clear, investigate the actual situation.\n## Avoid:\n- Use versioned OPEDAS sources without noting the version and setting up a routine for updates.\n- Assume the OPEDAS owner or repository has a proper versioning policy unless it’s clearly stated.\n- Publish results without referencing the exact version of the OPEDAS resources used.\n- Make claims in your research that could make your OPEDAS references unclear or outdated for others."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Is the data resource versioned?"}},"createdAt":"2023-08-01T14:21:04Z","entityUuid":"bd7da171-debc-41f1-b2a5-67b757801142","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"8053d7a6-c258-4ef8-a8a2-e3a34f5ce487"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:05Z","entityUuid":"c95a499e-8176-454c-94cd-47ec434e2ca1","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"89593d59-c827-476d-a759-c06b49a7e949"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"If, after a thorough search, you find no suitable terminology system, you might need to create a new one—but only as a last resort. Before starting, reach out to the stewards of existing terminology systems to see if they can expand their systems to include the concepts you need. This can help increase the visibility and adoption of your terms.\n\nIf that doesn't work, start by making a simple list of the terms you need. Define each term clearly and add synonyms, including translations if relevant. Choose a persistent identifier approach to give each term a machine-readable ID. Lastly, ensure that the definitions can be located using a URI.\n\n## Key Tips:\n- Exhaust all options with existing terminology systems before creating a new one.\n- Collaborate with others facing similar issues to avoid duplicate efforts. There are forums and communities working on standards.\n- Keep it simple and open, and announce your efforts widely to prevent redundant projects.\n- If you need to create an ontology, ensure that the relationships (predicates) are clearly defined, so that each connection is well-structured.\n## Avoid:\n- Start an ontology from scratch; first, make a simple list of needed concepts.\n- Create a thesaurus with hierarchical relationships unless absolutely necessary.\n- Add relationships without clearly defining the concepts involved.\n- Assume you can capture every nuance of reality in an ontology; different perspectives will always exist."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Do you need to develop new terminology systems?"}},"createdAt":"2023-08-01T14:21:06Z","entityUuid":"c95a499e-8176-454c-94cd-47ec434e2ca1","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"4429d267-4633-43a2-a8d0-a01ed124ae91"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:07Z","entityUuid":"bfba2ec9-1efa-4276-abfc-0610cc7eb656","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"3b4af900-ef18-48e8-9531-c6e3818c22f5"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Both metadata and data can change, sometimes unexpectedly. Storing data electronically doesn’t guarantee it will stay intact. Data might become corrupted, and formats may eventually be unreadable. Additionally, some data is not static; for example, sample annotations may need updating if the sample changes. It's crucial to monitor data integrity and version updates. Good data management also includes noting when data is outdated or unusable and communicating this to users.\n\n## Key Tips:\n- Store metadata in multiple locations and keep track of all versions.\n- Maintain detailed logs of any changes to data or samples after they’re archived.\n- Record all actions affecting physical samples so users know which version they have.\n- Use a FAIR-compliant format for metadata and implement strict version control.\n- Make multiple copies of data but keep clear records of their locations and integrity.\n- Keep master lists and metadata closely linked to the original data.\n- Assign specific team members to monitor data integrity regularly.\n## Avoid:\n- Assume data will remain unchanged over time without careful management.\n- Leave data unattended for long periods, risking corruption or misuse.\n- Allow data to be reused without proper licensing to protect its integrity.\n- Dispose of data without retaining the original identifier, so its history remains accessible."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Did you consider how to monitor data Integrity?"}},"createdAt":"2023-08-01T14:21:08Z","entityUuid":"bfba2ec9-1efa-4276-abfc-0610cc7eb656","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"959eec7a-2ffd-4357-8c8f-38f84334783a"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:09Z","entityUuid":"94263e9e-8d76-45cd-878c-eed5644c7b6b","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"8a4fcf66-eaf8-4263-80b7-a69a1eea89c7"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Always think about how your data might be used in the future. Unlike web documents, other people's data isn’t easily indexed, making many datasets hard to find. Even well-known resources like the Human Protein Atlas are overlooked by many researchers. The variety of metadata and data formats complicates the development of effective search engines. If all metadata followed FAIR principles, it would be much easier to find and reuse data. So, it's important to format your metadata according to FAIR guidelines.\n\n## Key Tips:\n- Link all concepts in your metadata (like instruments and contributors) to community-approved terminology.\n- Use a FAIR-compliant format for your metadata.\n- Store and share metadata in Open Access environments so search engines can easily find it, even if the data itself is restricted.\n## Avoid:\n- Create non-FAIR metadata and expect search engines to find your data anyway.\n- Make FAIR metadata but store it where search engines can’t easily access it (like offline or behind firewalls).\n- Keep metadata too minimal to give users (or machines) a clear understanding of what data is available.\n- Assume that users will figure out your dataset’s contents with just a few hints; always aim for clarity."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"How will you be storing Metadata?"}},"createdAt":"2023-08-01T14:21:10Z","entityUuid":"94263e9e-8d76-45cd-878c-eed5644c7b6b","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"dc1103cc-9cc5-47fc-87e1-2c6d9c4118e7"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:11Z","entityUuid":"6abff959-997c-4ff1-8b35-c0f67ca5d8e7","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"b8ec1360-4e00-4233-9d9d-8c669569e2c6"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Data can change over time. Not only do curated databases get updated regularly, but errors may also be fixed, like correcting misplaced values. It's crucial to document any changes made after the initial capture and to back up the updated data. This record should allow for tracing back to the original data, even if it was later deemed inappropriate. Reviewers should be able to see why conclusions were changed.\n\n## Key Tips:\n- Back up both old and new versions of your data.\n- Keep detailed records of all changes made after the initial generation.\n- Explain why data were modified, cleaned, or curated, and ensure workflows know which version to use.\n- Assign a new PID to each updated dataset.\n## Avoid:\n- Change recorded data without notifying the original data owner.\n- Make any corrections without documenting the change.\n- Alter data without preserving both the old and new versions along with their metadata and backups."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"If your data changes over time, how frequently do you do backups?"}},"createdAt":"2023-08-01T14:21:12Z","entityUuid":"6abff959-997c-4ff1-8b35-c0f67ca5d8e7","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"b895d978-5317-40a5-8b0f-c4142ee94ded"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:13Z","entityUuid":"b874f383-7d63-4cf5-a9fb-d298ce93e431","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"146a89e3-b116-4f19-968c-c52f2437cc60"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:14Z","entityUuid":"72577401-9947-4de5-8032-4aa48d1e1fb5","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"915acc86-56b8-44cd-91ac-23f9fcf1c1c2"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"There’s a big difference between 'offline' archives (with online FAIR metadata) and online data archives that are ready for reuse. It’s better to call an 'archive' a place where data is offline and can be retrieved on demand based on FAIR metadata, while 'high performance reusability' (HPR) environments keep data ready for frequent access. HPR requires more resources for bandwidth, uptime, and support.\n\n## Key Tips:\n- Distinguish between offline archiving for request-based reuse and HPR environments.\n- Understand that HPR can be much more expensive than offline archiving.\n- Budget appropriately for either option after your experiments.\n- Consider that users may need 24/7 access to the data, which may exceed academic capabilities.\n## Avoid:\n- Store data in long-term HPR environments unless you expect heavy reuse.\n- Think you can just place data online for others to download without taking on stewardship responsibilities.\n- Assume your group can act as a local HPR node without clear roles and support. Budget for transferring your data to a trusted repository or HPR environment."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Re-use considerations: Will the archive need to be online?"}},"createdAt":"2023-08-01T14:21:15Z","entityUuid":"72577401-9947-4de5-8032-4aa48d1e1fb5","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"f77103f8-f0bc-484f-9f34-82ae6c5ae1d1"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:16Z","entityUuid":"17ea64bf-4a2a-40c0-ac47-13da8fe2c3ae","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"790759fb-5529-451c-8b08-2412c115d7dc"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Digital objects can decay and become unreadable over time, much faster than printed materials. Just try reading a floppy disk! As technology evolves, older data formats can become obsolete, making it hard to access files even from just a few decades ago. For large datasets, especially those not suited for PDF formats, it’s crucial to have a long-term plan for regular checks on readability and usability.\n\n## Key Tips:\n- Create a long-term sustainability and reuse plan for each dataset with your team.\n- Budget for regular reviews of all datasets you manage.\n- Clearly transfer plans and responsibilities to any trusted third party overseeing your data.\n- Ensure that metadata and unique identifiers remain FAIR, even if data is archived or deleted.\n## Avoid:\n- Confuse reusability with actual reuse; valuable data can go unused for years and then become critical.\n- Dispose of data, metadata, code, or tools without team discussion. Determining when data is no longer needed can be tricky.\n- Keep corrupted or obsolete data, even if there are no storage costs, if it’s clear they’re no longer useful."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Will the data be understandable after a long time?"}},"createdAt":"2023-08-01T14:21:17Z","entityUuid":"17ea64bf-4a2a-40c0-ac47-13da8fe2c3ae","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"abfee074-94bf-4190-8933-1a6c8b0890a5"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:18Z","entityUuid":"90d55278-9128-4086-8174-025dc7d7ca63","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"3842d05b-fd38-491a-9d48-c2d73fcd0181"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Open Access is often linked to early scholarly communication through academic journals and supplementary data. Over time, this system became problematic: researchers could publish for free, but readers still had to pay. Now, Open Access means authors pay a fee, allowing free reading, but this model doesn’t fully support Open Science. Authors from less funded institutions may struggle to pay, and while there’s more content available, it can be harder to find the data that’s essential for Open Science. Publishing data independently in Open Access is crucial, and we must distinguish between metadata and the actual data.\n\nMetadata for any research object should be FAIR and Open Access. While there are valid reasons to restrict access to some data—like patient privacy or competitive advantage—publicly funded data should generally be open. Justifying restricted access requires strong arguments in your data stewardship plan. FAIR metadata help your data fit into the Open Science ecosystem.\n\n## Key Tips:\n- Identify whether each dataset is publicly or privately funded.\n- Assume metadata should always be FAIR, with Open Access as the default.\n- Work with your team to choose the best license for each dataset.\n- Include any restrictions in your data stewardship plan early on. Most funders prefer Open by default, so be prepared to justify any restrictions.\n- Use Open Source software while maintaining professionalism, versioning, documentation, and support.\n- Make your software open source under a clear license, but consider sustainability to ensure reproducibility.\n## Avoid:\n- Think data or software without a license is 'open' or 'reusable'; it’s not. Companies won’t engage without clear licensing.\n- Use overly restrictive licenses unless absolutely necessary for privacy, security, or sustainability.\n- Claim data is 'Open' and 'reusable' unless it’s actually Findable, Accessible, and Interoperable. If any of these are missing, it’s not truly reusable.\n- Publish data or software without proper citation information and instructions."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"How much will be Open data/access?"}},"createdAt":"2023-08-01T14:21:19Z","entityUuid":"90d55278-9128-4086-8174-025dc7d7ca63","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"4417c9d0-fb8d-4290-8ab2-fa03c87dae2d"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:20Z","entityUuid":"3ccbc5e8-85bc-4785-ae64-53c653d4f718","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"a6102a5f-cfc7-4eb0-b3cf-b10a9d9ed647"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Only the active version of a dataset needs to be in a High Performance Reusability (HPR) environment. Backups can be in different formats, like tape. If the HPR version is lost or corrupted, you must be able to quickly regenerate it without errors. Clearly document the location and access procedures for backups in your institutional catalog, making it easy for others to understand.\n\n## Key Tips:\n- Archive backups in the most stable and cost-effective format.\n- Include metadata and provenance for the backup data in the active dataset’s metadata.\n- Provide clear instructions on how to find and restore archived data if needed.\n- Regularly check the integrity of the data in HPR and document any regeneration.\n## Avoid:\n- Assume it’s enough for you to know where the backups are.\n- Treat a backup as just a simple copy of the entire HPR environment; it requires much more effort and cost.\n- Archive everything indiscriminately; carefully decide what needs to be archived, especially as data sizes grow."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"How and where will you be Archiving/Cataloging?"}},"createdAt":"2023-08-01T14:21:21Z","entityUuid":"3ccbc5e8-85bc-4785-ae64-53c653d4f718","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"0b277cbf-ef1a-444d-9e6e-134fa50b1fef"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:22Z","entityUuid":"e96e5ccf-c9fd-4f2a-97d8-415b2708f4a0","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"17173955-fb03-4c97-a63b-6e9a5d2a2fdf"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"For a long time, experiments have started with collecting or creating data. In social sciences and humanities, reusing existing data, like survey results or social media content, is becoming more common. However, in many hard sciences, generating new data to answer specific questions remains standard. We need to rethink whether creating new data is necessary, especially as more reusable datasets become available. Often, there are existing datasets—*Other Peoples Existing Data And Services* (OPEDAS)—that could help answer our questions or support our own findings.\n\n## Key Tips:\n- Look for reusable datasets (OPEDAS) that can reduce the need for new data.\n- Include curated databases and annotated collections in your search.\n- Check the accessibility and licensing of the datasets you find.\n- Ensure the datasets can work with your analysis tools; if not, you may need to modify them.\n- Make sure using OPEDAS won’t limit your ability to use your results later, especially regarding copyright and intellectual property.\n- Know how to cite and acknowledge OPEDAS.\n- Consider collaborating with OPEDAS owners to maximize the data's usefulness.\n- Talk to colleagues who have done similar research to discover useful OPEDAS.\n## Avoid:\n- Assume there are no OPEDAS without a thorough search.\n- Begin an experiment without consulting colleagues about available OPEDAS.\n- Budget for new data generation without justifying it to funders.\n- Start experimentation without consulting a data expert."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Is there pre-existing data?"}},"createdAt":"2023-08-01T14:21:23Z","entityUuid":"e96e5ccf-c9fd-4f2a-97d8-415b2708f4a0","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"1a7f112e-f9b3-488e-8916-67c7f41d866d"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:24Z","entityUuid":"f39ddfe2-1285-414a-af62-731622c1e304","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"24d9f9ab-c4c4-4ecb-a89a-c5687d7dc7bc"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Long-term archiving and preservation are different from short-term data use right after it's created. Even for short-term use, data should be stored and backed up in multiple secure locations.\n\nWhen deciding to keep data for a long time, the challenges increase. Access and usage conditions may change over time, so it’s important to plan for these issues and include them in your data stewardship plan during the experiment design.\n## Key Tips:\n- Consider data \"long-term reusable unless...\" It’s easy to think that data is only useful to the people who generated it, but even if you believe the data won’t be useful later, it should still be accessible for others, including reviewers.\n- Always keep the persistent identifier (PID) for the dataset available. Even if the data is no longer useful, it should still be traceable if it was ever cited.\n- Regularly update the dataset’s metadata to track its status over time. Create an explanatory file to describe what the data was and why it was taken offline if you stop preserving it.\n## Avoid:\n- Assume long-term preservation can wait. Don’t disrupt IT with urgent requests when the data turns out to be valuable.\n- Store any dataset without a registered PID (like a DOI).\n- Delay getting a PID until after preservation; make it routine when generating data.\n- Let data change without ensuring it remains findable and accessible."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Will you be archiving data for long term preservation?"}},"createdAt":"2023-08-01T14:21:25Z","entityUuid":"f39ddfe2-1285-414a-af62-731622c1e304","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"6a25fd9c-cf99-476e-8b6c-946d83917477"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:26Z","entityUuid":"7a8cc811-1bcd-4519-a997-465828d0c0e4","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"6d058088-edd9-4f03-94e6-6462007b5f7c"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Case reports come from various fields like medicine, biodiversity, and law enforcement. They’re often seen by creators as routine records rather than research data. However, researchers later use these reports to find patterns and trends.\n\nThese reports can be raw and imperfect data. Issues like text mining and human interpretation can introduce errors. It’s important to prepare your team for these variances and minimize them whenever possible. For example, have a clear strategy to handle ambiguous language in case reports and map everything to standard terms before analysis. Whenever ambiguities could affect results, try to get feedback from the original creators. Track how human interpretation varies and document any text mining processes in your metadata. Errors can also arise from mislabeling concepts through text mining, so monitor this closely.\n\n## Key Tips:\n- Educate the team about potential errors in interpreting case reports.\n- Study and document how human interpretation varies in your project.\n- Develop clear plans to correct and normalize known variations in your analysis.\n## Avoid:\n- Treat case reports created without research intent as equivalent to carefully designed research data.\n- Assume two people will interpret the same unstructured text the same way.\n- Underestimate the ambiguity in human-created text. Writers often use synonyms, jargon, and acronyms that can confuse others.\n- Think that machine interpretation of text, images, or audio is flawless. You need many checks to reduce errors from machine analysis."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Case report forms?"}},"createdAt":"2023-08-01T14:21:27Z","entityUuid":"7a8cc811-1bcd-4519-a997-465828d0c0e4","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"0c93a116-ad1e-4502-998d-5b7dfbfdfd8d"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:28Z","entityUuid":"2867c3c3-8604-4c93-9770-34f2a0860083","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"4cdc964f-ec16-4ade-a7db-986cd7e20f96"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Many data collection methods don’t just involve instruments. You can’t follow researchers collecting water or soil samples, or observe pathologists taking tissue samples. However, understanding how human factors, like interviewing or surgical procedures, can affect the data is crucial for a good data steward. Just as machines need regular calibration, different researchers might introduce biases during data collection. It's vital to keep track of who collected what data and under what conditions.\n\n## Key Tips:\n- Be aware of how data is collected by humans in variable circumstances and set up ways to spot and correct any unintended differences.\n- Discuss data concerns with your team and ensure everyone understands the importance of following standard procedures and recording any unusual events during data collection.\n- Keep all records of how data was captured and processed, even after it’s been cleaned, for future reference and to investigate any unexpected trends.\n## Avoid:\n- Treat the people and methods used for data collection as unimportant.\n- Leave it all to the experimental team and think of yourself only as a recipient of the data.\n- Discard any recorded data or metadata from the capture process without a strong reason."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Do you have non-equipment data capture? (questionnaires, free text etc.)"}},"createdAt":"2023-08-01T14:21:29Z","entityUuid":"2867c3c3-8604-4c93-9770-34f2a0860083","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"352f5cd6-d04c-44b3-9221-3ee7257c5a0d"},{"content":{"annotations":[],"content":"","eventType":"AddResourcePageEvent","title":""},"createdAt":"2023-08-01T14:21:30Z","entityUuid":"a0cea1c8-b6de-4346-8e2f-acbe4292073a","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"b54b6560-a228-492a-9a56-2126773c5b75"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"Workflows, especially complex ones, can be unstable unless proven otherwise. To check if a workflow is stable, run it regularly on standard reference data sets. If results differ, one of the components might not be working correctly or may have changed. Sometimes updates happen without notifying users, which can harm your research by introducing errors or inconsistencies. Therefore, when using a remote workflow after some time, verify that the results match what you got before.\n\n## Key Tips:\n- Keep stable reference data sets for each workflow you use.\n- Run these regularly to catch any changes before you need the workflow urgently.\n- Reach out to workflow providers to ensure they know you’re using their tools and request notifications for any changes or issues.\n## Avoid:\n- Re-run a workflow on new data without confirming its stability, even if it’s claimed to be stable.\n- Combine data from different times if workflows have changed, as this could lead to outliers that mess up your collection."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Verify repeatedly on the same data"}},"createdAt":"2023-08-01T14:21:31Z","entityUuid":"a0cea1c8-b6de-4346-8e2f-acbe4292073a","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"8df32718-7649-47c1-81fc-df3a6b55f6d6"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"adfc3718-e733-4c00-862c-a45eff39e825"}},"createdAt":"2023-08-01T14:21:32Z","entityUuid":"d61d9155-5f65-47a8-94cd-f316cddac087","parentUuid":"24b6d7a9-e036-4386-819b-697aec341c51","uuid":"027227a7-aff5-4f04-b35b-04faf337153c"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:21:33Z","entityUuid":"e72697fc-1793-4124-96b6-84c945a0bba5","parentUuid":"dd4b7293-969a-4870-8a0e-c3b459f71b22","uuid":"309f3961-048c-4d99-8eb5-f82ad3e8720c"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"b81b0811-5901-4b05-b251-46ea5f7ab5aa"}},"createdAt":"2023-08-01T14:21:34Z","entityUuid":"e72697fc-1793-4124-96b6-84c945a0bba5","parentUuid":"dd4b7293-969a-4870-8a0e-c3b459f71b22","uuid":"919ebd6c-cb6e-40be-b795-a14a31014410"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"c1bdf514-78d2-4468-81c6-1854309906ee"}},"createdAt":"2023-08-01T14:21:35Z","entityUuid":"95d0766f-acfb-4153-88b2-ebfa0e01edfe","parentUuid":"1106b428-5f6c-4312-ac22-43682e46f8be","uuid":"42c82258-7a6e-44ac-b53f-1eccdc074e94"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:21:36Z","entityUuid":"31f74f13-c662-4045-accc-8a27aa747e37","parentUuid":"cb785668-1d38-4efe-92f8-99b6a264bc71","uuid":"78d67796-06b3-45e1-a85b-32fdc9d8786c"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"a321e9cb-d70f-49a9-acb7-7cd57059e7b4"}},"createdAt":"2023-08-01T14:21:37Z","entityUuid":"31f74f13-c662-4045-accc-8a27aa747e37","parentUuid":"cb785668-1d38-4efe-92f8-99b6a264bc71","uuid":"a72a2855-4eb0-4ba6-859e-7104034252ae"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:21:38Z","entityUuid":"f246c4b8-2069-47b3-8d72-3e5e95939208","parentUuid":"9b73a03c-fae8-494a-a522-752f9fc13a78","uuid":"55bead2c-6e56-45e0-8453-60af966b2263"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"51eb18c7-51d5-495d-aa34-b1787a12a05e"}},"createdAt":"2023-08-01T14:21:39Z","entityUuid":"f246c4b8-2069-47b3-8d72-3e5e95939208","parentUuid":"9b73a03c-fae8-494a-a522-752f9fc13a78","uuid":"f19a1e2d-d67c-4555-bbda-f2801757fb95"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"eed6dc25-d18c-411e-9af6-d1722a4bac71"}},"createdAt":"2023-08-01T14:21:40Z","entityUuid":"ce91d4ae-2faa-4d1f-84ae-9c6bb3d2cdd3","parentUuid":"2650431a-1ca6-4e54-b320-72b19aa3bf68","uuid":"0ac32333-1288-4b88-80ae-8d2157e52a00"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"1eb5829e-5526-4931-9ea7-a34f654c14ea"}},"createdAt":"2023-08-01T14:21:41Z","entityUuid":"2f7b29b1-2239-4fa1-ae41-116dd05aac1b","parentUuid":"822cd13e-43ab-4209-afa4-1935bcca3888","uuid":"3df06ca6-4468-4be5-bcdd-92ff1f4a286d"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:21:42Z","entityUuid":"2a2b95d2-76b1-4fa3-aa30-4bb9b72eeddf","parentUuid":"77c