Type":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-12-03T09:44:36Z","entityUuid":"17a86a6e-660b-44ad-a912-1b1c1c10900f","parentUuid":"5a2fb6fa-034d-4e96-a1eb-2d0096432a52","uuid":"a76fa5e0-1dc4-410c-aa1d-998797cfab6e"},{"content":{"annotations":{"changed":false},"description":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"CrossReference","targetUuid":{"changed":true,"value":"11ee0c25-3017-4bd2-949d-c97439dffcb2"}},"createdAt":"2025-12-03T09:44:37Z","entityUuid":"17a86a6e-660b-44ad-a912-1b1c1c10900f","parentUuid":"5a2fb6fa-034d-4e96-a1eb-2d0096432a52","uuid":"a9b86a2b-5c5b-4720-bb81-912ae3780ca8"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-12-03T09:44:38Z","entityUuid":"b9aad7c8-9da6-4308-ae03-7f24a059adc5","parentUuid":"773fcf46-5db1-471a-bcf6-0799f7afc70b","uuid":"b52a93ac-f794-4593-8a56-70522548b06f"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"If the answer is positive, you should have specified the relevant ethical review details in this part"},"eventType":"EditReferenceEvent","referenceType":"CrossReference","targetUuid":{"changed":true,"value":"711300c0-39fb-4eb0-9baa-dd6d5aa77174"}},"createdAt":"2025-12-03T09:44:39Z","entityUuid":"b9aad7c8-9da6-4308-ae03-7f24a059adc5","parentUuid":"773fcf46-5db1-471a-bcf6-0799f7afc70b","uuid":"23d7ca5f-2937-446e-9097-5bf46e9af231"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please indicate whether the data collection involves elements—such as human subjects, sensitive information, or vulnerable populations—that require ethical approval under national law, institutional policies, or funder requirements. If so, describe the applicable review process and reference the relevant ethics committee or approval body.\n\nIf the answer is positive, you should have specified the relevant ethical review details under the \"Research Projects\" chapter describing policies (see relevant questions)."},"title":{"changed":false}},"createdAt":"2025-12-03T09:44:40Z","entityUuid":"773fcf46-5db1-471a-bcf6-0799f7afc70b","parentUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","uuid":"d78079b8-5548-4260-b0ac-3af7aae6cee7"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Ethical issues report link"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-12-03T09:44:41Z","entityUuid":"8ca6b819-e807-4089-9fbe-83fdfef1e73d","parentUuid":"40aafe08-4231-4dfa-90ea-33b52bcbb421","uuid":"bbc4579f-7eab-4df1-8cad-5322eb12ec58"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"fileTypes":{"changed":false},"maxSize":{"changed":false},"questionType":"FileQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Ethical issues report"}},"createdAt":"2025-12-03T09:44:42Z","entityUuid":"17a566ed-1c5f-4fb0-8ddf-f202b3dfb23f","parentUuid":"40aafe08-4231-4dfa-90ea-33b52bcbb421","uuid":"d7799b39-4857-4741-bef5-70432b95a163"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":false},"text":{"changed":true,"value":"This chapter describes the working environment and data handling approaches used throughout the project(s)."},"title":{"changed":false}},"createdAt":"2025-12-03T09:44:43Z","entityUuid":"9ff88aae-e06e-401e-a149-63f46a940c6e","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"0263b55c-b4bc-4745-ba17-94d52a50cba9"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please document each **distinct processing environment configuration and data handling workflow** as a **separate entry**.\n\nFor each entry, begin by specifying whether the described processing environment and data handling procedures apply to **all datasets**, only to **specific datasets**, or whether the workflow is **planned but not yet associated with any datasets**. If the procedures apply only to selected datasets, clearly indicate which datasets were processed within this specific environment or workflow.\n\nIf your project(s) involves only **one processing environment and data handling configuration**, complete a **single entry** that comprehensively describes the setup.\n\nPlease pay **close attention** to ensure that **all datasets** associated with your project are properly documented and linked to their corresponding processing environments and data handling workflows. This is essential for ensuring transparency, reproducibility, and methodological completeness.\n"},"title":{"changed":false}},"createdAt":"2025-12-03T09:44:44Z","entityUuid":"0c1a9598-f650-4bc7-8e77-3be540cf7774","parentUuid":"9ff88aae-e06e-401e-a149-63f46a940c6e","uuid":"b62f82e2-2ba4-4f91-b1ca-4a3a55b18d33"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"This choice indicates whether the described environment is just **planned for now or already applies to certain datasets**. If it's still only planned, it will be recorded in the DMP as a future approach. **As the project moves forward, you’ll need to specify which datasets it relates to as they are created and managed.**"},"title":{"changed":false}},"createdAt":"2025-12-03T09:44:45Z","entityUuid":"fcd569bb-c97d-463f-a288-f5402cdabd5a","parentUuid":"0c1a9598-f650-4bc7-8e77-3be540cf7774","uuid":"5be63c30-5f30-4266-87a0-69ab85a1b8f2"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-12-03T09:44:46Z","entityUuid":"a6f420a7-3853-448b-9cee-8825d284bf05","parentUuid":"16b97cc3-079e-4703-b740-18156cb9b0ba","uuid":"5ff26aef-16de-4b81-bdcf-6f4c017bb7b0"},{"content":{"annotations":{"changed":false},"description":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"CrossReference","targetUuid":{"changed":true,"value":"a7a67bd9-7912-4321-880e-7cf0355ce301"}},"createdAt":"2025-12-03T09:44:47Z","entityUuid":"a6f420a7-3853-448b-9cee-8825d284bf05","parentUuid":"16b97cc3-079e-4703-b740-18156cb9b0ba","uuid":"8ec1cf97-1509-4960-a7b7-a354a5619a7b"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2025-12-03T09:44:48Z","entityUuid":"50d419ab-d479-480a-9c65-a09dfcf183f9","parentUuid":"f42ad2ad-110e-4704-818e-697000dca96a","uuid":"947102a2-0d61-41b0-9271-f74014af798a"},{"content":{"annotations":{"changed":false},"description":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"CrossReference","targetUuid":{"changed":true,"value":"85cd1720-48bc-4cd4-ba23-1a5713efd4df"}},"createdAt":"2025-12-03T09:44:49Z","entityUuid":"50d419ab-d479-480a-9c65-a09dfcf183f9","parentUuid":"f42ad2ad-110e-4704-818e-697000dca96a","uuid":"e1be82a6-fb19-4a9b-9a6d-7411425e6233"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceTy