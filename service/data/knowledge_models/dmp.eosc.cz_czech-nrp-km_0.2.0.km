stion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"How will you do file naming?"}},"createdAt":"2023-08-01T13:52:10Z","entityUuid":"26532378-cfa7-49d7-a179-e437b6768c92","parentUuid":"afbfa2aa-314f-4277-94b0-68cb1b94a476","uuid":"cbce5e8b-04f2-4d4f-afb0-e3c9719d4ec1"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["6eecbc04-ad0c-4e4f-9dbd-a56326520508","26532378-cfa7-49d7-a179-e437b6768c92","2e070ab7-1ee4-49dc-88ab-58957aec186c","3847ebbe-247f-4a6f-aeb5-67dae49d5675","ed6cc751-a49c-4982-a385-fd62a69a0d90","1b98cbff-9917-4a20-864e-17335dd97042"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:52:11Z","entityUuid":"afbfa2aa-314f-4277-94b0-68cb1b94a476","parentUuid":"5260e661-f392-42f3-84d6-9790e57c7987","uuid":"97896e46-4146-485e-89a9-24d21e882fb7"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2023-08-01T13:52:12Z","entityUuid":"5449f4df-c28d-4293-8dda-2472da8bce48","parentUuid":"e8394dd5-4076-414a-bcc5-f1abd7a64be4","uuid":"835b9cd0-9f8f-40bb-b5d7-67e48f8aa25c"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:52:13Z","entityUuid":"c31b4e0f-a555-4012-bc8d-666fd147de57","parentUuid":"fbb17122-3bc9-4780-9f8a-bbb0986e4b17","uuid":"93085a6a-8d22-4753-9e2e-2f8f3bff009f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"It is not always clear to everyone in the project (and outside) what can and can not be done with a data set. It is helpful to associate each data set with a license as early as possible in the project. A data license should ideally be as free as possible: any restriction like 'only for non-commercial use' or 'attribution required' may reduce the reusability and thereby the number of citations. If possible, use a computer-readable and computer actionable license."},"title":{"changed":true,"value":"Will a license be assigned to the dataset?"}},"createdAt":"2023-08-01T13:52:14Z","entityUuid":"c31b4e0f-a555-4012-bc8d-666fd147de57","parentUuid":"fbb17122-3bc9-4780-9f8a-bbb0986e4b17","uuid":"c637a8f8-e07b-422b-ac17-2047ea0c5650"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:52:15Z","entityUuid":"0419c468-644c-4993-957d-c68b2c1eff3b","parentUuid":"c31b4e0f-a555-4012-bc8d-666fd147de57","uuid":"a48cd0f8-fd6e-418b-a7f0-e70f657fe098"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:52:16Z","entityUuid":"0419c468-644c-4993-957d-c68b2c1eff3b","parentUuid":"c31b4e0f-a555-4012-bc8d-666fd147de57","uuid":"ad35e830-0d13-464d-8ff3-9a964a3848a9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:52:17Z","entityUuid":"8ba89e3a-a4d5-470a-bd64-107c5c4b0b13","parentUuid":"c31b4e0f-a555-4012-bc8d-666fd147de57","uuid":"153258e5-c5dd-4d10-abc1-dd7c6e46c60d"},{"content":{"advice":{"changed":false},"annotations":{"cha