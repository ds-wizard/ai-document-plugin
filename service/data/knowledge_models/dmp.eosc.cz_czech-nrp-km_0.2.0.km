vent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"5f220e10-ca80-4a84-b93f-1a9fcc3f1a74"}},"createdAt":"2023-08-01T14:21:48Z","entityUuid":"2640334a-96ae-46a5-b7e9-ecc8fac99f2f","parentUuid":"8a75fe88-1e58-4d99-a913-b73bec48447d","uuid":"a86c2d29-0ab5-4021-965d-cc43bd07ec2d"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:21:49Z","entityUuid":"55fe52ba-23a9-4a93-b745-1275fd766304","parentUuid":"77c6e91d-2f4c-4a00-a827-c325b26f9830","uuid":"cde5e64a-5874-48e6-a219-3e2ff62d7c1f"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"e7cc9f33-dadc-4f00-b060-039868e2a90f"}},"createdAt":"2023-08-01T14:21:50Z","entityUuid":"55fe52ba-23a9-4a93-b745-1275fd766304","parentUuid":"77c6e91d-2f4c-4a00-a827-c325b26f9830","uuid":"bfbfca6f-6ce3-4fb1-8ab7-938dfc7976de"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"bd7da171-debc-41f1-b2a5-67b757801142"}},"createdAt":"2023-08-01T14:21:51Z","entityUuid":"9fb6e3b0-15cf-43ae-aa92-2783e8d31764","parentUuid":"c1de061e-b76b-452d-8ea9-21936a32ad18","uuid":"970f39c1-f33f-494b-a70d-95d61c920303"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"c95a499e-8176-454c-94cd-47ec434e2ca1"}},"createdAt":"2023-08-01T14:21:52Z","entityUuid":"d50f3cf4-862e-445e-b20c-7762f47cdd81","parentUuid":"6239418e-586b-49df-8c72-67cf2ed2182e","uuid":"976cf6ca-fc4a-44e6-8c2a-05f54aff2a94"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"bfba2ec9-1efa-4276-abfc-0610cc7eb656"}},"createdAt":"2023-08-01T14:21:53Z","entityUuid":"4262bac7-aa81-4311-809f-071fc501a071","parentUuid":"689a01b7-cf2f-47ff-a5c1-a88b49bf2a38","uuid":"0428c0d6-7bcd-4001-b037-0d4439596465"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:21:54Z","entityUuid":"ddb76455-082e-4c53-8594-bb9cbc1ef23a","parentUuid":"7bf4f392-0066-4af1-a619-cd3efa1d9ec8","uuid":"d4d8567d-15f6-42ae-9ed2-c0c0080572ed"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"94263e9e-8d76-45cd-878c-eed5644c7b6b"}},"createdAt":"2023-08-01T14:21:55Z","entityUuid":"ddb76455-082e-4c53-8594-bb9cbc1ef23a","parentUuid":"7bf4f392-0066-4af1-a619-cd3efa1d9ec8","uuid":"6099a5d8-8e31-4362-8c3b-787600f92747"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"6abff959-997c-4ff1-8b35-c0f67ca5d8e7"}},"createdAt":"2023-08-01T14:21:56Z","entityUuid":"85761e11-6598-4283-b0de-df7583031dda","parentUuid":"81289ed8-acb9-4dcb-8f84-7a8bead491d0","uuid":"73d9561b-4a26-4786-b8bd-5eeda182f5a2"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:21:57Z","entityUuid":"d526e3de-3122-4cb0-9a8d-b0e181aa8285","parentUuid":"24b6d7a9-e036-4386-819b-697aec341c51","uuid":"2a470e15-7b02-43a5-af3e-3edee60406f9"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"b874f383-7d63-4cf5-a9fb-d298ce93e431"}},"createdAt":"2023-08-01T14:21:58Z","entityUuid":"d526e3de-3122-4cb0-9a8d-b0e181aa8285","parentUuid":"24b6d7a9-e036-4386-819b-697aec341c51","uuid":"aa6ea0f9-a61d-4977-b330-5e98a6aed093"},{"content":{"annotations":{"changed":false},"content":{"changed":true,"value":"If some *Other Peoples Existing Data And Services* (OPEDAS) sources you want to use aren’t classified as 'reference data sets' or aren’t in reliable repositories, you need to answer some extra questions before reusing the data for your analysis.\n\n## Key Tips:\n- Check how to access the data.\n- Verify ownership.\n- Look for any restrictions (like commercial use).\n- Decide which version to use and consider all options discussed earlier.\n- Confirm with the owners how long they’ll keep the data in the same format and version.\n## Avoid:\n- Assume that data not stored in a trustworthy environment will be available later.\n- Use OPEDAS sources without tracking their origin.\n- Expect reproducible results unless you ensure stable input, including OPEDAS elements in your analysis."},"eventType":"EditResourcePageEvent","title":{"changed":true,"value":"Will you be using any existing (non-reference) data sets?"}},"createdAt":"2023-08-01T14:21:59Z","entityUuid":"b874f383-7d63-4cf5-a9fb-d298ce93e431","parentUuid":"463a8010-0f87-44e1-8089-49564ef4a1c8","uuid":"9d13d425-54cb-47a3-9dea-39d4a02a9695"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:22:00Z","entityUuid":"137c5e14-eb26-4f9e-92bc-8d8c8e5c92c3","parentUuid":"7379351f-f611-4897-b8a2-ecbf9713d037","uuid":"e7345c1d-2bcb-457f-91c5-80873f8a5035"},{"content":{"annotations":{"changed":false},"eventType":"EditReferenceEvent","referenceType":"ResourcePageReference","resourcePageUuid":{"changed":true,"value":"72577401-9947-4de5-8032-4aa48d1e1fb5"}},"createdAt":"2023-08-01T14:22:01Z","entityUuid":"137c5e14-eb26-4f9e-92bc-8d8c8e5c92c3","parentUuid":"7379351f-f611-4897-b8a2-ecbf9713d037","uuid":"d136ede4-3026-402e-b86b-a0fd70405d04"},{"content":{"annotations":[],"eventType":"AddReferenceEvent","label":"","referenceType":"URLReference","url":""},"createdAt":"2023-08-01T14:22:02Z","entityUuid":"cdc19c8a-83e3-467e-8d54-2c5ad192b43e","paren