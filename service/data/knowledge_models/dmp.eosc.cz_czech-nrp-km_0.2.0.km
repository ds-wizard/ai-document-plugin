s.io/badge/type-{{ item.types }}-blue)"},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":true,"value":"items"},"testQ":{"changed":false},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2023-08-01T13:35:26Z","entityUuid":"4fedbb49-bd9a-4f91-96a4-89db7f706d15","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"203ce325-0362-4133-b8da-a7033f58e41d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Controller"}},"createdAt":"2023-08-01T13:35:27Z","entityUuid":"2d75d561-fb2e-4a95-bfe3-7fafdb22a301","parentUuid":"945117a6-c199-44d6-bd47-22173bba122b","uuid":"bcfe8d81-dcf7-4292-ae7a-2baff51cd188"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:35:28Z","entityUuid":"96cb477b-955d-4f0f-b094-e4ee5cedc739","parentUuid":"2d75d561-fb2e-4a95-bfe3-7fafdb22a301","uuid":"7316196d-ce28-4f5f-9cb6-71143379dbc9"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":true,"value":"4fedbb49-bd9a-4f91-96a4-89db7f706d15"},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Organization"},"variables":{"changed":false}},"createdAt":"2023-08-01T13:35:29Z","entityUuid":"96cb477b-955d-4f0f-b094-e4ee5cedc739","parentUuid":"2d75d561-fb2e-4a95-bfe3-7fafdb22a301","uuid":"a22a9d58-dd82-45cc-8242-57646e2cd39d"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:35:30Z","entityUuid":"c8c512e3-22d6-4f0d-8dd2-48ae1dcc5760","parentUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","uuid":"a5fbda5f-4ee5-48ed-a501-ddbccaee0ff1"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The GDPR defines (sub)categories for personal data and expects data processors to be aware of and to document the categories of data that they process.\n\nStandard personal data  includes e.g. name, date of birth, address, (online) identifiers, contact info, account/personnel/customer or other ID numbers, appearance.\n\nSpecial  category data includes: data concerning health, Genetic data, racial or ethnic origin, sexual orientation, political opinions, religious or ideological convictions or trade union membership, criminal convictions and offences"},"title":{"changed":true,"value":"Under what GDPR category does the project data fall?"}},"createdAt":"2023-08-01T13:35:31Z","entityUuid":"c8c512e3-22d6-4f0d-8dd2-48ae1dcc5760","parentUuid":"c4384869-5ecf-4a85-9ffb-cb6d0f9771f1","uuid":"0fe5b021-1964-42ff-8670-14869726c083"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:35:32Z","entityUuid":"4e0af72b-6214-4f80-84d5-56945d5d74c5","parentUuid":"c8c512e3-22d6-4f0d-8dd2-48ae1dcc5760","uuid":"f0a7207c-a45b-46c5-a345-d38e7adeaca7"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Standard personal data"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:35:33Z","entityUuid":"4e0af72b-6214-4f80-84d5-56945d5d74c5","parentUuid":"c8c512e3-22d6-4f0d-8dd2-48ae1dcc5760","uuid":"cc3e1558-a315-4162-86fc-bcdea4a5df1d"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:35:34Z","entityUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","parentUuid":"c8c512e3-22d6-4f0d-8dd2-48ae1dcc5760","uuid":"cb82d860-0c41-4245-a839-2bd1072a39d6"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Special category data (plus optional additional standard personal data)"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:35:35Z","entityUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","parentUuid":"c8c512e3-22d6-4f0d-8dd2-48ae1dcc5760","uuid":"9fc09149-7848-4d21-9d2f-65acca43da8a"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:35:36Z","entityUuid":"a1557341-6909-44ab-a886-82082842d0f9","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"3e432000-83a1-475f-87ca-9ec3508e731c"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Which category?"}},"createdAt":"2023-08-01T13:35:37Z","entityUuid":"a1557341-6909-44ab-a886-82082842d0f9","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"dd112577-a807-468d-a46c-d31e1f023e54"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2023-08-01T13:35:38Z","entityUuid":"4a5a9075-f5ec-403d-bbbf-0348317f0d72","parentUuid":"a1557341-6909-44ab-a886-82082842d0f9","uui