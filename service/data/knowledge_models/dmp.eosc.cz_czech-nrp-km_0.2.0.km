 estimated amounts with the actual costs when they become available, for the next versions of your DMP.**"},"title":{"changed":false}},"createdAt":"2025-05-27T06:15:35Z","entityUuid":"f2b5ebb5-e672-4505-9c6c-421bab9e3be5","parentUuid":"1cf77bb6-6d27-4228-9feb-8a20ca572870","uuid":"9fd2f201-e229-4e55-b025-4432aaa1e584"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:15:36Z","entityUuid":"fdf6bd2a-5d8c-4fb3-a825-731743eaabb4","parentUuid":"842bdd9a-a044-4622-92f8-0b8f0f5b2088","uuid":"96bd77f7-4325-46f9-8e15-97412c0b69b2"},{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[{"key":"json.key","value":"parts"}]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Only parts of the dataset will be published"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:15:37Z","entityUuid":"fdf6bd2a-5d8c-4fb3-a825-731743eaabb4","parentUuid":"842bdd9a-a044-4622-92f8-0b8f0f5b2088","uuid":"8fde9192-9846-4de5-ab8f-07f737ca9915"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"fdf6bd2a-5d8c-4fb3-a825-731743eaabb4"},"createdAt":"2025-05-27T06:15:38Z","entityUuid":"d268a1a8-0831-4d03-995d-c385436e9ba9","parentUuid":"5d3cbc1b-e127-411c-9370-fcaf276bb4ae","uuid":"7d9367e9-cb82-4ef4-8f58-41df7eef5b62"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-05-27T06:15:39Z","entityUuid":"a7805ddf-f3ae-404a-8190-62cb6d7f1fb3","parentUuid":"b91d4cfb-5240-4ae8-8e08-fcfc47e66cc3","uuid":"49beff89-0e77-49b8-8ec7-7078eef7ff4a"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["0e014a15-fcaa-4236-be67-db635a75d6bb","fdf6bd2a-5d8c-4fb3-a825-731743eaabb4","b91d4cfb-5240-4ae8-8e08-fcfc47e66cc3"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed"