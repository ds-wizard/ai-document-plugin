4f0-c500-44c6-8870-26d1ce26620e"},{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"noPlannedPublishedReason"}]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-10-24T13:03:54Z","entityUuid":"5ec8a556-1237-4d96-81b5-abc89e5238c0","parentUuid":"0e014a15-fcaa-4236-be67-db635a75d6bb","uuid":"01b0a887-9f65-4be5-a4d6-5592c253cf28"},{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"partPublishedDescription"}]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-10-24T13:03:55Z","entityUuid":"d268a1a8-0831-4d03-995d-c385436e9ba9","parentUuid":"5e2639c4-69c0-4fe7-8684-1ca65b73ffdc","uuid":"124ff7c3-bb67-4a32-a4ff-163995ae7f85"},{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"isPublished"}]},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Has the dataset (or the relevant parts) already been published?"}},"createdAt":"2025-10-24T13:03:56Z","entityUuid":"ca06823e-a52e-434e-9490-3f63837f4944","parentUuid":"b91d4cfb-5240-4ae8-8e08-fcfc47e66cc3","uuid":"4eb5f868-aaff-46cd-bbdd-e34a777de9b3"}],"forkOfPackageId":null,"id":"dmp.eosc.cz:czech-nrp-km:0.1.7","kmId":"czech-nrp-km","license":"Apache-2.0","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"Data Management Planning KM","nonEditable":false,"organizationId":"dmp.eosc.cz","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dmp.eosc.cz:czech-nrp-km:0.1.6","readme":"# Data Management Planning KM\n\n*DSW Knowledge Model for Data Management Planning, tailored to the needs and specifics of the Czech National Repository Platform for Research Data.*\n\n## Maintainers\n\nResponsible for the overall management and development of the knowledge model, ensuring its continuous improvement, and overseeing contributions to maintain its integrity and relevance.\n\n* **Jana Martínková** \n  * [jana.martinkova@cvut.cz](mailto:jana.martinkova@cvut.cz)\n  * ORCID: [0000-0001-8575-6533](https://orcid.org/0000-0001-8575-6533)\n  * *Czech Technical University in Prague*\n* **Kryštof Komanec** \n  * [krystof.komanec@fit.cvut.cz](mailto:krystof.komanec@fit.cvut.cz)\n  * ORCID: [0000-0003-3856-1682](https://orcid.org/0000-0003-3856-1682) \n  * *Czech Technical University in Prague*\n\n## Contributors\n\nContribute to the knowledge model by adding new information, refining existing content, or providing insights to improve its quality and applicability.\n\n* **Marek Suchánek**, ORCID: [0000-0001-7525-9218](https://orcid.org/0000-0001-7525-9218), *Czech Technical University in Prague*\n* **Georgia Koutentaki**, ORCID: [0000-0002-8099-9963](https://orcid.org/0000-0002-8099-9963), *Czech Technical University in Prague*\n* **Michal Růžička**, ORCID: [0000-0001-5547-8720](https://orcid.org/0000-0001-5547-8720), *Masaryk University*,  (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Barbora Loskotová**, *Tomas Bata University in Zlín*, (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Antonín Zita**, ORCID: [0009-0002-1049-107X](\nhttps://orcid.org/0009-0002-1049-107X\n), *Masaryk University*, (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Marika Hrubá**, *Masaryk University*, (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Tereza Kolmačková**, *Library of the Czech Academy of Sciences*\n* **Jindřich Fejfar**, *Library of the Czech Academy of Sciences*\n* **Lucie Hošková**, ORCID: [0009-0001-9695-2342](https://orcid.org/0009-0001-9695-2342), *Charles University*\n* **Matěj Uchytil**, *Charles University*\n* **Anna Horecká**, *Charles University*\n\n## Acknowledgements\n\n| ![](https://dmp.eosc.cz/static/eu-msmt.svg) | This work is supported by the project National Repository Platform for Research Data no. [CZ.02.01.01/00/23_014/0008787](https://www.eosc.cz/en/projects/national-repository-platform-for-research-data-os-i-nrp/national-repository-platform). |\n|-------------------------------------|---|\n\n## Changelog\n\n### 0.1.7\n\n*Released*: 2025-11-11\n\n* Add support for tagging content (approaches and strategies) as \"planned\"\n* Add tag \"Science Europe\" to questions\n* General updates based on feedback from KA7 NRP project\n\n### 0.1.6\n\n*Released*: 2025-16-10\n\n* Add annotations for document templates\n* Add tag \"maDMP\" to questions\n* General updates based on feedback from KA7 NRP project\n* Add resource links to Data Management Expert Guide\n\n### 0.1.5\n\n*Released*: 2025-24-07\n\n* Add annotations for document templates\n* Add tag \"Horizon Europe template\" to questions\n* General updates based on feedback from KA7 NRP project\n\n### 0.1.4\n\n*Released*: 2025-21-05\n\n* Refine the \"Producing Data\" chapter\n* Add phases to questions\n* General updates based on feedback from KA7 NRP project\n\n### 0.1.3\n\n*Released*: 2025-08-04\n\n* Integrate License Selector tool\n\n### 0.1.2\n\n*Released*: 2025-25-03\n\n* Refine the wording and order of the questions\n* Add a question for uploading the Data Sharing Agreement and Preservation Statement documents\n* Add URL question for measuring instrument, Data Sharing Agreement and Preservation Statement\n\n### 0.1.1\n\n*Released*: 2025-05-03\n\n* Add structure and preparation for License Selector\n* Add standard protocol and SW documentation\n* Add ORCID validation\n* Add \"Creator of DMP\" to roles\n* Improve integrations (link in response)\n\n### 0.1.0\n\n*Released*: 2025-08-01\n\n* Initial version for testing and further development","version":"0.1.7"},{"createdAt":"2026-03-24T11:09:42.898171Z","description":"DMP tailored to Czech National Repository Platform for Research Data ","events":[{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"partPublishedDescription"}]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-12-03T09:39:32Z","entityUuid":"d268a1a8-0831-4d03-995d-c385436e9ba9","parentUuid":"5e2639c4-69c0-4fe7-8684-1ca65b73ffdc","uuid":"cb2076ab-4841-445e-89a6-816d24779ff7"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":false},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":false},"requestUrl":{"changed":false},"responseItemTemplate":{"changed":false},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":true,"value":"Czech"},"testResponse":{"changed":true,"value":{"request":{"body":null,"headers":[{"key":"Accept","value":"application/json"}],"method":"GET","url":"https://api.crossref.org/funders?query=Czech"},"response":{"body":"{\"status\":\"ok\",\"message-type\":\"funder-list\",\"message-version\":\"1.0.0\",\"message\":{\"items-per-pag