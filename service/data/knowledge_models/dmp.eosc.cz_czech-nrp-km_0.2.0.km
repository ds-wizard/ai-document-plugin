":{"changed":true,"value":"Complicated (binary) file formats tend to change over time, and software may not stay compatible with older versions. Also, some formats (e.g. DOC, XLS) hamper long-term usability by making use of patents or being hampered by restrictive licensing. \n\nIdeally a format should be simple, text only, completely described, not restricted by copyrights, and implemented in different software packages."},"title":{"changed":true,"value":"Does this data format enable sharing and long-term archiving?"}},"createdAt":"2023-08-01T14:29:10Z","entityUuid":"58e8fa76-a414-4c81-b115-d3d7c232e597","parentUuid":"f1e49a7e-5671-4e4f-b4dc-703a197fcb4f","uuid":"974817d8-1394-48c6-be37-c2f6c62c75ce"},{"content":{"allowCustomReply":true,"annotations":[],"eventType":"AddIntegrationEvent","integrationType":"ApiIntegration","name":"","requestAllowEmptySearch":true,"requestBody":"","requestHeaders":[],"requestMethod":"","requestUrl":"","responseItemTemplate":"","responseItemTemplateForSelection":null,"responseListField":null,"testQ":"","testResponse":null,"testVariables":{},"variables":[]},"createdAt":"2023-08-01T14:29:11Z","entityUuid":"f8e8428e-5af9-43f8-acbd-1ef51a0a9a79","parentUuid":"2563c25b-4c5c-4840-a3f4-09e5de5ded4f","uuid":"d6763139-a1b1-45a6-a2cd-c6f816a4de48"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":true,"value":"Licenses"},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":false},"requestHeaders":{"changed":false},"requestMethod":{"changed":true,"value":"GET"},"requestUrl":{"changed":true,"value":"https://integrations.ds-wizard.org/licenses?q=${q}&_sort=length_name"},"responseItemTemplate":{"changed":true,"value":"**{{item.name}}** ({{item.id}}) {{item.version}}"},"responseItemTemplateForSelection":{"changed":false},"responseListField":{"changed":false},"testQ":{"changed":false},"testResponse":{"changed":false},