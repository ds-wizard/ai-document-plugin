Yes"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T14:29:25Z","entityUuid":"6850ab91-6f7c-4b95-9d69-2fd4bcd1c4be","parentUuid":"2163fad6-227e-4e3f-96c3-2b8657c38fb1","uuid":"e074643e-0a19-4554-bf6b-f497476c5a1d"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T14:29:26Z","entityUuid":"94aa1007-8e26-4139-8a34-e3d7df6891fb","parentUuid":"6850ab91-6f7c-4b95-9d69-2fd4bcd1c4be","uuid":"be903a54-ac88-496d-a207-f806d8437b1b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What conditions?"}},"createdAt":"2023-08-01T14:29:27Z","entityUuid":"94aa1007-8e26-4139-8a34-e3d7df6891fb","parentUuid":"6850ab91-6f7c-4b95-9d69-2fd4bcd1c4be","uuid":"5e13d2b5-5d5c-4c35-be65-2152bf98215d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please summarise the restrictions. Note that it is a good idea to publish the final conditions for use of the data openly, so that interested researchers can know beforehand whether they will be able to get access to the data before actually placing a request."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2023-08-01T14:29:28Z","entityUuid":"94aa1007-8e26-4139-8a34-e3d7df6891fb","parentUuid":"6850ab91-6f7c-4b95-9d69-2fd4bcd1c4be","uuid":"fa611b3f-78c9-4cd1-8e13-5a796f107300"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T14:29:29Z","entityUuid":"1c6220d7-f744-43c3-9cc5-232f95a69321","parentUuid":"6850ab91-6f7c-4b95-9d69-2fd4bcd1c4be","uuid":"ac6cdbea-8390-4afc-8b3c-3edb81b309c8"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Consider that users of a data set will need to be able to get access several years after the project is finished. The best way to arrange this is to put the responsibility for checking the rights to access the data with a fixed body in an organisation, a data access committee, rather than one of the investigators of the project."},"title":{"changed":true,"value":"How will re-users be able to get access?"}},"createdAt":"2023-08-01T14:29:30Z","entityUuid":"1c6220d7-f744-43c3-9cc5-232f95a69321","parentUuid":"6850ab91-6f7c-4b95-9d69-2fd4bcd1c4be","uuid":"bf177c36-1d92-4e33-bf93-1dc85f98a6b2"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T14:29:31Z","entityUuid":"8275e136-871b-417e-85d8-607310f1d11d","parentUuid":"1c6220d7-f744-43c3-9cc5-232f95a69321","uuid":"69483d77-3ae3-430b-bad2-4619c1f3da0c"},{"content":{"advice":{"changed":true,"value":"Consider what will happen if the contact person moves jobs."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"By request to the contact person"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T14:29:32Z","entityUuid":"8275e136-871b-417e-85d8-607310f1d11d","parentUuid":"1c6220d7-f744-43c3-9cc5-232f95a69321","uuid":"55b865b9-7920-497c-9508-e6eaaa9d3ac3"},{"content":{"advic