":"0360d19c-5656-46f7-b241-8cb463e8cd3e","uuid":"f822afe0-48b1-4ae3-b070-4ce35e9ade26"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:43:53Z","entityUuid":"3e43ad44-e80a-4ab0-a062-157026849185","parentUuid":"8043dc47-43f8-4f61-a5c4-d30e129abe06","uuid":"d04f9d24-84f7-4b73-8a1d-c93f9494662d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:43:54Z","entityUuid":"3e43ad44-e80a-4ab0-a062-157026849185","parentUuid":"8043dc47-43f8-4f61-a5c4-d30e129abe06","uuid":"a385b472-bd77-454d-9d01-9a53bd45fbf1"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:43:55Z","entityUuid":"fc644db9-f52c-40fb-82b2-5e9c079cc066","parentUuid":"8043dc47-43f8-4f61-a5c4-d30e129abe06","uuid":"deee0498-2e1e-4c25-a449-10473543538d"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:43:56Z","entityUuid":"fc644db9-f52c-40fb-82b2-5e9c079cc066","parentUuid":"8043dc47-43f8-4f61-a5c4-d30e129abe06","uuid":"e4c695cb-ed49-4478-8c60-437ff41e8754"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:43:57Z","entityUuid":"449e1cc4-fb84-4bf8-b504-befe245d9684","parentUuid":"5222c57d-5c98-4ae3-ace8-b2b7e03f7b3a","uuid":"bb101801-643c-4c89-9b58-3bbb83946a99"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Different anonymization techniques exist. Disadvantage of anonymization is that data integration becomes virtually impossible, but it may be the only way to open up your data for other research."},"title":{"changed":true,"value":"Could anonymization be used to make the data more openly available?"}},"createdAt":"2023-08-01T13:43:58Z","entityUuid":"449e1cc4-fb84-4bf8-b504-befe245d9684","parentUuid":"5222c57d-5c98-4ae3-ace8-b2b7e03f7b3a","uuid":"d38b3826-60ee-47b4-9ace-982616747315"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:43:59Z","entityUuid":"1f067853-3fa8-4f43-8874-52fdb7a605ca","parentUuid":"449e1cc4-fb84-4bf8-b504-befe245d9684","uuid":"6141d687-cb33-4235-b423-c370265f9874"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:44:00Z","entityUuid":"1f067853-3fa8-4f43-8874-52fdb7a605ca","parentUuid":"449e1cc4-fb84-4bf8-b504-befe245d9684","uuid":"8ebf5450-e4a7-44f3-9992-2d2517c728ab"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:44:01Z","entityUuid":"691cffda-8d93-4073-a1ac-4213121781e5","parentUuid":"449e1cc4-fb84-4bf8-b504-befe245d9684","uuid":"b7776f74-3b3b-4c6a-9e0e-f1c6ef6109a9"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:44:02Z","entityUuid":"691cffda-8d93-4073-a1ac-4213121781e5","parentUuid":"449e1cc4-fb84-4bf8-b504-befe245d9684","uuid":"178b0234-e2b2-4635-9495-fe5da5e312cf"},{"content":{"annotations":[],"even