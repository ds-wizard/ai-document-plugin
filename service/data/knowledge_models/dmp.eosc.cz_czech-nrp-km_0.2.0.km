ment stores\". Examples are Amazon S3 and CEPH, or MongoDB."},"title":{"changed":true,"value":"Will you store data in an \"object store\" or a \"document store\" system?"}},"createdAt":"2023-08-01T13:51:30Z","entityUuid":"3847ebbe-247f-4a6f-aeb5-67dae49d5675","parentUuid":"afbfa2aa-314f-4277-94b0-68cb1b94a476","uuid":"02d2b720-a904-4b77-90eb-c7eda9a7469a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:51:31Z","entityUuid":"5526f9d9-7eb0-4bae-b3e9-4937104a5dcf","parentUuid":"3847ebbe-247f-4a6f-aeb5-67dae49d5675","uuid":"5ba6a8e4-e7e2-4f30-9210-f9c9d7a812ee"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:51:32Z","entityUuid":"5526f9d9-7eb0-4bae-b3e9-4937104a5dcf","parentUuid":"3847ebbe-247f-4a6f-aeb5-67dae49d5675","uuid":"f5df9fd7-eaa6-4a9e-8440-1a290b28ffc8"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:51:33Z","entityUuid":"be09f789-6c18-465f-b1c4-ae8945870f89","parentUuid":"3847ebbe-247f-4a6f-aeb5-67dae49d5675","uuid":"ffb8fbb0-8dc4-4cd2-93f7-c35628caa52b"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:51:34Z","entityUuid":"be09f789-6c18-465f-b1c4-ae8945870f89","parentUuid":"3847ebbe-247f-4a6f-aeb5-67dae49d5675","uuid":"41cfcf3f-8101-435a-9e1d-c8e0468ee4c2"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:51:35Z","entityUuid":"80135465-efe0-4a35-92b1-b18706d68630","parentUuid":"be09f789-6c18