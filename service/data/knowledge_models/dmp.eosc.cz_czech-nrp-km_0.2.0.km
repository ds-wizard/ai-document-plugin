"label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:46:28Z","entityUuid":"6511fad7-bba1-40be-ad3f-e2f4b74830cb","parentUuid":"1f9d37c3-be62-4f4d-86c4-3d4e24944548","uuid":"602e6c74-a2b0-41fd-9018-54e53dda9131"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:46:29Z","entityUuid":"6511fad7-bba1-40be-ad3f-e2f4b74830cb","parentUuid":"1f9d37c3-be62-4f4d-86c4-3d4e24944548","uuid":"d98bf762-12bc-4cd2-a785-ad4de7519cfe"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:46:30Z","entityUuid":"7d69adcf-1837-4b51-9eae-30c3c49f283e","parentUuid":"ae45e778-5059-4beb-90ff-b6ebdc30cb7f","uuid":"74a64fca-5a73-45e0-8715-a93f415ec1ef"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The file names are very useful as metadata for people involved in the project, but to computers they are just identifiers. To prevent accidents with e.g. renamed files metadata information should always also be available elsewhere and not only through the file name.\n\nAlso note that if metadata could need to change, embedding it in the file names may require renaming files during the project; and this may have implications for references to those files."},"title":{"changed":true,"value":"Will all the metadata that is embedded in the file names also be available in the proper metadata?"}},"createdAt":"2023-08-01T13:46:31Z","entityUuid":"7d69adcf-1837-4b51-9eae-30c3c49f283e","parentUuid":"ae45e778-5059-4beb-90ff-b6ebdc30cb7f","u