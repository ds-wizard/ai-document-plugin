e able to redo the strict minimum data handling?"},"title":{"changed":true,"value":"Will you monitor data integrity once it has been collected?"}},"createdAt":"2023-08-01T14:00:13Z","entityUuid":"689a01b7-cf2f-47ff-a5c1-a88b49bf2a38","parentUuid":"d1332925-ff50-45cc-bae3-4839019be645","uuid":"cda64fa2-6825-4cf9-8603-88fde6fe715a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T14:00:14Z","entityUuid":"e6dd0c48-1264-4b16-aceb-ee808c903649","parentUuid":"689a01b7-cf2f-47ff-a5c1-a88b49bf2a38","uuid":"bb630fab-fc56-4b2c-8a06-d123b3736035"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T14:00:15Z","entityUuid":"e6dd0c48-1264-4b16-aceb-ee808c903649","parentUuid":"689a01b7-cf2f-47ff-a5c1-a88b49bf2a38","uuid":"200f461d-837c-4216-a10a-14bb88368f54"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T14:00:16Z","entityUuid":"1e45aa1f-ed05-4f78-ab6e-b2dde3de6a18","parentUuid":"689a01b7-cf2f-47ff-a5c1-a88b49bf2a38","uuid":"4dc2a22e-3b5d-46be-9dbb-1fa8fb855c31"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T14:00:17Z","entityUuid":"1e45aa1f-ed05-4f78-ab6e-b2dde3de6a18","parentUuid":"689a01b7-cf2f-47ff-a5c1-a88b49bf2a38","uuid":"98a20a41-e88a-405b-ae9e-102777deb7ef"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T14:00:18Z","entityUuid":"868682bb-99f9-4f14-886f-96dabb8c551d","parentUuid":"1e45aa1f-ed05-4f78-ab6e-b2dde3de6a18","