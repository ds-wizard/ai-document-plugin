a4e-4375-b5cd-e030731b1ad6"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["28dc53ef-afbd-4d46-9a62-26ef41d7b863","c8c512e3-22d6-4f0d-8dd2-48ae1dcc5760","9b531bf1-ca5a-47cb-882f-3671001de1ba","67acb1fc-e363-40d8-a35c-356eb2595cfe","fb4ffda1-4bda-4c88-bdb3-219237d05a4a","24e59afc-fcc1-4b81-98b6-5e19071b9abb","c2aa59d6-a12f-4f6e-8df6-5d69e4b30057"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:21Z","entityUuid":"16c0e7dd-03cc-4ec8-9928-41d87631ddb3","parentUuid":"e98d3229-be0b-480b-8ce6-326d9cf5da89","uuid":"cc3cc1eb-d758-4fba-994f-c4defaaf4663"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-05-27T06:16:22Z","entityUuid":"64cdee01-7e3e-402b-863f-a78963b9030a","parentUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","uuid":"8890f8fa-1ed8-42e0-ad32-7d6448a74e15"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Under the GDPR, anonymization is considered a type of data processing because it involves modifying personal data. As such, you must have a valid legal basis not only for collecting and using personal data, but also for carrying out the **anonymization**.\n\nIn most cases, the legal basis used for the initial collection and processing of the data will also cover anonymization—**provided that it aligns with the original purpose** for which the data was collected. This reflects the GDPR’s purpose limitation principle, which requires that any further processing, including anonymization, must be compatible with the original purpose."},"title":{"changed":true,"value":"Does the legal basis for collecting and processing the personal data also cover the anonymization process?"}},"createdAt":"2025-05-27T06:16:23Z","entityUuid":"64cdee01-7e3e-402b-863f-a78963b9030a","parentUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","uuid":"3258747d-ca30-4e7a-9be7-5e591a2854a3"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:16:24Z","entityUuid":"c880e672-a36e-4bbe-86d9-ace6f37ab577","parentUuid":"64cdee01-7e3e-402b-863f-a78963b9030a","uuid":"57e7a671-c22b-4837-a6dd-570f14d18f65"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:25Z","entityUuid":"c880e672-a36e-4bbe-86d9-ace6f37ab577","parentUuid":"64cdee01-7e3e-402b-863f-a78963b9030a","uuid":"a91d2acb-7d62-4021-8819-0789308ee286"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:16:26Z","entityUuid":"cf6c0797-9aa7-48d4-a9f2-2686dc54b789","parentUuid":"64cdee01-7e3e-402b-863f-a78963b9030a","uuid":"0a3797d6-50e8-41ae-b4bb-6260b7e0a141"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:27Z","entityUuid":"cf6c0797-9aa7-48d4-a9f2-2686dc54b789","parentUuid":"64cdee01-7e3e-402b-863f-a78963b9030a","uuid":"e11c369a-a8fc-4398-b720-d657210edb7a"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-05-27T06:16:28Z","entityUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","parentUuid":"cf6c0797-9aa7-48d4-a9f2-2686dc54b789","uuid":"2af2832d-603c-4a85-808a-cc908447cdbd"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What is the legal base for anonymization?"}},"createdAt":"2025-05-27T06:16:29Z","entityUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","parentUuid":"cf6c0797-9aa7-48d4-a9f2-2686dc54b789","uuid":"6c955122-127d-4acf-8680-fef956564a26"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-05-27T06:16:30Z","entityUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","parentUuid":"cf6c0797-9aa7-48d4-a9f2-2686dc54b789","uuid":"6b59496b-c42b-43da-bcc8-ad6e2be9bbdf"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["64cdee01-7e3e-402b-863f-a78963b9030a","8b765c87-ea86-4e8c-b8d5-dda54b62045f","2d740019-041a-42cc-b4c4-fc612054fcf6"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:31Z","entityUuid":"24becfca-9173-4bfa-b9e0-20c8f445dc22","parentUuid":"24e59afc-fcc1-4b81-98b6-5e19071b9abb","uuid":"f9edb90c-c083-416c-9f66-412a8bc1f2d6"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"[Article 6](https://gdpr-info.eu/art-6-gdpr/) (1) lists under what conditions the processing is considered lawful. Of these, **Consent** or **Public** interest are relevant when it comes to research. You should determine what legal basis (or bases) you have for processing the personal data in your project. \n\nTraditionally, *consent* has been the basis for processing personal data for research, but under the GDPR there cannot be an imbalance between the processor and the data subject for it to be considered to be freely given. In some countries the use of *consent* as the legal basis for processing by universities for research purposes is therefore not recommended. In those cases, public interest should probably be your legal basis. Note that if your legal basis for processing is consent, [a number of requirements](https://gdpr-info.eu/issues/consent/) exists for the consent to be considered valid under the GDPR. Consents given before the GDPR might not live up to this. \n\nAlso note that even if *public interest* is the legal basis, other laws and research ethics standards might still require you to have consent from the subjects for performing the research.\n\nPlease consult with the Data Protection Officer of your organisation on which legal basis to apply to your data."},"title":{"changed":false}},"createdAt":"2025-05-27T06:16:32Z","entityUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","parentUuid":"cf6c0797-9aa7-48d4-a9f2-2686dc54b789","uuid":"17960f79-6b81-423a-b5b2-5fbb4193894a"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:16:33Z","entityUuid":"cb974c71-5567-4118-a148-125ab1058263","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"415ef553-ec0d-493e-beaf-bea34b8c1078"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Public interest"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:34Z","entityUuid":"cb974c71-5567-4118-a148-125ab1058263","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"d51425aa-d91a-4220-bcf7-ca13fa7b0ea7"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:16:35Z","entityUuid":"db3f10f6-fb96-4c63-bb61-9d81bdb395e0","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"53f7405f-223e-4d48-820f-4c9551b078b6"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We ask the data subjects for their consent"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:36Z","entityUuid":"db3f10f6-fb96-4c63-bb61-9d81bdb395e0","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"d14bf873-7514-4c36-82f3-627e1f43b9cc"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:16:37Z","entityUuid":"660b6a13-624a-42cc-982a-88ce22f07375","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"2a5c7938-eaa7-484c-a638-374a5a4e8f36"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Fulfil contract"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:38Z","entityUuid":"660b6a13-624a-42cc-982a-88ce22f07375","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"fe6b53e2-de71-4d82-86d3-fd626849d0f9"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:16:39Z","entityUuid":"8f397379-4529-4c65-9c30-4feb167e198b","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"58eb0abe-eac1-4598-9f12-7de7f87670d3"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Legitimate interest"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:40Z","entityUuid":"8f397379-4529-4c65-9c30-4feb167e198b","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"a6b12968-9d3d-41e9-a91e-f1fdbc173d39"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:16:41Z","entityUuid":"de832acb-4a70-47c8-a811-01e578cf5241","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"6bc4a057-fe98-4c20-ae2b-353a635e7d34"},{"content":{"advice":{"changed":false},"annotations":{"changed":true,"value":[]},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Other"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:42Z","entityUuid":"de832acb-4a70-47c8-a811-01e578cf5241","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"5b9ba1b2-6473-4b90-8255-405ea9b2b105"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-05-27T06:16:43Z","entityUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5","parentUuid":"de832acb-4a70-47c8-a811-01e578cf5241","uuid":"5aee3fee-660d-44dd-a0f3-7957519637c3"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Which other?"}},"createdAt":"2025-05-27T06:16:44Z","entityUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5","parentUuid":"de832acb-4a70-47c8-a811-01e578cf5241","uuid":"c4d02fb3-37be-49db-80c4-91e47c96ec96"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:16:45Z","entityUuid":"940c50e1-4ee7-4459-9956-11bbc0d3571e","parentUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5","uuid":"a4523bfb-2d97-4898-b761-e51ebcf9bf12"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Vital interest"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:46Z","entityUuid":"940c50e1-4ee7-4459-9956-11bbc0d3571e","parentUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5","uuid":"13bbe7e6-794b-4ee3-a47d-ac194523108e"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:16:47Z","entityUuid":"d72c9e68-ca77-413c-9c09-7610ee7b45ff","parentUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5","uuid":"e30ace03-0525-48b9-abfe-092e505bcc52"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Legal requirement"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:48Z","entityUuid":"d72c9e68-ca77-413c-9c09-7610ee7b45ff","parentUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5","uuid":"6d3798dc-85b2-4e8e-a6b5-b015cc9d2051"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2025-05-27T06:16:49Z","entityUuid":"aa9c0578-6785-4e74-b64f-53c92bbd8b97","parentUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5","uuid":"0bb41adb-5dc3-496b-9e3e-88d01301e2c8"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Public interest"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:50Z","entityUuid":"aa9c0578-6785-4e74-b64f-53c92bbd8b97","parentUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5","uuid":"58ac0b21-5526-4c3f-b713-b824a36e6e51"},{"content":{"eventType":"MoveAnswerEvent","targetUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5"},"createdAt":"2025-05-27T06:16:51Z","entityUuid":"660b6a13-624a-42cc-982a-88ce22f07375","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"5da253fa-d8e9-49c4-9ed8-9a61f7cb83d6"},{"content":{"eventType":"MoveAnswerEvent","targetUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5"},"createdAt":"2025-05-27T06:16:52Z","entityUuid":"8f397379-4529-4c65-9c30-4feb167e198b","parentUuid":"d2744bcf-9ded-4cfb-917d-91f293e37d13","uuid":"b26faa5b-4315-4455-917a-6ded2ae0c972"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["660b6a13-624a-42cc-982a-88ce22f07375","8f397379-4529-4c65-9c30-4feb167e198b","940c50e1-4ee7-4459-9956-11bbc0d3571e","d72c9e68-ca77-413c-9c09-7610ee7b45ff","aa9c0578-6785-4e74-b64f-53c92bbd8b97"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"The following legal bases are unlikely for processing personal data when doing research.\n\nThe meaning of the different options are as follows:\n* Fulfil contract: we require the processing in order to fulfil our contract with the data subjects.\n* Legitimate interest: data subjects all expect us to do this data processing because of who we are.\n* Vital interest: we need to do this to protect the vital interests of the data subject.\n* Legal requirement: we are legally obliged to do this data processing.\n"},"title":{"changed":false}},"createdAt":"2025-05-27T06:16:53Z","entityUuid":"41a4bcff-35be-4a86-a775-b915a929c0b5","parentUuid":"de832acb-4a70-47c8-a811-01e578cf5241","uuid":"b63c26b6-4ae4-4247-ab84-98900a636026"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We will obtain consent for both the use of personal data and its anonymization. The data will first be processed for our specific purposes, and then anonymized for unrestricted reuse."},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:54Z","entityUuid":"0fce2808-9724-43eb-a2cf-3b81119d0cd0","parentUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","uuid":"1bd7937d-c6e4-4169-9de7-066bc5938faf"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"We ask for consent for anonymization. The data will be anonymized before any further processing, which will be conducted exclusively on the resulting anonymous data."},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:16:55Z","entityUuid":"dc32559c-1de2-4af8-bfa2-0e0885254faa","parentUuid":"6fd66dc7-c108-4289-8bfb-c1113d16a9b1","uuid":"c2c859b1-d3d4-47c4-8f71-e0540e8b5e37"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Explain how data subjects will be informed and how data subject's requests will be handled.\n\nIn accordance with Art. 13 of the GDPR the data subjects must be informed about:\n- The **identity and contact details of the data controller**\n- The **contact details of the data protection officer** (if applicable)\n- The **purpose and legal basis** for the processing\n- The **type of personal data** being collected\n- The **recipients** or categories of recipients of the data (if any)\n- The **period** for which the data will be stored, or the criteria used to determine that period\n- The **rights of the data subject**, including the right to access, rectify, or erase their data, to restrict or object to processing, and the right to data portability\n- The **right to withdraw consent** at any time (if consent is the legal basis)\n- The **right to lodge a complaint** with a supervisory authority\n- Whether the provision of data is a **statutory or contractual requirement**, and the consequences of not providing it\n- The existence of any **automated decision-making**, including profiling, and meaningful information about how decisions are made and their consequences (if applicable)\n- Any **potential risks** associated with the data processing\n\nIf the processing operation is exempted from the right to information according to the GDPR, provide a justification.\n\nAlso, specify **where and how this information is made available** (e.g., privacy notice, participant information sheet), and reference the document that defines the **responsibilities for informing data subjects and handling their requests**.\n"},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-05-27T06:16:56Z","entityUuid":"67acb1fc-e363-40d8-a35c-356eb2595cfe","parentUuid":"16c0e7dd-03cc-4ec8-9928-41d87631ddb3","uuid":"58ec98ef-0f40-4964-aced-0b2396c1d282"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:16:57Z","entityUuid":"21f81003-3554-4026-9e58-c0431d3fa647","parentUuid":"a1557341-6909-44ab-a886-82082842d0f9","uuid":"df68d42c-eb53-4a1b-89f9-d586b5095ce7"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Biometric data"}},"createdAt":"2025-05-27T06:16:58Z","entityUuid":"21f81003-3554-4026-9e58-c0431d3fa647","parentUuid":"a1557341-6909-44ab-a886-82082842d0f9","uuid":"e088b052-ae6a-4520-b615-2d77559796f6"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":true,"value":["4a5a9075-f5ec-403d-bbbf-0348317f0d72","a9a40090-24b3-4ea0-a14b-1cd222d016ec","21f81003-3554-4026-9e58-c0431d3fa647","18eb4a55-27da-44b1-bc09-4a99575cfce7","5aef8392-0735-4442-ad35-c6c2dcbdbe88","cc2fd93a-8390-4307-b9ab-c318fe1a4518","37061479-9221-44b5-8ce1-de5a5efe0ce5"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-05-27T06:16:59Z","entityUuid":"a1557341-6909-44ab-a886-82082842d0f9","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"6762e94d-6063-4ab1-a4ff-6ff662635f3e"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"As a general rule, processing of special categories of personal data is prohibited under [Article 9](https://gdpr-info.eu/art-9-gdpr/) (1) GDPR, unless any of the exceptions listed in Art. 9(2) GDPR applies. These exceptions include consent and scientific research, which are two most relevant exceptions for research. If you are unsure about this, please consult with Data Protection Officer of your organization."},"title":{"changed":false}},"createdAt":"2025-05-27T06:17:00Z","entityUuid":"caa6f175-2ac9-454b-9f56-14e272332a6f","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"ae1ed2e3-1390-4d86-b08c-8d4495c70ebb"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"List the technical and procedural safeguards in place to protect the privacy of research subjects.\nYou may include safeguards outlined in [§ 16(1) of Act No. 110/2019 Coll.](https://uoou.gov.cz/en/legislation/act-no-1102019-coll) on the processing of personal data. If you apply any additional safeguards beyond those listed in the Act, please describe them in the following question."},"title":{"changed":false}},"createdAt":"2025-05-27T06:17:01Z","entityUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"e276680b-ae42-474b-8110-4d9366ffbb15"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:02Z","entityUuid":"e13d8c17-c7ae-470c-bdf3-5f617f4d0383","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"06b664d8-7527-4bff-aea1-4779175cbe67"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Technical and organisational measures aimed at a consistent application of the obligation pursuant to Art. 5 (1)(c) of Regulation (EU) 2016/679 of the European Parliament and of the Council"}},"createdAt":"2025-05-27T06:17:03Z","entityUuid":"e13d8c17-c7ae-470c-bdf3-5f617f4d0383","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"1cc21423-1558-4132-9b37-caf156380094"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:04Z","entityUuid":"0d58ee27-ebc7-4e0d-b040-a20a5648c058","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"e9bb0065-349b-426a-8f86-03af79ae743d"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Logging of at least all operations of collection, entering, alteration and erasure of personal data, which will make it possible to determine and verify the identity of the person performing the operation, and retaining such records for a period of at least 2 years from the operation"}},"createdAt":"2025-05-27T06:17:05Z","entityUuid":"0d58ee27-ebc7-4e0d-b040-a20a5648c058","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"71f289c9-fc82-4382-a224-5d1fe6ee4c26"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:06Z","entityUuid":"fc5c147a-e2c4-4295-ae76-efc051a3d7bc","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"9bf0b761-e1cb-4ad9-925f-50b2e453dba3"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Provision of information to persons who process personal data concerning obligations in the area of personal data protection"}},"createdAt":"2025-05-27T06:17:07Z","entityUuid":"fc5c147a-e2c4-4295-ae76-efc051a3d7bc","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"792cf90b-b316-43bd-a728-9c7adaafcb59"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:08Z","entityUuid":"4818d180-1bee-4121-b993-e00e548fc8db","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"0e516145-cbd9-43f0-9a0a-78dce4c7270b"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Designation of the data protection officer"}},"createdAt":"2025-05-27T06:17:09Z","entityUuid":"4818d180-1bee-4121-b993-e00e548fc8db","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"cc7fab8f-fab5-446a-88bf-56678af6c70d"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:10Z","entityUuid":"7ce1c209-8186-4b52-841a-62debfc4a53a","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"f7cbf5bf-49cf-49da-b813-2cc5dba5308b"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Special limitation of access to personal data at the controller or processor"}},"createdAt":"2025-05-27T06:17:11Z","entityUuid":"7ce1c209-8186-4b52-841a-62debfc4a53a","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"a679c97d-8cc5-409e-a7ed-b53a9ff7b7ff"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:12Z","entityUuid":"9402ebf8-55d7-45b8-819d-d321d5576046","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"489abacb-8bc0-47f5-b653-4fdc52968ecb"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Pseudonymisation of personal data"}},"createdAt":"2025-05-27T06:17:13Z","entityUuid":"9402ebf8-55d7-45b8-819d-d321d5576046","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"26f3ae6b-71af-41a9-ba15-e3a0e8c2618f"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:14Z","entityUuid":"74ea3707-7672-4188-9a4e-ba6619451f5a","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"923e7f2d-19e3-448c-b7fc-3ef4ef45df40"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Encryption of personal data"}},"createdAt":"2025-05-27T06:17:15Z","entityUuid":"74ea3707-7672-4188-9a4e-ba6619451f5a","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"52dfff74-4390-4dc4-bac9-ed26501a06c2"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:16Z","entityUuid":"a89256d3-90f7-4ef2-990c-ce762b17b4c4","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"967a9590-ad19-4a08-9d2c-19838a1486d7"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Measures for ensuring permanent confidentiality, integrity, availability and resilience of processing systems and services"}},"createdAt":"2025-05-27T06:17:17Z","entityUuid":"a89256d3-90f7-4ef2-990c-ce762b17b4c4","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"d2d1ca9d-82f9-4dd4-89ef-aca55e06a79e"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:18Z","entityUuid":"16a3add0-bc9d-4655-9f37-a3736441c6ac","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"dbc63219-0b13-4403-bb73-44da21da7d84"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Measures enabling restoration of the availability of and timely access to personal data in the event of an incident"}},"createdAt":"2025-05-27T06:17:19Z","entityUuid":"16a3add0-bc9d-4655-9f37-a3736441c6ac","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"206b7d39-0c88-41d8-9b8a-8061a31a9ade"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:20Z","entityUuid":"5f867e04-5b20-46d3-b767-cdc0b03dc3c0","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"2a989a5c-d1ef-42aa-a084-02d4e514b187"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Process for regularly testing, assessing and evaluating the effectiveness of technical and organisational measures for ensuring the security of the processing"}},"createdAt":"2025-05-27T06:17:21Z","entityUuid":"5f867e04-5b20-46d3-b767-cdc0b03dc3c0","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"d1527c04-4688-40bf-aad5-4a617e2102be"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:22Z","entityUuid":"d0d255da-265f-4fd4-b015-d5bb54c5a2d7","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"77323d52-e6ed-4934-b5a1-a49d96a27a7f"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Special limitation of transmission of personal data to a third country"}},"createdAt":"2025-05-27T06:17:23Z","entityUuid":"d0d255da-265f-4fd4-b015-d5bb54c5a2d7","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"911552d8-1aff-464b-b2b3-22405830b4ec"},{"content":{"annotations":[],"eventType":"AddChoiceEvent","label":""},"createdAt":"2025-05-27T06:17:24Z","entityUuid":"cdae5055-4084-4841-ace8-8dea90783b79","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"3d5770a3-9d65-4339-9320-0e2795199ae8"},{"content":{"annotations":{"changed":false},"eventType":"EditChoiceEvent","label":{"changed":true,"value":"Special limitation of personal data processing for some other purposes"}},"createdAt":"2025-05-27T06:17:25Z","entityUuid":"cdae5055-4084-4841-ace8-8dea90783b79","parentUuid":"c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","uuid":"4183bd65-31c4-4ed3-99d4-f003f53aef49"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2025-05-27T06:17:26Z","entityUuid":"2f385ee1-134a-42df-bbbb-684761cefc3e","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"4e287899-7c8c-4627-8e01-bacacb04b7fe"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Please describe any additional methods you use for full anonymisation"}},"createdAt":"2025-05-27T06:17:27Z","entityUuid":"2f385ee1-134a-42df-bbbb-684761cefc3e","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"b9847883-b74c-4ed9-b453-0432f8115555"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"If you use any technical and procedural safeguards beyond those listed above, please describe them here. **If you only use the safeguards mentioned previously, you can leave this field empty.**"},"title":{"changed":true,"value":"Please describe any additional safeguards"},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2025-05-27T06:17:28Z","entityUuid":"2f385ee1-134a-42df-bbbb-684761cefc3e","parentUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","uuid":"8961d81a-918a-4719-b780-93eb1c25b01a"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["c1cf3a5b-5920-4579-a04e-ecd2ea31ca6c","2f385ee1-134a-42df-bbbb-684761cefc3e","a89abfd3-ff27-4347-8e85-21653e4cd75e"]},"label":{"changed":false},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:17:29Z","entityUuid":"b309a0b6-0ff9-4a9d-a1d6-ee31502038e9","parentUuid":"2b842099-d4f6-4994-9a31-789d529ecf25","uuid":"6ac77c00-c566-45e5-bb86-a08e0c364e9c"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883"},"createdAt":"2025-05-27T06:17:30Z","entityUuid":"773fcf46-5db1-471a-bcf6-0799f7afc70b","parentUuid":"a4f43f8a-b2e3-450e-82e9-54499018c2df","uuid":"8755db6f-a9f2-407d-b5cb-85b90cc3ea7f"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please indicate whether the data collection involves elements—such as human subjects, sensitive information, or vulnerable populations—that require ethical approval under national law, institutional policies, or funder requirements. If so, describe the applicable review process and reference the relevant ethics committee or approval body.\n\nIf the answer is positive, you should have specified the relevant ethical review details under the \"Research Projects\" chapter (describing policies)."},"title":{"changed":false}},"createdAt":"2025-05-27T06:17:31Z","entityUuid":"773fcf46-5db1-471a-bcf6-0799f7afc70b","parentUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","uuid":"60317d4e-3bc2-443d-a0f7-b26a4937b2ab"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-05-27T06:17:32Z","entityUuid":"dedc1acc-2be5-4af1-9287-96c9c95f85d7","parentUuid":"5b1728ac-913e-434d-a2bc-741c2be8c883","uuid":"0afb5562-5618-41ba-b1d0-80661404ef22"},{"content":{"eventType":"DeleteQuestionEvent"},"createdAt":"2025-05-27T06:17:33Z","entityUuid":"f77e0d47-eff4-4991-80f4-40469ae6e741","parentUuid":"30769cc8-f18d-451d-90dd-a66db1001223","uuid":"8543a63b-1346-4db4-bc18-2678fdbd463e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Data provenance refers to documenting the **origin and history of the data** — including **how, when, by whom, and using what processes it was created or modified**. This helps ensure transparency, reproducibility, and data trustworthiness. This information is typically recorded using physical lab notebooks, electronic lab notebooks (ELNs), manual documentation such as README files or data journals, or through computational workflows that automatically capture the steps involved.\n\nProvenance information may include, for example:\n- Who collected the data and when\n- What instruments or methods were used\n- What cleaning, filtering, or processing steps were applied\n- How the data was merged or derived from other datasets\n- Version history of the dataset over time"},"title":{"changed":false}},"createdAt":"2025-05-27T06:17:34Z","entityUuid":"36b561b7-7864-4bc9-87cb-f1e06e7e26b7","parentUuid":"d079929c-4f64-4cb6-818b-39ccdefcbc07","uuid":"e7dc9cfb-e832-4598-955a-37633f01c57d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Please document each **distinct data organisation strategy** as a **separate entry**.\n\nFor each entry, begin by specifying whether the described organisation practices applies to **all datasets** or only to **specific datasets**. If it applies only to selected datasets, you will have the opportunity to identify exactly which datasets undertook this organisation strategy.\n\nIf your project(s) involves only **one data organisation strategy**, complete a **single entry** that thoroughly describes that strategy.\n\nPlease pay **close attention** to ensure that **all datasets** associated with your project are fully accounted for and appropriately linked to their respective organisation strategy. This is essential for maintaining transparency and completeness."},"title":{"changed":false}},"createdAt":"2025-05-27T06:17:35Z","entityUuid":"d6a2ece7-c068-48b4-bfaa-b032f432afd8","parentUuid":"30fda3ae-3b4d-486c-b626-fb585fa92571","uuid":"2f9aca57-37b9-4ccc-bf9c-4c08ffc54207"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will you be keeping clear relationships between the data in the file names?"}},"createdAt":"2025-05-27T06:17:36Z","entityUuid":"1f9d37c3-be62-4f4d-86c4-3d4e24944548","parentUuid":"ae45e778-5059-4beb-90ff-b6ebdc30cb7f","uuid":"18a26291-1b6e-4abe-b089-4976fd69a7c5"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Will all the metadata that are embedded in the file names also be available in the proper metadata?"}},"createdAt":"2025-05-27T06:17:37Z","entityUuid":"7d69adcf-1837-4b51-9eae-30c3c49f283e","parentUuid":"ae45e778-5059-4beb-90ff-b6ebdc30cb7f","uuid":"3d8a03a6-9cce-4f27-a272-ea54bd9b3d2b"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"No, different data (re)use restrictions are used for separate produced datasets"},"metricMeasures":{"changed":false}},"createdAt":"2025-05-27T06:17:38Z","entityUuid":"0837ed17-271f-44cd-80c4-b05bd534b59d","parentUuid":"5d9fa997-90a2-477d-b2ab-90a5e38c94ca","uuid":"1a22773a-f9c4-40b4-a9c2-cdf1f861a8c1"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"What is the background of the restrictions?"}},"createdAt":"2025-05-27T06:17:39Z","entityUuid":"52f9aea7-96d2-4e35-8630-1bef5e58c00a","parentUuid":"4ea71d27-ec3c-4018-ac99-7c308d0600e4","uuid":"7b6c67d8-d287-4795-aea2-078e6a059c0f"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Which outputs?"}},"createdAt":"2025-05-27T06:17:40Z","entityUuid":"613660d1-04de-46ae-85a3-4b0db1b704ee","parentUuid":"699f7c6c-0e61-4be7-bd48-bd0316c26897","uuid":"d31b127c-7253-44e1-aa76-a0373d648447"},{"content":{"eventType":"MoveQuestionEvent","targetUuid":"7f1733cb-5e4f-497f-bc9d-bb8eace51b62"},"createdAt":"2025-05-27T06:17:41Z","entityUuid":"11b1c277-fb57-4e52-8e3b-f22623551287","parentUuid":"209eb424-e4e3-46e0-b76c-e0c11dc62c58","uuid":"3fa8918f-92ed-468f-bb9a-9cb78a1286fc"}