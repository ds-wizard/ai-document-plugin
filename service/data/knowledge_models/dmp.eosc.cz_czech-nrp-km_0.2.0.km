anged":false},"text":{"changed":false},"title":{"changed":true,"value":"Contact person"}},"createdAt":"2025-04-09T13:07:03Z","entityUuid":"67656fcf-48db-4d7f-8a83-5874f058e5bf","parentUuid":"1f45710f-6481-4aa9-9c75-bd59ff70691b","uuid":"5c9cd7a5-b2ad-4cd1-b354-583fc9b01329"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"integrationUuid":{"changed":false},"questionType":"IntegrationQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"You will be presented with suggestions from [FAIRSharing](https://fairsharing.org/), but you also have the option to manually enter the name that is not listed there."},"title":{"changed":false},"variables":{"changed":false}},"createdAt":"2025-04-09T13:07:04Z","entityUuid":"ac3af60c-825a-40f2-a694-08e9335e4dc2","parentUuid":"491a6e28-b2ce-4257-8459-a316c864d86b","uuid":"5e56fd46-483b-4ac9-a0fa-b657e1804c2c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Estimated data volume in gigabytes"},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2025-04-09T13:07:05Z","entityUuid":"10e8fce3-1b05-402e-a8bc-77b64a7014d6","parentUuid":"50484834-cfc8-4b60-bdb8-18ff60f61acc","uuid":"037c88bf-a6de-419f-82f3-c4a161f3134f"}],"forkOfPackageId":"dmp.eosc.cz:czech-nrp-km:0.1.3","id":"dmp.eosc.cz:czech-nrp-km:0.1.4","kmId":"czech-nrp-km","license":"Apache-2.0","mergeCheckpointPackageId":"dmp.eosc.cz:czech-nrp-km:0.1.3","metamodelVersion":20,"name":"Czech National Repository Platform KM","nonEditable":false,"organizationId":"dmp.eosc.cz","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"dmp.eosc.cz:czech-nrp-km:0.1.3","readme":"# Czech National Repository Platform KM\n\n*DSW Knowledge Model tailored to needs and specifics of Czech National Repository Platform for Research Data*\n\n## Maintainers\n\nResponsible for the overall management and development of the knowledge model, ensuring its continuous improvement, and overseeing contributions to maintain its integrity and relevance.\n\n* **Jana Martínková** \n  * [jana.martinkova@cvut.cz](mailto:jana.martinkova@cvut.cz)\n  * ORCID: [0000-0001-8575-6533](https://orcid.org/0000-0001-8575-6533)\n  * *Czech Technical University in Prague*\n* **Kryštof Komanec** \n  * [krystof.komanec@fit.cvut.cz](mailto:krystof.komanec@fit.cvut.cz)\n  * ORCID: [0000-0003-3856-1682](https://orcid.org/0000-0003-3856-1682) \n  * *Czech Technical University in Prague*\n\n## Contributors\n\nContribute to the knowledge model by adding new information, refining existing content, or providing insights to improve its quality and applicability.\n\n* **Marek Suchánek**, ORCID: [0000-0001-7525-9218](https://orcid.org/0000-0001-7525-9218), *Czech Technical University in Prague*\n* **Georgia Koutentaki**, ORCID: [0000-0002-8099-9963](https://orcid.org/0000-0002-8099-9963), *Czech Technical University in Prague*\n* **Michal Růžička**, ORCID: [0000-0001-5547-8720](https://orcid.org/0000-0001-5547-8720), *Masaryk University*,  (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Barbora Loskotová**, *Tomas Bata University in Zlín*, (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Antonín Zita**, *Masaryk University*, (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Marika Hrubá**, *Masaryk University*, (as part of work on [FR CESNET 756/2024](https://www.muni.cz/en/research/projects/72488))\n* **Tereza Kolmačková**, *Library of the Czech Academy of Sciences*\n* **Jindřich Fejfar**, *Library of the Czech Academy of Sciences*\n* **Lucie Hošková**, ORCID: [0009-0001-9695-2342](https://orcid.org/0009-0001-9695-2342), *Charles University*\n* **Matěj Uchytil**, *Charles University*\n\n## Acknowledgements\n\n| ![](https://dmp.eosc.cz/static/eu-msmt.svg) | This work is supported by the project National Repository Platform for Research Data no. [CZ.02.01.01/00/23_014/0008787](https://www.eosc.cz/en/projects/national-repository-platform-for-research-data-os-i-nrp/national-repository-platform). |\n|-------------------------------------|---|\n\n## Changelog\n\n### 0.1.4\n\n*Released*: 2025-21-05\n\n* Refine the \"Producing Data\" chapter\n* Add phases to questions\n* General updates based on feedback from KA7 NRP project\n\n### 0.1.3\n\n*Released*: 2025-08-04\n\n* Integrate License Selector tool\n\n### 0.1.2\n\n*Released*: 2025-25-03\n\n* Refine the wording and order of the questions\n* Add a question for uploading the Data Sharing Agreement and Preservation Statement documents\n* Add URL question for measuring instrument, Data Sharing Agreement and Preservation Statement\n\n### 0.1.1\n\n*Released*: 2025-05-03\n\n* Add structure and preparation for License Selector\n* Add standard protocol and SW documentation\n* Add ORCID validation\n* Add \"Creator of DMP\" to roles\n* Improve integrations (link in response)\n\n### 0.1.0\n\n*Released*: 2025-08-01\n\n* Initial version for testing and further development","version":"0.1.4"},{"createdAt":"2025-07-24T09:10:38.125849Z","description":"DMP tailored to Czech National Repository Platform for Research Data ","events":[{"content":{"annotations":{"changed":true,"value":[{"key":"json.key","value":"projects"}]},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2025-05-27T05:59:45Z","entityUuid":"1cf77bb6-6d27-4228-9feb