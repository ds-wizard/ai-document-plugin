ions to the prohibition for processing of special categories of data (such as health and genetic data) under Art. 9 GDPR used? State cohort/dataset for each type of exemption."}},"createdAt":"2023-08-01T13:35:51Z","entityUuid":"caa6f175-2ac9-454b-9f56-14e272332a6f","parentUuid":"2c3dabdf-5182-4252-95d0-7f99d1054240","uuid":"c0c47224-4ad9-413d-b4c1-a62a9ad2aa5d"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2023-08-01T13:35:52Z","entityUuid":"fb49fdeb-3b11-49ba-a87c-0aa1ae278d46","parentUuid":"caa6f175-2ac9-454b-9f56-14e272332a6f","uuid":"1974acf4-9443-45ea-8394-54f43e8489d8"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Select exemption"}},"createdAt":"2023-08-01T13:35:53Z","entityUuid":"fb49fdeb-3b11-49ba-a87c-0aa1ae278d46","parentUuid":"caa6f175-2ac9-454b-9f56-14e272332a6f","uuid":"87386f1b-7456-4426-83e0-f35f2ffbacf1"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2023-08-01T13:35:54Z","entityUuid":"4f693fd6-c788-4d27-bc44-05f4ad66f295","parentUuid":"fb49fdeb-3b11-49ba-a87c-0aa1ae278d46","uuid":"55f3650c-8cc4-48dc-ba5e-4cbc97e5496f"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Scientific research"},"metricMeasures":{"changed":false}},"createdAt":"2023-08-01T13:35:55Z","entityUuid":"4f693fd6-c788-4d27-bc44-05f4ad66f295","parentUuid":"fb49fdeb-3b11-49ba-a87c-0aa1ae278d46","uuid":"12089b36-fdf4-4e9b-b8aa-7a3ba75d4977"},{"content":{"advice":null,"annotations":[],"eventTyp